<!-- 像素冰箱 - 主页 -->
<scroll-view scroll-y class="page-wrap">

  <!-- ===== 顶部 Header ===== -->
  <view class="page-header">
    <view class="header-left">
      <text class="header-greeting">Hi! 👋</text>
      <text class="header-title">我的冰箱</text>
    </view>
    <view class="header-icon-wrap">
      <text class="header-fridge-icon">🧊</text>
    </view>
  </view>

  <!-- ===== 像素艺术冰箱 ===== -->
  <view class="fridge-scene">

    <!-- 冰箱主体（可点击打开） -->
    <view class="fridge-body {{fridgeDoorOpening ? 'door-opening' : ''}}" bindtap="onFridgeTap">

      <!-- 品牌顶栏 -->
      <view class="fridge-top-bar">
        <view class="vent-group">
          <view class="vent-line"></view>
          <view class="vent-line"></view>
          <view class="vent-line"></view>
        </view>
        <view class="brand-center">
          <text class="fridge-brand">✦ PIXEL-COOL ✦</text>
        </view>
        <view class="vent-group">
          <view class="vent-line"></view>
          <view class="vent-line"></view>
          <view class="vent-line"></view>
        </view>
      </view>

      <!-- 冷冻层 -->
      <view class="fridge-door freezer-door">
        <view class="door-inner freezer-inner">
          <view class="door-label">
            <view class="door-label-tag freezer-tag">
              <text class="tag-icon">❄</text>
              <text class="tag-text">冷冻层</text>
            </view>
          </view>
          <view class="freezer-grid">
            <view wx:for="{{frozenItems}}" wx:key="id" class="freezer-item">
              <text class="freeze-emoji">{{item.icon}}</text>
            </view>
            <view wx:if="{{frozenItems.length === 0}}" class="zone-empty">
              <text class="zone-empty-text">暂无冷冻食材</text>
            </view>
          </view>
        </view>
        <view class="door-handle-col">
          <view class="door-handle-bar"></view>
        </view>
      </view>

      <!-- 隔条 -->
      <view class="shelf-divider">
        <view class="shelf-screw"></view>
        <view class="shelf-line"></view>
        <view class="shelf-screw"></view>
      </view>

      <!-- 冷藏层 -->
      <view class="fridge-door main-door">
        <view class="door-inner main-inner">
          <view class="door-label">
            <view class="door-label-tag main-tag">
              <text class="tag-icon">🌿</text>
              <text class="tag-text">冷藏层</text>
            </view>
            <text class="door-count-pill">{{previewItems.length}}{{remainingCount > 0 ? '+' + remainingCount : ''}} 件</text>
          </view>
          <!-- 食材预览格 -->
          <view class="main-preview-grid">
            <view wx:for="{{previewItems}}" wx:key="id" class="preview-cell">
              <text class="preview-emoji">{{item.icon}}</text>
              <view class="freshness-dot dot-{{item.status}}"></view>
            </view>
            <view wx:if="{{remainingCount > 0}}" class="preview-more-cell">
              <text class="more-num">+{{remainingCount}}</text>
            </view>
            <view wx:if="{{previewItems.length === 0}}" class="main-zone-empty">
              <text class="zone-empty-emoji">🍽</text>
              <text class="zone-empty-text">空空如也</text>
            </view>
          </view>
        </view>
        <view class="door-handle-col">
          <view class="door-handle-bar"></view>
        </view>
      </view>

      <!-- 底部脚垫 -->
      <view class="fridge-base">
        <view class="fridge-foot"></view>
        <view class="fridge-foot"></view>
      </view>

      <!-- 点击提示 -->
      <view class="fridge-tap-hint">
        <text class="tap-hint-text">点击打开冰箱 →</text>
      </view>
    </view>

    <!-- 冰箱旁装饰 -->
    <view class="fridge-deco">
      <text class="deco-sticker">⭐</text>
      <text class="deco-sticker">🌸</text>
      <text class="deco-sticker">✨</text>
    </view>
  </view>

  <!-- ===== 统计卡片 ===== -->
  <view class="stats-row">
    <view class="stat-card stat-total">
      <text class="stat-emoji">🧺</text>
      <text class="stat-num">{{totalCount}}</text>
      <text class="stat-lbl">总食材</text>
    </view>
    <view class="stat-card stat-soon">
      <text class="stat-emoji">⏰</text>
      <text class="stat-num soon-num">{{expiringCount}}</text>
      <text class="stat-lbl">快过期</text>
    </view>
    <view class="stat-card stat-expired">
      <text class="stat-emoji">🗑</text>
      <text class="stat-num expired-num">{{expiredCount}}</text>
      <text class="stat-lbl">已过期</text>
    </view>
  </view>

  <!-- ===== 分类标签 ===== -->
  <scroll-view scroll-x class="category-scroll">
    <view class="category-list">
      <view
        wx:for="{{categories}}"
        wx:key="id"
        class="cat-chip {{activeCategory === item.id ? 'cat-chip-active' : ''}}"
        data-id="{{item.id}}"
        bindtap="onCategoryTap"
      >
        <text class="cat-chip-icon">{{item.icon}}</text>
        <text class="cat-chip-name">{{item.name}}</text>
      </view>
    </view>
  </scroll-view>

  <!-- ===== 食材列表 ===== -->
  <view class="items-section">

    <!-- 空状态 -->
    <view wx:if="{{filteredItems.length === 0}}" class="empty-state">
      <text class="empty-illus">🫙</text>
      <text class="empty-msg">这里还没有食材哦</text>
      <text class="empty-hint">去添加你的第一个食材吧！</text>
      <view class="add-first-btn" bindtap="onAddTap">
        <text class="add-first-text">＋ 去添加</text>
      </view>
    </view>

    <!-- 食材卡片 -->
    <view class="items-grid">
      <view
        wx:for="{{filteredItems}}"
        wx:key="id"
        class="item-card"
        data-id="{{item.id}}"
        bindtap="onItemTap"
      >
        <!-- 顶色条 -->
        <view class="card-top-stripe stripe-{{item.status}}">
          <view class="card-status-dot dot-{{item.status}}"></view>
          <text wx:if="{{item.frozen}}" class="card-freeze-badge">❄</text>
        </view>

        <!-- 图标 -->
        <text class="card-icon">{{item.icon}}</text>

        <!-- 信息 -->
        <text class="card-name">{{item.name}}</text>
        <text class="card-qty">{{item.quantity}} {{item.unit}}</text>

        <!-- 过期信息 -->
        <view class="card-expiry-row">
          <text class="card-expiry expiry-{{item.status}}">{{item.expiryText}}</text>
        </view>

        <!-- 删除键 -->
        <view
          class="card-del-btn"
          data-id="{{item.id}}"
          data-name="{{item.name}}"
          data-icon="{{item.icon}}"
          catchtap="onDeleteItem"
        >✕</view>
      </view>
    </view>
  </view>

  <view style="height: 50rpx;"></view>
</scroll-view>

<!-- ===== 大冰箱内部模态框 ===== -->
<view class="fridge-modal {{fridgeModalOpen ? 'fridge-modal-open' : ''}}" bindtap="onCloseFridgeModal">
  <view class="fridge-interior" catchtap="noop">

    <!-- 顶部把手区 -->
    <view class="fridge-int-header">
      <view class="fridge-int-light">
        <view class="bulb-glow"></view>
        <text class="bulb-label">💡</text>
      </view>
      <view class="fridge-int-title-wrap">
        <text class="fridge-int-brand">✦ PIXEL-COOL ✦</text>
        <text class="fridge-int-temp">冷藏 4°C</text>
      </view>
      <view class="fridge-int-close" bindtap="onCloseFridgeModal">
        <text class="close-icon">✕</text>
      </view>
    </view>

    <!-- 温度条装饰 -->
    <view class="temp-bar">
      <view class="temp-indicator"></view>
    </view>

    <!-- ===== 冷冻层 ===== -->
    <view class="fridge-int-zone freezer-zone">
      <view class="zone-label-row">
        <text class="zone-label-icon">❄</text>
        <text class="zone-label-text">冷冻层  −18°C</text>
        <text class="zone-item-count">{{frozenItems.length}} 件</text>
      </view>
      <view class="fridge-int-grid">
        <view
          wx:for="{{frozenItems}}"
          wx:key="id"
          class="int-item-cell int-item-frozen"
          data-id="{{item.id}}"
          bindtap="onFridgeItemTap"
        >
          <text class="int-item-emoji">{{item.icon}}</text>
          <text class="int-item-name">{{item.name}}</text>
          <view class="int-item-dot dot-{{item.status}}"></view>
        </view>
        <view wx:if="{{frozenItems.length === 0}}" class="int-empty">
          <text>❄ 冷冻层是空的</text>
        </view>
      </view>
    </view>

    <!-- 冰箱隔板 -->
    <view class="fridge-shelf-bar">
      <view class="shelf-support"></view>
      <view class="shelf-support"></view>
      <view class="shelf-support"></view>
    </view>

    <!-- ===== 冷藏层 ===== -->
    <view class="fridge-int-zone main-zone">
      <view class="zone-label-row">
        <text class="zone-label-icon">🌿</text>
        <text class="zone-label-text">冷藏层  4°C</text>
        <text class="zone-item-count">{{mainFridgeItems.length}} 件</text>
      </view>
      <view class="fridge-int-grid">
        <view
          wx:for="{{mainFridgeItems}}"
          wx:key="id"
          class="int-item-cell int-item-fresh"
          data-id="{{item.id}}"
          bindtap="onFridgeItemTap"
        >
          <text class="int-item-emoji">{{item.icon}}</text>
          <text class="int-item-name">{{item.name}}</text>
          <view class="int-item-dot dot-{{item.status}}"></view>
        </view>
        <view wx:if="{{mainFridgeItems.length === 0}}" class="int-empty">
          <text>🍽 冷藏层是空的</text>
        </view>
      </view>
    </view>

    <!-- 底部加号按钮 -->
    <view class="fridge-int-footer">
      <view class="int-add-btn" bindtap="onAddFromModal">
        <text class="int-add-icon">＋</text>
        <text class="int-add-text">添加食材</text>
      </view>
      <view class="fridge-int-drain">
        <view class="drain-hole"></view>
        <view class="drain-hole"></view>
        <view class="drain-hole"></view>
      </view>
    </view>

  </view>
</view>

<!-- ===== 蜘蛛吃食物动画 ===== -->
<view class="spider-overlay {{spiderActive ? 'spider-overlay-show' : ''}}">
  <view class="spider-stage">
    <!-- 背景网 -->
    <view class="web-line web-line-1"></view>
    <view class="web-line web-line-2"></view>
    <view class="web-line web-line-3"></view>

    <!-- 食物（中间） -->
    <view wx:if="{{spiderItem}}" class="spider-food-wrap {{spiderState === 'eat' || spiderState === 'done' ? 'food-eating' : ''}}">
      <text class="spider-food-emoji">{{spiderItem.icon}}</text>
      <text class="spider-food-label">{{spiderItem.name}}</text>
    </view>

    <!-- 蜘蛛 -->
    <view wx:if="{{spiderItem}}" class="spider-creature spider-state-{{spiderState}}">
      <text class="spider-emoji">🕷</text>
      <!-- 蜘蛛丝 -->
      <view wx:if="{{spiderState === 'crawl'}}" class="spider-thread"></view>
    </view>

    <!-- 提示文字 -->
    <text class="spider-msg">
      {{spiderState === 'crawl' ? '😱  蜘蛛来了...' : spiderState === 'eat' ? '😋  大快朵颐！' : '✓  已被消灭'}}
    </text>
  </view>
</view>
