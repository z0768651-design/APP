<!-- 像素冰箱 - 主页 -->
<scroll-view scroll-y class="page-wrap">

  <!-- ===== 顶部 Header ===== -->
  <view class="page-header">
    <view class="header-left">
      <text class="header-greeting">Hi! 👋</text>
      <text class="header-title">我的冰箱</text>
    </view>
    <view class="header-icon-wrap">
      <text class="header-fridge-icon">🧊</text>
    </view>
  </view>

  <!-- ===== 像素艺术冰箱 ===== -->
  <view class="fridge-scene">

    <!-- 冰箱主体 -->
    <view class="fridge-body" bindtap="toggleFridge">

      <!-- 品牌顶栏 -->
      <view class="fridge-top-bar">
        <view class="vent-group">
          <view class="vent-line"></view>
          <view class="vent-line"></view>
          <view class="vent-line"></view>
        </view>
        <view class="brand-center">
          <text class="fridge-brand">✦ PIXEL-COOL ✦</text>
        </view>
        <view class="vent-group">
          <view class="vent-line"></view>
          <view class="vent-line"></view>
          <view class="vent-line"></view>
        </view>
      </view>

      <!-- 冷冻层 -->
      <view class="fridge-door freezer-door">
        <view class="door-inner freezer-inner">
          <view class="door-label">
            <view class="door-label-tag freezer-tag">
              <text class="tag-icon">❄</text>
              <text class="tag-text">冷冻层</text>
            </view>
          </view>
          <view class="freezer-grid">
            <view wx:for="{{frozenItems}}" wx:key="id" class="freezer-item">
              <text class="freeze-emoji">{{item.icon}}</text>
            </view>
            <view wx:if="{{frozenItems.length === 0}}" class="zone-empty">
              <text class="zone-empty-text">暂无冷冻食材</text>
            </view>
          </view>
        </view>
        <view class="door-handle-col">
          <view class="door-handle-bar"></view>
        </view>
      </view>

      <!-- 隔条 -->
      <view class="shelf-divider">
        <view class="shelf-screw"></view>
        <view class="shelf-line"></view>
        <view class="shelf-screw"></view>
      </view>

      <!-- 冷藏层 -->
      <view class="fridge-door main-door">
        <view class="door-inner main-inner">
          <view class="door-label">
            <view class="door-label-tag main-tag">
              <text class="tag-icon">🌿</text>
              <text class="tag-text">冷藏层</text>
            </view>
            <text class="door-count-pill">{{previewItems.length}}{{remainingCount > 0 ? '+' + remainingCount : ''}} 件</text>
          </view>
          <!-- 食材预览格 -->
          <view class="main-preview-grid">
            <view wx:for="{{previewItems}}" wx:key="id" class="preview-cell">
              <text class="preview-emoji">{{item.icon}}</text>
              <view class="freshness-dot dot-{{item.status}}"></view>
            </view>
            <view wx:if="{{remainingCount > 0}}" class="preview-more-cell">
              <text class="more-num">+{{remainingCount}}</text>
            </view>
            <view wx:if="{{previewItems.length === 0}}" class="main-zone-empty">
              <text class="zone-empty-emoji">🍽</text>
              <text class="zone-empty-text">空空如也</text>
            </view>
          </view>
        </view>
        <view class="door-handle-col">
          <view class="door-handle-bar"></view>
        </view>
      </view>

      <!-- 底部脚垫 -->
      <view class="fridge-base">
        <view class="fridge-foot"></view>
        <view class="fridge-foot"></view>
      </view>
    </view>

    <!-- 冰箱旁装饰 -->
    <view class="fridge-deco">
      <text class="deco-sticker">⭐</text>
      <text class="deco-sticker">🌸</text>
      <text class="deco-sticker">✨</text>
    </view>
  </view>

  <!-- ===== 统计卡片 ===== -->
  <view class="stats-row">
    <view class="stat-card stat-total">
      <text class="stat-emoji">🧺</text>
      <text class="stat-num">{{totalCount}}</text>
      <text class="stat-lbl">总食材</text>
    </view>
    <view class="stat-card stat-soon">
      <text class="stat-emoji">⏰</text>
      <text class="stat-num soon-num">{{expiringCount}}</text>
      <text class="stat-lbl">快过期</text>
    </view>
    <view class="stat-card stat-expired">
      <text class="stat-emoji">🗑</text>
      <text class="stat-num expired-num">{{expiredCount}}</text>
      <text class="stat-lbl">已过期</text>
    </view>
  </view>

  <!-- ===== 分类标签 ===== -->
  <scroll-view scroll-x class="category-scroll">
    <view class="category-list">
      <view
        wx:for="{{categories}}"
        wx:key="id"
        class="cat-chip {{activeCategory === item.id ? 'cat-chip-active' : ''}}"
        data-id="{{item.id}}"
        bindtap="onCategoryTap"
      >
        <text class="cat-chip-icon">{{item.icon}}</text>
        <text class="cat-chip-name">{{item.name}}</text>
      </view>
    </view>
  </scroll-view>

  <!-- ===== 食材列表 ===== -->
  <view class="items-section">

    <!-- 空状态 -->
    <view wx:if="{{filteredItems.length === 0}}" class="empty-state">
      <text class="empty-illus">🫙</text>
      <text class="empty-msg">这里还没有食材哦</text>
      <text class="empty-hint">去添加你的第一个食材吧！</text>
      <view class="add-first-btn" bindtap="onAddTap">
        <text class="add-first-text">＋ 去添加</text>
      </view>
    </view>

    <!-- 食材卡片 -->
    <view class="items-grid">
      <view
        wx:for="{{filteredItems}}"
        wx:key="id"
        class="item-card"
        data-id="{{item.id}}"
        bindtap="onItemTap"
      >
        <!-- 顶色条 -->
        <view class="card-top-stripe stripe-{{item.status}}">
          <view class="card-status-dot dot-{{item.status}}"></view>
          <text wx:if="{{item.frozen}}" class="card-freeze-badge">❄</text>
        </view>

        <!-- 图标 -->
        <text class="card-icon">{{item.icon}}</text>

        <!-- 信息 -->
        <text class="card-name">{{item.name}}</text>
        <text class="card-qty">{{item.quantity}} {{item.unit}}</text>

        <!-- 过期信息 -->
        <view class="card-expiry-row">
          <text class="card-expiry expiry-{{item.status}}">{{item.expiryText}}</text>
        </view>

        <!-- 删除键 -->
        <view
          class="card-del-btn"
          data-id="{{item.id}}"
          data-name="{{item.name}}"
          catchtap="onDeleteItem"
        >✕</view>
      </view>
    </view>
  </view>

  <view style="height: 50rpx;"></view>
</scroll-view>
