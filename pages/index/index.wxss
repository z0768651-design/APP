/* ===== 主页 - 清爽像素风 ===== */
.page-wrap {
  min-height: 100vh;
  background: #f0fdf8;
}

/* ===== Header ===== */
.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 36rpx 32rpx 20rpx;
}
.header-left { display: flex; flex-direction: column; gap: 4rpx; }
.header-greeting {
  font-size: 24rpx;
  color: #94a3b8;
  font-family: 'Courier New', monospace;
}
.header-title {
  font-size: 44rpx;
  color: #1e293b;
  font-family: 'Courier New', monospace;
  font-weight: bold;
  letter-spacing: 2rpx;
}
.header-icon-wrap {
  width: 90rpx;
  height: 90rpx;
  background: #ffffff;
  border: 3px solid #1e293b;
  box-shadow: 4px 4px 0 #14b8a6;
  display: flex;
  align-items: center;
  justify-content: center;
}
.header-fridge-icon { font-size: 50rpx; }

/* ===== 冰箱场景 ===== */
.fridge-scene {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: center;
  padding: 0 24rpx 16rpx;
  gap: 12rpx;
}

/* 冰箱主体 */
.fridge-body {
  width: 520rpx;
  background: #ffffff;
  border: 4px solid #1e293b;
  box-shadow: 6px 6px 0 #1e293b;
  position: relative;
  flex-shrink: 0;
}

/* 顶部品牌栏 */
.fridge-top-bar {
  background: #f1f5f9;
  border-bottom: 3px solid #1e293b;
  padding: 14rpx 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.vent-group { display: flex; flex-direction: column; gap: 5rpx; }
.vent-line {
  width: 36rpx;
  height: 5rpx;
  background: #cbd5e1;
  border-radius: 0;
}
.brand-center { flex: 1; text-align: center; }
.fridge-brand {
  font-size: 18rpx;
  color: #64748b;
  font-family: 'Courier New', monospace;
  font-weight: bold;
  letter-spacing: 2rpx;
}

/* 门体通用 */
.fridge-door {
  display: flex;
  align-items: stretch;
  position: relative;
}
.door-inner {
  flex: 1;
  padding: 16rpx 16rpx 20rpx;
}

/* 标签 */
.door-label {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}
.door-label-tag {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 5rpx 12rpx;
  border: 2px solid #1e293b;
}
.freezer-tag { background: #dbeafe; }
.main-tag    { background: #d1fae5; }
.tag-icon  { font-size: 20rpx; }
.tag-text  { font-size: 18rpx; color: #1e293b; font-family: 'Courier New', monospace; font-weight: bold; }
.door-count-pill {
  background: #14b8a6;
  color: #ffffff;
  font-size: 18rpx;
  font-family: 'Courier New', monospace;
  font-weight: bold;
  padding: 4rpx 14rpx;
  border: 2px solid #1e293b;
  box-shadow: 2px 2px 0 #1e293b;
}

/* 把手 */
.door-handle-col {
  width: 22rpx;
  background: #f8fafc;
  border-left: 2px solid #e2e8f0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.door-handle-bar {
  width: 8rpx;
  height: 56rpx;
  background: #1e293b;
  border-radius: 0;
  box-shadow: 1px 0 0 #475569;
}

/* 冷冻层 */
.freezer-door { min-height: 110rpx; }
.freezer-inner { background: #eff6ff; }
.freezer-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 8rpx;
}
.freezer-item {
  width: 58rpx;
  height: 58rpx;
  background: #dbeafe;
  border: 2px solid #93c5fd;
  box-shadow: 2px 2px 0 #1e293b;
  display: flex;
  align-items: center;
  justify-content: center;
}
.freeze-emoji { font-size: 32rpx; }

/* 空状态 */
.zone-empty {
  padding: 10rpx 0;
}
.zone-empty-text {
  font-size: 20rpx;
  color: #94a3b8;
  font-family: 'Courier New', monospace;
}

/* 隔板 */
.shelf-divider {
  height: 14rpx;
  background: #e2e8f0;
  border-top: 2px solid #1e293b;
  border-bottom: 2px solid #1e293b;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 12rpx;
}
.shelf-screw {
  width: 12rpx;
  height: 12rpx;
  background: #94a3b8;
  border: 1px solid #64748b;
  border-radius: 50%;
}
.shelf-line {
  flex: 1;
  height: 2px;
  background: repeating-linear-gradient(90deg, #cbd5e1 0, #cbd5e1 6px, transparent 6px, transparent 12px);
  margin: 0 8rpx;
}

/* 冷藏层 */
.main-door { min-height: 220rpx; border-top: none; }
.main-inner { background: #f0fdf4; }
.main-preview-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}
.preview-cell {
  width: 72rpx;
  height: 72rpx;
  background: #ffffff;
  border: 2px solid #bbf7d0;
  box-shadow: 2px 2px 0 #1e293b;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
}
.preview-emoji { font-size: 40rpx; }
.freshness-dot {
  position: absolute;
  bottom: 4rpx;
  right: 4rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 0;
}
.preview-more-cell {
  width: 72rpx;
  height: 72rpx;
  background: #f1f5f9;
  border: 2px solid #cbd5e1;
  box-shadow: 2px 2px 0 #1e293b;
  display: flex;
  align-items: center;
  justify-content: center;
}
.more-num {
  font-size: 22rpx;
  color: #14b8a6;
  font-family: 'Courier New', monospace;
  font-weight: bold;
}
.main-zone-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx;
  gap: 8rpx;
}
.zone-empty-emoji { font-size: 44rpx; }

/* 冰箱底座 */
.fridge-base {
  background: #f1f5f9;
  border-top: 3px solid #1e293b;
  display: flex;
  justify-content: space-around;
  padding: 8rpx 40rpx;
}
.fridge-foot {
  width: 56rpx;
  height: 16rpx;
  background: #94a3b8;
  border: 2px solid #1e293b;
  box-shadow: 2px 2px 0 #1e293b;
}

/* 冰箱旁装饰 */
.fridge-deco {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding-top: 30rpx;
}
.deco-sticker { font-size: 30rpx; opacity: 0.7; }

/* 保鲜点颜色 */
.dot-fresh   { background: #10b981; border: 2px solid #065f46; }
.dot-soon    { background: #f59e0b; border: 2px solid #92400e; }
.dot-expired { background: #fb7185; border: 2px solid #9f1239; }
.dot-unknown { background: #cbd5e1; border: 2px solid #64748b; }

/* ===== 统计行 ===== */
.stats-row {
  display: flex;
  gap: 16rpx;
  padding: 0 24rpx 24rpx;
}
.stat-card {
  flex: 1;
  background: #ffffff;
  border: 3px solid #1e293b;
  box-shadow: 4px 4px 0 #1e293b;
  padding: 20rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}
.stat-total { box-shadow: 4px 4px 0 #14b8a6; }
.stat-soon  { box-shadow: 4px 4px 0 #f59e0b; }
.stat-expired { box-shadow: 4px 4px 0 #fb7185; }
.stat-emoji { font-size: 30rpx; }
.stat-num {
  font-size: 44rpx;
  color: #1e293b;
  font-family: 'Courier New', monospace;
  font-weight: bold;
  line-height: 1.1;
}
.soon-num    { color: #f59e0b; }
.expired-num { color: #fb7185; }
.stat-lbl {
  font-size: 18rpx;
  color: #94a3b8;
  font-family: 'Courier New', monospace;
}

/* ===== 分类标签 ===== */
.category-scroll {
  width: 100%;
  margin-bottom: 20rpx;
}
.category-list {
  display: flex;
  flex-direction: row;
  padding: 0 24rpx;
  gap: 12rpx;
  white-space: nowrap;
}
.cat-chip {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 16rpx;
  background: #ffffff;
  border: 2px solid #e2e8f0;
  box-shadow: 3px 3px 0 #e2e8f0;
  white-space: nowrap;
  min-width: 78rpx;
}
.cat-chip.cat-chip-active {
  background: #14b8a6;
  border-color: #1e293b;
  box-shadow: 3px 3px 0 #1e293b;
}
.cat-chip-icon { font-size: 28rpx; }
.cat-chip-name {
  font-size: 18rpx;
  color: #64748b;
  font-family: 'Courier New', monospace;
  margin-top: 4rpx;
}
.cat-chip.cat-chip-active .cat-chip-name { color: #ffffff; font-weight: bold; }

/* ===== 食材列表 ===== */
.items-section { padding: 0 24rpx; }

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
  gap: 12rpx;
}
.empty-illus { font-size: 80rpx; }
.empty-msg {
  font-size: 28rpx;
  color: #475569;
  font-family: 'Courier New', monospace;
  font-weight: bold;
}
.empty-hint {
  font-size: 22rpx;
  color: #94a3b8;
  font-family: 'Courier New', monospace;
}
.add-first-btn {
  margin-top: 12rpx;
  background: #14b8a6;
  border: 3px solid #1e293b;
  box-shadow: 4px 4px 0 #1e293b;
  padding: 18rpx 48rpx;
}
.add-first-btn:active {
  box-shadow: 1px 1px 0 #1e293b;
  transform: translate(3px, 3px);
}
.add-first-text {
  font-size: 28rpx;
  color: #ffffff;
  font-family: 'Courier New', monospace;
  font-weight: bold;
}

/* 食材卡片网格 */
.items-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}
.item-card {
  background: #ffffff;
  border: 3px solid #1e293b;
  box-shadow: 4px 4px 0 #1e293b;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  overflow: hidden;
  padding-bottom: 20rpx;
}
.item-card:active {
  box-shadow: 2px 2px 0 #1e293b;
  transform: translate(2px, 2px);
}

/* 顶色条 */
.card-top-stripe {
  width: 100%;
  height: 18rpx;
  display: flex;
  align-items: center;
  padding: 0 10rpx;
  gap: 6rpx;
  margin-bottom: 14rpx;
}
.stripe-fresh   { background: #d1fae5; }
.stripe-soon    { background: #fef3c7; }
.stripe-expired { background: #ffe4e6; }
.stripe-unknown { background: #f1f5f9; }
.card-status-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 0;
}
.card-freeze-badge {
  font-size: 18rpx;
  color: #60a5fa;
  margin-left: auto;
}

.card-icon {
  font-size: 76rpx;
  margin-bottom: 10rpx;
}
.card-name {
  font-size: 26rpx;
  color: #1e293b;
  font-family: 'Courier New', monospace;
  font-weight: bold;
  text-align: center;
  padding: 0 10rpx;
}
.card-qty {
  font-size: 20rpx;
  color: #94a3b8;
  font-family: 'Courier New', monospace;
  margin-top: 4rpx;
}
.card-expiry-row {
  margin-top: 8rpx;
  padding: 0 12rpx;
  width: 100%;
  box-sizing: border-box;
  display: flex;
  justify-content: center;
}
.card-expiry {
  font-size: 18rpx;
  font-family: 'Courier New', monospace;
  text-align: center;
}
.expiry-fresh   { color: #10b981; }
.expiry-soon    { color: #f59e0b; }
.expiry-expired { color: #fb7185; }
.expiry-unknown { color: #94a3b8; }

.card-del-btn {
  position: absolute;
  top: 24rpx;
  right: 10rpx;
  width: 36rpx;
  height: 36rpx;
  background: #fff1f2;
  border: 2px solid #fecdd3;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
  color: #fb7185;
  font-family: 'Courier New', monospace;
  font-weight: bold;
}
.card-del-btn:active { background: #ffe4e6; }
