.container {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
}

.card {
  width: 100%;
  background: linear-gradient(135deg, #16213e, #0f3460);
  border-radius: 32rpx;
  padding: 80rpx 60rpx;
  box-shadow: 0 20rpx 80rpx rgba(0, 0, 0, 0.5);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.date-section {
  text-align: center;
  margin-bottom: 60rpx;
}

.date {
  display: block;
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.7);
  letter-spacing: 2rpx;
  margin-bottom: 8rpx;
}

.weekday {
  display: block;
  font-size: 28rpx;
  color: #e94560;
  font-weight: 600;
  letter-spacing: 4rpx;
}

.clock-section {
  text-align: center;
}

.period {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.5);
  letter-spacing: 6rpx;
  margin-bottom: 20rpx;
  text-transform: uppercase;
}

.time-display {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0;
}

.time-unit {
  font-size: 140rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: -4rpx;
  line-height: 1;
  text-shadow: 0 0 40rpx rgba(233, 69, 96, 0.6);
  font-variant-numeric: tabular-nums;
  min-width: 190rpx;
  text-align: center;
}

.colon {
  font-size: 120rpx;
  font-weight: 300;
  color: #e94560;
  line-height: 1;
  padding: 0 4rpx;
  animation: blink 1s step-end infinite;
}

.seconds-unit {
  font-size: 80rpx;
  font-weight: 400;
  color: rgba(255, 255, 255, 0.6);
  line-height: 1;
  padding-top: 50rpx;
  min-width: 110rpx;
  text-align: center;
  font-variant-numeric: tabular-nums;
}

@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.2; }
}
