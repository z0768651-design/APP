/* ===== 设置页 - 清爽可爱 ===== */
.settings-page {
  min-height: 100vh;
  background: #f0fdf8;
  padding: 24rpx;
  box-sizing: border-box;
}

/* 顶部 Header */
.settings-header {
  text-align: center;
  padding: 24rpx 0 36rpx;
}
.settings-title {
  display: block;
  font-size: 42rpx;
  color: #1e293b;
  font-family: 'Courier New', monospace;
  font-weight: bold;
  letter-spacing: 2rpx;
}
.settings-subtitle {
  display: block;
  font-size: 20rpx;
  color: #94a3b8;
  font-family: 'Courier New', monospace;
  margin-top: 8rpx;
  letter-spacing: 3rpx;
}

/* 分节卡片 */
.settings-section {
  background: #ffffff;
  border: 3px solid #e2e8f0;
  box-shadow: 4px 4px 0 #e2e8f0;
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.settings-section:first-of-type { box-shadow: 4px 4px 0 #14b8a6; }
.section-label {
  display: block;
  font-size: 26rpx;
  color: #1e293b;
  font-family: 'Courier New', monospace;
  font-weight: bold;
  margin-bottom: 8rpx;
}
.section-desc {
  display: block;
  font-size: 20rpx;
  color: #94a3b8;
  font-family: 'Courier New', monospace;
  margin-bottom: 20rpx;
}

/* 城市输入框 */
.city-input {
  width: 100%;
  padding: 12rpx 16rpx;
  background: #f8fafc;
  border: 2px solid #e2e8f0;
  border-radius: 6rpx;
  font-size: 18rpx;
  color: #1e293b;
  margin-bottom: 10rpx;
  box-sizing: border-box;
  font-family: 'Courier New', monospace;
}
.city-input:focus {
  border-color: #14b8a6;
  background: #f0fdfa;
}
.input-hint {
  display: block;
  font-size: 14rpx;
  color: #94a3b8;
  margin-top: 8rpx;
}

/* 语言选项网格 */
.lang-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}
.lang-option {
  background: #f8fafc;
  border: 2px solid #e2e8f0;
  box-shadow: 3px 3px 0 #e2e8f0;
  padding: 20rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  position: relative;
}
.lang-option.lang-selected {
  background: #f0fdfa;
  border-color: #14b8a6;
  box-shadow: 3px 3px 0 #14b8a6;
}
.lang-option:active {
  box-shadow: 1px 1px 0 #1e293b;
  transform: translate(2px, 2px);
}
.lang-flag { font-size: 40rpx; }
.lang-name {
  font-size: 22rpx;
  color: #475569;
  font-family: 'Courier New', monospace;
}
.lang-option.lang-selected .lang-name { color: #14b8a6; font-weight: bold; }
.lang-check {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  background: #14b8a6;
  color: #ffffff;
  font-size: 16rpx;
  font-family: 'Courier New', monospace;
  font-weight: bold;
  width: 28rpx;
  height: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2px solid #1e293b;
}

/* 状态统计 */
.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 16rpx;
}
.stat-box {
  background: #f8fafc;
  border: 2px solid #e2e8f0;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}
.stat-box-danger { background: #fff1f2; border-color: #fecdd3; }
.stat-big {
  font-size: 60rpx;
  color: #14b8a6;
  font-family: 'Courier New', monospace;
  font-weight: bold;
  line-height: 1;
}
.expired-num { color: #fb7185; }
.stat-desc {
  font-size: 20rpx;
  color: #94a3b8;
  font-family: 'Courier New', monospace;
}

/* 操作列表 */
.action-list { display: flex; flex-direction: column; gap: 12rpx; margin-top: 16rpx; }
.action-item {
  background: #f8fafc;
  border: 2px solid #e2e8f0;
  box-shadow: 3px 3px 0 #e2e8f0;
  padding: 20rpx 16rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.action-item:active {
  box-shadow: 1px 1px 0 #e2e8f0;
  transform: translate(2px, 2px);
}
.action-item-danger { background: #fff1f2; border-color: #fecdd3; box-shadow: 3px 3px 0 #fecdd3; }
.action-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2px solid #1e293b;
  font-size: 28rpx;
}
.action-blue   { background: #dbeafe; }
.action-yellow { background: #fef3c7; }
.action-red    { background: #ffe4e6; }
.action-info { flex: 1; }
.action-title {
  display: block;
  font-size: 26rpx;
  color: #1e293b;
  font-family: 'Courier New', monospace;
  font-weight: bold;
}
.action-title-danger { color: #fb7185; }
.action-desc {
  display: block;
  font-size: 20rpx;
  color: #94a3b8;
  font-family: 'Courier New', monospace;
  margin-top: 4rpx;
}
.action-arrow { font-size: 20rpx; color: #cbd5e1; font-family: 'Courier New', monospace; }

/* 颜色图例 */
.legend-list { display: flex; flex-direction: column; gap: 16rpx; margin-top: 16rpx; }
.legend-item { display: flex; align-items: center; gap: 16rpx; }
.legend-dot {
  width: 24rpx;
  height: 24rpx;
  border: 2px solid #1e293b;
  flex-shrink: 0;
}
.dot-fresh   { background: #10b981; }
.dot-soon    { background: #f59e0b; }
.dot-expired { background: #fb7185; }
.dot-unknown { background: #cbd5e1; }
.legend-text {
  font-size: 24rpx;
  color: #475569;
  font-family: 'Courier New', monospace;
}

/* 底部装饰 */
.footer {
  text-align: center;
  padding: 40rpx 0 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}
.footer-pixel {
  display: block;
  font-size: 20rpx;
  color: #e2e8f0;
  font-family: 'Courier New', monospace;
  letter-spacing: 1rpx;
}
.footer-text {
  display: block;
  font-size: 22rpx;
  color: #94a3b8;
  font-family: 'Courier New', monospace;
  letter-spacing: 2rpx;
}
.footer-sub {
  display: block;
  font-size: 18rpx;
  color: #cbd5e1;
  font-family: 'Courier New', monospace;
}
