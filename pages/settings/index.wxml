<!-- 设置页 -->
<scroll-view scroll-y class="settings-page">

  <!-- 顶部标题 -->
  <view class="settings-header">
    <text class="settings-title">⚙ [ 设置 ]</text>
    <text class="settings-subtitle">PIXEL FRIDGE v{{version}}</text>
  </view>

  <!-- ===== 语言学习设置 ===== -->
  <view class="settings-section">
    <text class="section-label">🌍 学习语言选择</text>
    <text class="section-desc">选择食材详情页中显示的外语</text>

    <view class="lang-grid">
      <view
        wx:for="{{languages}}"
        wx:key="id"
        class="lang-option {{settings.language === item.id ? 'lang-selected' : ''}}"
        data-id="{{item.id}}"
        bindtap="onLangSelect"
      >
        <text class="lang-flag">{{item.flag}}</text>
        <text class="lang-name">{{item.name}}</text>
        <view class="lang-check" wx:if="{{settings.language === item.id}}">
          <text>✓</text>
        </view>
      </view>
    </view>
  </view>

  <!-- ===== 冰箱状态 ===== -->
  <view class="settings-section">
    <text class="section-label">❄ 冰箱状态</text>

    <view class="stats-grid">
      <view class="stat-box">
        <text class="stat-big">{{totalItems}}</text>
        <text class="stat-desc">冰箱食材</text>
      </view>
      <view class="stat-box stat-box-danger">
        <text class="stat-big expired-num">{{expiredItems}}</text>
        <text class="stat-desc">已过期</text>
      </view>
    </view>
  </view>

  <!-- ===== 数据管理 ===== -->
  <view class="settings-section">
    <text class="section-label">🗂 数据管理</text>

    <view class="action-list">
      <!-- 添加示例数据 -->
      <view class="action-item" bindtap="onAddSampleData">
        <view class="action-icon-wrap action-blue">
          <text class="action-icon">🧪</text>
        </view>
        <view class="action-info">
          <text class="action-title">添加示例数据</text>
          <text class="action-desc">快速体验冰箱功能</text>
        </view>
        <text class="action-arrow">▶</text>
      </view>

      <!-- 清除过期 -->
      <view class="action-item" bindtap="onClearExpired">
        <view class="action-icon-wrap action-yellow">
          <text class="action-icon">🗑</text>
        </view>
        <view class="action-info">
          <text class="action-title">清除过期食材</text>
          <text class="action-desc">移除所有已过期的食材 ({{expiredItems}} 件)</text>
        </view>
        <text class="action-arrow">▶</text>
      </view>

      <!-- 清空全部 -->
      <view class="action-item action-item-danger" bindtap="onClearAll">
        <view class="action-icon-wrap action-red">
          <text class="action-icon">⚠</text>
        </view>
        <view class="action-info">
          <text class="action-title action-title-danger">清空冰箱</text>
          <text class="action-desc">移除所有食材数据</text>
        </view>
        <text class="action-arrow">▶</text>
      </view>
    </view>
  </view>

  <!-- ===== 颜色图例 ===== -->
  <view class="settings-section">
    <text class="section-label">🎨 保鲜状态说明</text>
    <view class="legend-list">
      <view class="legend-item">
        <view class="legend-dot dot-fresh"></view>
        <text class="legend-text">新鲜 — 3天以上</text>
      </view>
      <view class="legend-item">
        <view class="legend-dot dot-soon"></view>
        <text class="legend-text">快过期 — 1~3天内</text>
      </view>
      <view class="legend-item">
        <view class="legend-dot dot-expired"></view>
        <text class="legend-text">已过期 — 超过保质期</text>
      </view>
      <view class="legend-item">
        <view class="legend-dot dot-unknown"></view>
        <text class="legend-text">未知 — 未设置日期</text>
      </view>
    </view>
  </view>

  <!-- 底部信息 -->
  <view class="footer">
    <text class="footer-pixel">██████████████████</text>
    <text class="footer-text">PIXEL FRIDGE — 像素冰箱管家</text>
    <text class="footer-sub">用像素风格管理你的冰箱食材</text>
    <text class="footer-pixel">██████████████████</text>
  </view>

  <view style="height: 60rpx;"></view>
</scroll-view>
