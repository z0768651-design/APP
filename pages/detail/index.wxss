/* ===== 食材详情页 - 清爽可爱 ===== */
.detail-page {
  min-height: 100vh;
  background: #f0fdf8;
  padding: 24rpx;
  box-sizing: border-box;
}

/* 主英雄卡片 */
.hero-card {
  background: #ffffff;
  border: 3px solid #1e293b;
  box-shadow: 6px 6px 0 #1e293b;
  padding: 36rpx 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  margin-bottom: 20rpx;
}
.hero-card.status-border-soon    { box-shadow: 6px 6px 0 #f59e0b; }
.hero-card.status-border-expired { box-shadow: 6px 6px 0 #fb7185; }
.hero-card.status-border-fresh   { box-shadow: 6px 6px 0 #10b981; }

/* 像素角落装饰 */
.corner-tl, .corner-tr, .corner-bl, .corner-br {
  position: absolute;
  width: 18rpx;
  height: 18rpx;
  background: #14b8a6;
}
.corner-tl { top: -3px; left: -3px; }
.corner-tr { top: -3px; right: -3px; }
.corner-bl { bottom: -3px; left: -3px; }
.corner-br { bottom: -3px; right: -3px; }

.frozen-tag {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  background: #dbeafe;
  border: 2px solid #93c5fd;
  color: #3b82f6;
  font-size: 18rpx;
  font-family: 'Courier New', monospace;
  font-weight: bold;
  padding: 4rpx 12rpx;
}

.hero-icon {
  font-size: 120rpx;
  margin-bottom: 16rpx;
}

.hero-name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.hero-name-cn {
  font-size: 54rpx;
  color: #1e293b;
  font-family: 'Courier New', monospace;
  font-weight: bold;
  letter-spacing: 4rpx;
}
.speak-cn-btn {
  width: 54rpx;
  height: 54rpx;
  background: #f0fdfa;
  border: 2px solid #99f6e4;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 2px 2px 0 #1e293b;
}
.speak-cn-btn.speaking { background: #ccfbf1; border-color: #14b8a6; }
.speak-icon { font-size: 28rpx; }

/* 过期徽章 */
.expiry-badge {
  padding: 8rpx 24rpx;
  margin-bottom: 24rpx;
  border: 2px solid #1e293b;
}
.expiry-badge.status-bg-fresh   { background: #d1fae5; }
.expiry-badge.status-bg-soon    { background: #fef3c7; }
.expiry-badge.status-bg-expired { background: #ffe4e6; }
.expiry-badge.status-bg-unknown { background: #f1f5f9; }
.expiry-badge-text {
  font-size: 24rpx;
  font-family: 'Courier New', monospace;
  font-weight: bold;
}
.status-bg-fresh .expiry-badge-text   { color: #059669; }
.status-bg-soon .expiry-badge-text    { color: #d97706; }
.status-bg-expired .expiry-badge-text { color: #e11d48; }
.status-bg-unknown .expiry-badge-text { color: #64748b; }

/* 元信息条 */
.hero-meta {
  display: flex;
  align-items: center;
  width: 100%;
  background: #f8fafc;
  border: 2px solid #e2e8f0;
  padding: 16rpx 0;
}
.meta-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}
.meta-label {
  font-size: 18rpx;
  color: #94a3b8;
  font-family: 'Courier New', monospace;
}
.meta-value {
  font-size: 24rpx;
  color: #1e293b;
  font-family: 'Courier New', monospace;
  font-weight: bold;
}
.meta-divider {
  width: 2px;
  height: 40rpx;
  background: #e2e8f0;
}

/* ===== 语言学习区 ===== */
.learn-section { margin-bottom: 20rpx; }
.learn-header { margin-bottom: 16rpx; display: flex; align-items: center; gap: 12rpx; }
.learn-title {
  font-size: 28rpx;
  color: #1e293b;
  font-family: 'Courier New', monospace;
  font-weight: bold;
}
.learn-tag {
  background: #ede9fe;
  border: 2px solid #8b5cf6;
  padding: 4rpx 12rpx;
  font-size: 18rpx;
  color: #8b5cf6;
  font-family: 'Courier New', monospace;
  font-weight: bold;
}

/* 语言标签滚动 */
.lang-scroll { width: 100%; margin-bottom: 16rpx; }
.lang-tabs {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
  padding: 0 2rpx;
}
.lang-tab {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 18rpx;
  background: #ffffff;
  border: 2px solid #e2e8f0;
  box-shadow: 3px 3px 0 #e2e8f0;
  min-width: 90rpx;
  white-space: nowrap;
}
.lang-tab.lang-tab-active {
  background: #ede9fe;
  border-color: #8b5cf6;
  box-shadow: 3px 3px 0 #8b5cf6;
}
.lang-flag { font-size: 30rpx; }
.lang-name {
  font-size: 18rpx;
  color: #94a3b8;
  font-family: 'Courier New', monospace;
  margin-top: 4rpx;
}
.lang-tab.lang-tab-active .lang-name { color: #8b5cf6; font-weight: bold; }

/* 翻译卡片 */
.translation-card {
  background: #faf5ff;
  border: 3px solid #8b5cf6;
  box-shadow: 6px 6px 0 #1e293b;
  padding: 36rpx 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}
.pixel-corner-tl {
  position: absolute;
  top: -3px;
  left: -3px;
  width: 20rpx;
  height: 20rpx;
  background: #f59e0b;
}
.pixel-corner-tr {
  position: absolute;
  top: -3px;
  right: -3px;
  width: 20rpx;
  height: 20rpx;
  background: #f59e0b;
}
.trans-lang-flag { font-size: 44rpx; margin-bottom: 4rpx; }
.trans-lang-name {
  font-size: 20rpx;
  color: #94a3b8;
  font-family: 'Courier New', monospace;
  margin-bottom: 24rpx;
}

.trans-word {
  font-size: 68rpx;
  color: #1e293b;
  font-family: 'Courier New', monospace;
  font-weight: bold;
  text-align: center;
  margin-bottom: 20rpx;
  letter-spacing: 4rpx;
}

/* 音标 */
.phonetic-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #ffffff;
  border: 2px solid #ddd6fe;
  padding: 10rpx 24rpx;
  margin-bottom: 28rpx;
}
.phonetic-label {
  font-size: 18rpx;
  color: #94a3b8;
  font-family: 'Courier New', monospace;
}
.phonetic-text {
  font-size: 24rpx;
  color: #8b5cf6;
  font-family: 'Courier New', monospace;
  font-weight: bold;
  letter-spacing: 2rpx;
}

/* 朗读按钮 */
.speak-btn {
  background: #fb7185;
  border: 3px solid #1e293b;
  box-shadow: 4px 4px 0 #1e293b;
  padding: 18rpx 48rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 28rpx;
}
.speak-btn:active, .speak-btn-active {
  box-shadow: 1px 1px 0 #1e293b;
  transform: translate(3px, 3px);
  background: #f43f5e;
}
.speak-btn-icon { font-size: 28rpx; color: #ffffff; }
.speak-btn-text {
  font-size: 26rpx;
  color: #ffffff;
  font-family: 'Courier New', monospace;
  font-weight: bold;
}

/* 对照行 */
.compare-row {
  display: flex;
  align-items: center;
  width: 100%;
  background: #ffffff;
  border: 2px solid #e2e8f0;
  padding: 16rpx;
  gap: 8rpx;
}
.compare-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}
.compare-label {
  font-size: 18rpx;
  color: #94a3b8;
  font-family: 'Courier New', monospace;
}
.compare-word {
  font-size: 28rpx;
  color: #1e293b;
  font-family: 'Courier New', monospace;
  font-weight: bold;
  text-align: center;
}
.compare-arrow {
  font-size: 28rpx;
  color: #14b8a6;
  font-weight: bold;
}

/* 无模板提示 */
.no-template-hint {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx;
  background: #ffffff;
  border: 2px solid #e2e8f0;
  margin-bottom: 20rpx;
  gap: 10rpx;
}
.hint-icon { font-size: 60rpx; }
.hint-text { font-size: 24rpx; color: #94a3b8; font-family: 'Courier New', monospace; }

/* ===== 编辑区域 ===== */
.edit-section {
  background: #ffffff;
  border: 3px solid #e2e8f0;
  box-shadow: 4px 4px 0 #e2e8f0;
  margin-bottom: 20rpx;
}
.edit-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  border-bottom: 2px solid #f1f5f9;
}
.edit-title {
  font-size: 26rpx;
  color: #1e293b;
  font-family: 'Courier New', monospace;
  font-weight: bold;
}
.edit-toggle {
  font-size: 20rpx;
  color: #14b8a6;
  font-family: 'Courier New', monospace;
}
.edit-form { padding: 16rpx 24rpx; }
.edit-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1px solid #f1f5f9;
}
.edit-row:last-child { border-bottom: none; }
.edit-label {
  width: 140rpx;
  font-size: 24rpx;
  color: #64748b;
  font-family: 'Courier New', monospace;
}
.edit-input {
  flex: 1;
  background: #f8fafc;
  border: 2px solid #e2e8f0;
  color: #1e293b;
  font-size: 26rpx;
  font-family: 'Courier New', monospace;
  padding: 8rpx 12rpx;
}
.edit-unit { font-size: 22rpx; color: #94a3b8; font-family: 'Courier New', monospace; }
.edit-picker {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #f0fdfa;
  border: 2px solid #99f6e4;
  padding: 8rpx 14rpx;
}
.edit-picker-text { font-size: 24rpx; color: #14b8a6; font-family: 'Courier New', monospace; font-weight: bold; }
.edit-picker-arrow { font-size: 16rpx; color: #94a3b8; }
.frozen-toggle {
  padding: 8rpx 20rpx;
  border: 2px solid #e2e8f0;
  background: #f8fafc;
}
.frozen-toggle.frozen-on { background: #dbeafe; border-color: #93c5fd; }
.frozen-toggle-text { font-size: 22rpx; font-family: 'Courier New', monospace; color: #64748b; }
.frozen-toggle.frozen-on .frozen-toggle-text { color: #3b82f6; font-weight: bold; }
.edit-actions { padding-top: 20rpx; }
.save-btn {
  background: #14b8a6;
  border: 3px solid #1e293b;
  box-shadow: 3px 3px 0 #1e293b;
  padding: 18rpx;
  text-align: center;
  font-size: 26rpx;
  color: #ffffff;
  font-family: 'Courier New', monospace;
  font-weight: bold;
}
.save-btn:active {
  box-shadow: 1px 1px 0 #1e293b;
  transform: translate(2px, 2px);
}

/* 备注 */
.note-card {
  background: #fffbeb;
  border: 2px solid #fde68a;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
}
.note-label {
  display: block;
  font-size: 20rpx;
  color: #92400e;
  font-family: 'Courier New', monospace;
  font-weight: bold;
  margin-bottom: 8rpx;
}
.note-content {
  font-size: 26rpx;
  color: #78350f;
  font-family: 'Courier New', monospace;
  line-height: 1.6;
}

/* 删除按钮 */
.danger-zone { margin-bottom: 20rpx; }
.delete-btn {
  background: #fff1f2;
  border: 3px solid #fb7185;
  box-shadow: 4px 4px 0 #1e293b;
  padding: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}
.delete-btn:active {
  box-shadow: 1px 1px 0 #1e293b;
  transform: translate(3px, 3px);
}
.delete-icon { font-size: 28rpx; }
.delete-text {
  font-size: 26rpx;
  color: #fb7185;
  font-family: 'Courier New', monospace;
  font-weight: bold;
}
