/* ===== 食材详情页 - 温暖像素游戏风 (Stardew Valley / Kairosoft) ===== */

/* --- Page --- */
.detail-page {
  min-height: 100vh;
  background: #FFF8E7;
  padding: 24rpx;
  box-sizing: border-box;
}

/* --- Hero Card --- */
.hero-card {
  background: linear-gradient(180deg, #FFFDF5 0%, #FFF8E7 100%);
  border: 4rpx solid #5D4037;
  box-shadow: 6rpx 6rpx 0 #8D6E63;
  padding: 36rpx 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  margin-bottom: 20rpx;
}
.hero-card.status-border-fresh   { border-color: #4CAF50; box-shadow: 6rpx 6rpx 0 #4CAF50; }
.hero-card.status-border-soon    { border-color: #FFB300; box-shadow: 6rpx 6rpx 0 #FFB300; }
.hero-card.status-border-expired { border-color: #EF5350; box-shadow: 6rpx 6rpx 0 #EF5350; }

/* Pixel corner decorations */
.corner-tl, .corner-tr, .corner-bl, .corner-br {
  position: absolute;
  width: 18rpx;
  height: 18rpx;
  background: #FFB300;
  z-index: 2;
}
.corner-tl { top: -4rpx; left: -4rpx; }
.corner-tr { top: -4rpx; right: -4rpx; }
.corner-bl { bottom: -4rpx; left: -4rpx; }
.corner-br { bottom: -4rpx; right: -4rpx; }

/* Frozen tag */
.frozen-tag {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  background: linear-gradient(180deg, #E3F2FD 0%, #BBDEFB 100%);
  border: 3rpx solid #42A5F5;
  color: #1565C0;
  font-size: 18rpx;
  font-family: 'Courier New', monospace;
  font-weight: bold;
  padding: 4rpx 14rpx;
  box-shadow: 2rpx 2rpx 0 #8D6E63;
}

/* Hero icon & name */
.hero-icon {
  font-size: 120rpx;
  margin-bottom: 16rpx;
  filter: drop-shadow(3rpx 3rpx 0 #D7CCC8);
}
.hero-name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.hero-name-cn {
  font-size: 54rpx;
  color: #3E2723;
  font-family: 'Courier New', monospace;
  font-weight: bold;
  letter-spacing: 4rpx;
  text-shadow: 2rpx 2rpx 0 #D7CCC8;
}

/* Speak button (small) */
.speak-cn-btn {
  width: 56rpx;
  height: 56rpx;
  background: linear-gradient(180deg, #FFFDF5 0%, #FFF8E1 100%);
  border: 3rpx solid #8D6E63;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 3rpx 3rpx 0 #8D6E63;
}
.speak-cn-btn:active {
  box-shadow: 1rpx 1rpx 0 #5D4037;
  transform: translate(2rpx, 2rpx);
}
.speak-cn-btn.speaking {
  background: linear-gradient(180deg, #FFD54F 0%, #FFB300 100%);
  border-color: #5D4037;
}
.speak-icon {
  font-size: 28rpx;
}

/* --- Expiry Badge --- */
.expiry-badge {
  padding: 10rpx 28rpx;
  margin-bottom: 24rpx;
  border: 3rpx solid #5D4037;
  box-shadow: 3rpx 3rpx 0 #8D6E63;
}
.expiry-badge.status-bg-fresh   { background: linear-gradient(180deg, #E8F5E9 0%, #C8E6C9 100%); }
.expiry-badge.status-bg-soon    { background: linear-gradient(180deg, #FFF8E1 0%, #FFECB3 100%); }
.expiry-badge.status-bg-expired { background: linear-gradient(180deg, #FFEBEE 0%, #FFCDD2 100%); }
.expiry-badge.status-bg-unknown { background: linear-gradient(180deg, #EFEBE9 0%, #D7CCC8 100%); }
.expiry-badge-text {
  font-size: 24rpx;
  font-family: 'Courier New', monospace;
  font-weight: bold;
  letter-spacing: 1rpx;
}
.status-bg-fresh .expiry-badge-text   { color: #2E7D32; }
.status-bg-soon .expiry-badge-text    { color: #E65100; }
.status-bg-expired .expiry-badge-text { color: #C62828; }
.status-bg-unknown .expiry-badge-text { color: #5D4037; }

/* --- Hero Meta Bar --- */
.hero-meta {
  display: flex;
  align-items: center;
  width: 100%;
  background: #FFF8E1;
  border: 3rpx solid #8D6E63;
  padding: 16rpx 0;
  box-shadow: inset 0 2rpx 0 #FFD54F;
}
.meta-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}
.meta-label {
  font-size: 18rpx;
  color: #8D6E63;
  font-family: 'Courier New', monospace;
  text-transform: uppercase;
  letter-spacing: 1rpx;
}
.meta-value {
  font-size: 24rpx;
  color: #3E2723;
  font-family: 'Courier New', monospace;
  font-weight: bold;
}
.meta-divider {
  width: 3rpx;
  height: 44rpx;
  background: #D7CCC8;
}

/* ===== Language Learning Section ===== */
.learn-section {
  margin-bottom: 20rpx;
}
.learn-header {
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.learn-title {
  font-size: 28rpx;
  color: #3E2723;
  font-family: 'Courier New', monospace;
  font-weight: bold;
  text-shadow: 1rpx 1rpx 0 #D7CCC8;
}
.learn-tag {
  background: linear-gradient(180deg, #CE93D8 0%, #AB47BC 100%);
  border: 3rpx solid #5D4037;
  padding: 4rpx 14rpx;
  font-size: 18rpx;
  color: #FFFDF5;
  font-family: 'Courier New', monospace;
  font-weight: bold;
  box-shadow: 2rpx 2rpx 0 #8D6E63;
  text-shadow: 1rpx 1rpx 0 #7B1FA2;
}

/* --- Language Tabs (game item category selector) --- */
.lang-scroll {
  width: 100%;
  margin-bottom: 16rpx;
}
.lang-tabs {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
  padding: 0 2rpx;
}
.lang-tab {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 14rpx 20rpx;
  background: linear-gradient(180deg, #FFFDF5 0%, #FFF8E7 100%);
  border: 3rpx solid #8D6E63;
  box-shadow: 3rpx 3rpx 0 #D7CCC8;
  min-width: 90rpx;
  white-space: nowrap;
}
.lang-tab:active {
  box-shadow: 1rpx 1rpx 0 #8D6E63;
  transform: translate(2rpx, 2rpx);
}
.lang-tab.lang-tab-active {
  background: linear-gradient(180deg, #FFF8E1 0%, #FFD54F 100%);
  border-color: #5D4037;
  box-shadow: 3rpx 3rpx 0 #8D6E63;
}
.lang-flag {
  font-size: 32rpx;
}
.lang-name {
  font-size: 18rpx;
  color: #8D6E63;
  font-family: 'Courier New', monospace;
  margin-top: 4rpx;
}
.lang-tab.lang-tab-active .lang-name {
  color: #3E2723;
  font-weight: bold;
}

/* --- Translation Card --- */
.translation-card {
  background: linear-gradient(180deg, #F3E5F5 0%, #FFFDF5 100%);
  border: 4rpx solid #AB47BC;
  box-shadow: 6rpx 6rpx 0 #8D6E63;
  padding: 36rpx 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}
.pixel-corner-tl {
  position: absolute;
  top: -4rpx;
  left: -4rpx;
  width: 20rpx;
  height: 20rpx;
  background: #FFB300;
}
.pixel-corner-tr {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  width: 20rpx;
  height: 20rpx;
  background: #FFB300;
}
.trans-lang-flag {
  font-size: 44rpx;
  margin-bottom: 4rpx;
}
.trans-lang-name {
  font-size: 20rpx;
  color: #8D6E63;
  font-family: 'Courier New', monospace;
  margin-bottom: 24rpx;
  letter-spacing: 1rpx;
}
.trans-word {
  font-size: 68rpx;
  color: #3E2723;
  font-family: 'Courier New', monospace;
  font-weight: bold;
  text-align: center;
  margin-bottom: 20rpx;
  letter-spacing: 4rpx;
  text-shadow: 3rpx 3rpx 0 #D7CCC8;
}

/* Phonetic */
.phonetic-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #FFFDF5;
  border: 3rpx solid #CE93D8;
  padding: 10rpx 24rpx;
  margin-bottom: 28rpx;
  box-shadow: 2rpx 2rpx 0 #E1BEE7;
}
.phonetic-label {
  font-size: 18rpx;
  color: #8D6E63;
  font-family: 'Courier New', monospace;
}
.phonetic-text {
  font-size: 24rpx;
  color: #AB47BC;
  font-family: 'Courier New', monospace;
  font-weight: bold;
  letter-spacing: 2rpx;
}

/* Speak button (large) */
.speak-btn {
  background: linear-gradient(180deg, #FF8A80 0%, #EF5350 100%);
  border: 4rpx solid #5D4037;
  box-shadow: 4rpx 4rpx 0 #8D6E63;
  padding: 18rpx 48rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 28rpx;
  position: relative;
}
.speak-btn::after {
  content: '';
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  right: 4rpx;
  height: 10rpx;
  background: rgba(255, 255, 255, 0.15);
}
.speak-btn:active,
.speak-btn-active {
  box-shadow: 2rpx 2rpx 0 #5D4037;
  transform: translate(3rpx, 3rpx);
  background: linear-gradient(180deg, #EF5350 0%, #D32F2F 100%);
}
.speak-btn-icon {
  font-size: 30rpx;
  color: #FFFDF5;
  text-shadow: 1rpx 1rpx 0 #B71C1C;
}
.speak-btn-text {
  font-size: 26rpx;
  color: #FFFDF5;
  font-family: 'Courier New', monospace;
  font-weight: bold;
  text-shadow: 1rpx 1rpx 0 #B71C1C;
  letter-spacing: 2rpx;
}

/* --- Compare Row --- */
.compare-row {
  display: flex;
  align-items: center;
  width: 100%;
  background: #FFF8E1;
  border: 3rpx solid #8D6E63;
  padding: 16rpx;
  gap: 8rpx;
}
.compare-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}
.compare-label {
  font-size: 18rpx;
  color: #8D6E63;
  font-family: 'Courier New', monospace;
}
.compare-word {
  font-size: 28rpx;
  color: #3E2723;
  font-family: 'Courier New', monospace;
  font-weight: bold;
  text-align: center;
}
.compare-arrow {
  font-size: 28rpx;
  color: #FFB300;
  font-weight: bold;
  text-shadow: 1rpx 1rpx 0 #5D4037;
}

/* --- No Template Hint --- */
.no-template-hint {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 44rpx;
  background: linear-gradient(180deg, #FFFDF5 0%, #FFF8E7 100%);
  border: 3rpx dashed #8D6E63;
  box-shadow: 4rpx 4rpx 0 #D7CCC8;
  margin-bottom: 20rpx;
  gap: 12rpx;
}
.hint-icon {
  font-size: 64rpx;
}
.hint-text {
  font-size: 24rpx;
  color: #8D6E63;
  font-family: 'Courier New', monospace;
  text-align: center;
}

/* ===== Edit Section ===== */
.edit-section {
  background: #FFFDF5;
  border: 4rpx solid #5D4037;
  box-shadow: 6rpx 6rpx 0 #8D6E63;
  margin-bottom: 20rpx;
  overflow: hidden;
}
.edit-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  border-bottom: 3rpx solid #4E342E;
  background: linear-gradient(180deg, #6D4C41 0%, #5D4037 50%, #4E342E 100%);
}
.edit-title {
  font-size: 26rpx;
  color: #FFD54F;
  font-family: 'Courier New', monospace;
  font-weight: bold;
  text-shadow: 1rpx 1rpx 0 #3E2723;
  letter-spacing: 1rpx;
}
.edit-toggle {
  font-size: 20rpx;
  color: #FFC107;
  font-family: 'Courier New', monospace;
  font-weight: bold;
  text-shadow: 1rpx 1rpx 0 #3E2723;
}

.edit-form {
  padding: 16rpx 24rpx;
}
.edit-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 2rpx dashed #E8D5B7;
}
.edit-row:last-child {
  border-bottom: none;
}
.edit-label {
  width: 140rpx;
  font-size: 24rpx;
  color: #5D4037;
  font-family: 'Courier New', monospace;
  font-weight: bold;
  flex-shrink: 0;
}
.edit-input {
  flex: 1;
  background: #FFF8E7;
  border: 3rpx solid #8D6E63;
  color: #3E2723;
  font-size: 26rpx;
  font-family: 'Courier New', monospace;
  padding: 10rpx 14rpx;
  box-shadow: inset 2rpx 2rpx 0 #E8D5B7;
}
.edit-unit {
  font-size: 22rpx;
  color: #8D6E63;
  font-family: 'Courier New', monospace;
  font-weight: bold;
}

.edit-picker {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #FFF8E1;
  border: 3rpx solid #8D6E63;
  padding: 10rpx 16rpx;
  box-shadow: 3rpx 3rpx 0 #D7CCC8;
}
.edit-picker:active {
  box-shadow: 1rpx 1rpx 0 #8D6E63;
  transform: translate(2rpx, 2rpx);
}
.edit-picker-text {
  font-size: 24rpx;
  color: #5D4037;
  font-family: 'Courier New', monospace;
  font-weight: bold;
}
.edit-picker-arrow {
  font-size: 16rpx;
  color: #8D6E63;
}

/* Frozen toggle */
.frozen-toggle {
  padding: 10rpx 22rpx;
  border: 3rpx solid #8D6E63;
  background: #FFFDF5;
  box-shadow: 3rpx 3rpx 0 #D7CCC8;
}
.frozen-toggle:active {
  box-shadow: 1rpx 1rpx 0 #8D6E63;
  transform: translate(2rpx, 2rpx);
}
.frozen-toggle.frozen-on {
  background: linear-gradient(180deg, #E3F2FD 0%, #BBDEFB 100%);
  border-color: #42A5F5;
  box-shadow: 3rpx 3rpx 0 #64B5F6;
}
.frozen-toggle.frozen-off {
  background: #EFEBE9;
  border-color: #8D6E63;
}
.frozen-toggle-text {
  font-size: 22rpx;
  font-family: 'Courier New', monospace;
  color: #8D6E63;
}
.frozen-toggle.frozen-on .frozen-toggle-text {
  color: #1565C0;
  font-weight: bold;
}

/* Edit actions */
.edit-actions {
  padding: 16rpx 24rpx 20rpx;
}
.save-btn {
  background: linear-gradient(180deg, #81C784 0%, #66BB6A 40%, #4CAF50 100%);
  border: 4rpx solid #5D4037;
  box-shadow: 4rpx 4rpx 0 #8D6E63;
  padding: 20rpx;
  text-align: center;
  font-size: 26rpx;
  color: #FFFDF5;
  font-family: 'Courier New', monospace;
  font-weight: bold;
  text-shadow: 1rpx 1rpx 0 #2E7D32;
  letter-spacing: 2rpx;
  position: relative;
}
.save-btn::after {
  content: '';
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  right: 4rpx;
  height: 10rpx;
  background: rgba(255, 255, 255, 0.15);
}
.save-btn:active {
  box-shadow: 2rpx 2rpx 0 #5D4037;
  transform: translate(2rpx, 2rpx);
}

/* --- Note Card --- */
.note-card {
  background: linear-gradient(180deg, #FFF8E1 0%, #FFFDF5 100%);
  border: 4rpx solid #FFB300;
  box-shadow: 4rpx 4rpx 0 #8D6E63;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
  position: relative;
}
.note-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: linear-gradient(90deg, #FFB300, #FFD54F, #FFB300);
}
.note-label {
  display: block;
  font-size: 20rpx;
  color: #5D4037;
  font-family: 'Courier New', monospace;
  font-weight: bold;
  margin-bottom: 10rpx;
  letter-spacing: 1rpx;
}
.note-content {
  font-size: 26rpx;
  color: #3E2723;
  font-family: 'Courier New', monospace;
  line-height: 1.6;
}

/* --- Danger Zone / Delete --- */
.danger-zone {
  margin-bottom: 20rpx;
}
.delete-btn {
  background: linear-gradient(180deg, #FFEBEE 0%, #FFCDD2 100%);
  border: 4rpx solid #EF5350;
  box-shadow: 4rpx 4rpx 0 #8D6E63;
  padding: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}
.delete-btn:active {
  box-shadow: 2rpx 2rpx 0 #5D4037;
  transform: translate(3rpx, 3rpx);
  background: linear-gradient(180deg, #FFCDD2 0%, #FF8A80 100%);
}
.delete-icon {
  font-size: 28rpx;
}
.delete-text {
  font-size: 26rpx;
  color: #C62828;
  font-family: 'Courier New', monospace;
  font-weight: bold;
  text-shadow: 1rpx 1rpx 0 #FFCDD2;
  letter-spacing: 1rpx;
}
