/* ===== 食材详情页 ===== */
.detail-page {
  min-height: 100vh;
  background: #0a0a1a;
  padding: 24rpx;
  box-sizing: border-box;
}

/* 主卡片 */
.hero-card {
  background: #111130;
  border: 3px solid #333;
  box-shadow: 6px 6px 0 #000;
  padding: 36rpx 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  margin-bottom: 24rpx;
  overflow: visible;
}
.hero-card.status-border-soon    { border-color: #ffd54f; }
.hero-card.status-border-expired { border-color: #ff5252; }
.hero-card.status-border-fresh   { border-color: #333; }

/* 像素角落装饰 */
.corner-tl, .corner-tr, .corner-bl, .corner-br {
  position: absolute;
  width: 16rpx;
  height: 16rpx;
  background: #4fc3f7;
}
.corner-tl { top: -3px; left: -3px; }
.corner-tr { top: -3px; right: -3px; }
.corner-bl { bottom: -3px; left: -3px; }
.corner-br { bottom: -3px; right: -3px; }

.frozen-tag {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  background: #1a3a5c;
  border: 2px solid #4fc3f7;
  color: #4fc3f7;
  font-size: 18rpx;
  font-family: 'Courier New', monospace;
  padding: 4rpx 12rpx;
}

.hero-icon {
  font-size: 120rpx;
  margin-bottom: 20rpx;
  image-rendering: pixelated;
}

.hero-name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.hero-name-cn {
  font-size: 52rpx;
  color: #fff;
  font-family: 'Courier New', monospace;
  font-weight: bold;
  letter-spacing: 4rpx;
}
.speak-cn-btn {
  width: 52rpx;
  height: 52rpx;
  background: #1a1a3a;
  border: 2px solid #555;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}
.speak-cn-btn.speaking { border-color: #4fc3f7; background: #0d2040; }
.speak-icon { font-size: 28rpx; }

/* 过期状态 */
.expiry-badge {
  padding: 8rpx 24rpx;
  margin-bottom: 24rpx;
  border: 2px solid #000;
}
.expiry-badge.status-bg-fresh   { background: #1a3d2e; }
.expiry-badge.status-bg-soon    { background: #3d2e00; }
.expiry-badge.status-bg-expired { background: #3d0a0a; }
.expiry-badge.status-bg-unknown { background: #1a1a2e; }
.expiry-badge-text {
  font-size: 24rpx;
  font-family: 'Courier New', monospace;
  font-weight: bold;
}
.status-bg-fresh .expiry-badge-text   { color: #69f0ae; }
.status-bg-soon .expiry-badge-text    { color: #ffd54f; }
.status-bg-expired .expiry-badge-text { color: #ff5252; }
.status-bg-unknown .expiry-badge-text { color: #888; }

/* 元信息 */
.hero-meta {
  display: flex;
  align-items: center;
  width: 100%;
  background: #0a0a1a;
  border: 2px solid #222;
  padding: 16rpx 0;
}
.meta-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}
.meta-label {
  font-size: 18rpx;
  color: #555;
  font-family: 'Courier New', monospace;
}
.meta-value {
  font-size: 24rpx;
  color: #ccc;
  font-family: 'Courier New', monospace;
  font-weight: bold;
}
.meta-divider {
  width: 2px;
  height: 40rpx;
  background: #222;
}

/* ===== 语言学习 ===== */
.learn-section { margin-bottom: 24rpx; }
.learn-header { margin-bottom: 16rpx; }
.learn-title {
  font-size: 28rpx;
  color: #4fc3f7;
  font-family: 'Courier New', monospace;
  font-weight: bold;
  letter-spacing: 2rpx;
}

/* 语言标签 */
.lang-scroll { width: 100%; margin-bottom: 16rpx; }
.lang-tabs {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
  padding: 0 2rpx;
}
.lang-tab {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 16rpx;
  background: #111130;
  border: 2px solid #2a2a50;
  box-shadow: 3px 3px 0 #000;
  min-width: 90rpx;
  white-space: nowrap;
}
.lang-tab.lang-tab-active {
  background: #0d2040;
  border-color: #4fc3f7;
}
.lang-flag { font-size: 28rpx; }
.lang-name {
  font-size: 18rpx;
  color: #888;
  font-family: 'Courier New', monospace;
  margin-top: 4rpx;
}
.lang-tab.lang-tab-active .lang-name { color: #4fc3f7; }

/* 翻译卡片 */
.translation-card {
  background: #0d1428;
  border: 3px solid #4fc3f7;
  box-shadow: 6px 6px 0 #000;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}
.pixel-corner-tl {
  position: absolute;
  top: -3px;
  left: -3px;
  width: 20rpx;
  height: 20rpx;
  background: #ffd54f;
}
.pixel-corner-tr {
  position: absolute;
  top: -3px;
  right: -3px;
  width: 20rpx;
  height: 20rpx;
  background: #ffd54f;
}
.trans-lang-flag {
  font-size: 40rpx;
  margin-bottom: 4rpx;
}
.trans-lang-name {
  font-size: 20rpx;
  color: #888;
  font-family: 'Courier New', monospace;
  margin-bottom: 20rpx;
}
.trans-word {
  font-size: 64rpx;
  color: #ffffff;
  font-family: 'Courier New', monospace;
  font-weight: bold;
  letter-spacing: 4rpx;
  text-align: center;
  margin-bottom: 16rpx;
}
.phonetic-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #0a0a1a;
  border: 2px solid #2a2a50;
  padding: 10rpx 20rpx;
  margin-bottom: 28rpx;
}
.phonetic-label {
  font-size: 18rpx;
  color: #555;
  font-family: 'Courier New', monospace;
}
.phonetic-text {
  font-size: 24rpx;
  color: #69f0ae;
  font-family: 'Courier New', monospace;
  letter-spacing: 2rpx;
}

/* 朗读按钮 */
.speak-btn {
  background: #4fc3f7;
  border: 3px solid #000;
  box-shadow: 4px 4px 0 #000;
  padding: 16rpx 40rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 28rpx;
}
.speak-btn:active, .speak-btn-active {
  box-shadow: 1px 1px 0 #000;
  transform: translate(3px, 3px);
  background: #0288d1;
}
.speak-btn-icon {
  font-size: 28rpx;
  color: #0a0a1a;
}
.speak-btn-text {
  font-size: 26rpx;
  color: #0a0a1a;
  font-family: 'Courier New', monospace;
  font-weight: bold;
}

/* 对照行 */
.compare-row {
  display: flex;
  align-items: center;
  width: 100%;
  background: #0a0a1a;
  border: 2px solid #222;
  padding: 16rpx;
  gap: 12rpx;
}
.compare-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}
.compare-label {
  font-size: 18rpx;
  color: #555;
  font-family: 'Courier New', monospace;
}
.compare-word {
  font-size: 30rpx;
  color: #ccc;
  font-family: 'Courier New', monospace;
  font-weight: bold;
}
.compare-arrow {
  font-size: 28rpx;
  color: #4fc3f7;
  font-family: 'Courier New', monospace;
}

/* 无模板提示 */
.no-template-hint {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx;
  background: #111130;
  border: 2px solid #222;
  margin-bottom: 24rpx;
}
.hint-icon { font-size: 60rpx; margin-bottom: 12rpx; }
.hint-text { font-size: 24rpx; color: #555; font-family: 'Courier New', monospace; }

/* 编辑区域 */
.edit-section {
  background: #111130;
  border: 2px solid #333;
  box-shadow: 4px 4px 0 #000;
  margin-bottom: 24rpx;
}
.edit-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  border-bottom: 1px solid #222;
}
.edit-title {
  font-size: 26rpx;
  color: #4fc3f7;
  font-family: 'Courier New', monospace;
  font-weight: bold;
}
.edit-toggle {
  font-size: 20rpx;
  color: #555;
  font-family: 'Courier New', monospace;
}
.edit-form { padding: 16rpx 24rpx; }
.edit-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1px solid #1a1a3a;
}
.edit-row:last-child { border-bottom: none; }
.edit-label {
  width: 140rpx;
  font-size: 24rpx;
  color: #888;
  font-family: 'Courier New', monospace;
}
.edit-input {
  flex: 1;
  background: #0a0a1a;
  border: 2px solid #333;
  color: #e0e0e0;
  font-size: 26rpx;
  font-family: 'Courier New', monospace;
  padding: 8rpx 12rpx;
}
.edit-unit {
  font-size: 22rpx;
  color: #555;
  font-family: 'Courier New', monospace;
}
.edit-picker {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #0a0a1a;
  border: 2px solid #333;
  padding: 8rpx 12rpx;
}
.edit-picker-text { font-size: 24rpx; color: #4fc3f7; font-family: 'Courier New', monospace; }
.edit-picker-arrow { font-size: 18rpx; color: #555; }
.frozen-toggle {
  padding: 8rpx 20rpx;
  border: 2px solid #333;
}
.frozen-toggle.frozen-on { background: #0d2040; border-color: #4fc3f7; }
.frozen-toggle.frozen-off { background: #1a1a2e; }
.frozen-toggle-text {
  font-size: 22rpx;
  font-family: 'Courier New', monospace;
  color: #4fc3f7;
}
.frozen-toggle.frozen-off .frozen-toggle-text { color: #555; }

.edit-actions { padding-top: 20rpx; }
.save-btn {
  background: #69f0ae;
  border: 2px solid #000;
  box-shadow: 3px 3px 0 #000;
  padding: 18rpx;
  text-align: center;
  font-size: 26rpx;
  color: #0a0a1a;
  font-family: 'Courier New', monospace;
  font-weight: bold;
}
.save-btn:active {
  box-shadow: 1px 1px 0 #000;
  transform: translate(2px, 2px);
}

/* 备注 */
.note-card {
  background: #111130;
  border: 2px solid #2a2a40;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}
.note-label {
  display: block;
  font-size: 20rpx;
  color: #555;
  font-family: 'Courier New', monospace;
  margin-bottom: 8rpx;
}
.note-content {
  font-size: 26rpx;
  color: #aaa;
  font-family: 'Courier New', monospace;
  line-height: 1.6;
}

/* 删除区域 */
.danger-zone { margin-bottom: 20rpx; }
.delete-btn {
  background: #1a0000;
  border: 2px solid #ff5252;
  box-shadow: 4px 4px 0 #000;
  padding: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}
.delete-btn:active {
  box-shadow: 1px 1px 0 #000;
  transform: translate(3px, 3px);
}
.delete-icon { font-size: 28rpx; }
.delete-text {
  font-size: 26rpx;
  color: #ff5252;
  font-family: 'Courier New', monospace;
  font-weight: bold;
}
