}
.shower-water {
  position: absolute;
  width: 4rpx;
  height: 4rpx;
  background: #93c5fd;
  border-radius: 50%;
  opacity: 0.6;
}
.w1 { top: 30rpx; left: 32rpx; }
.w2 { top: 40rpx; left: 42rpx; }
.w3 { top: 36rpx; left: 26rpx; }
.shower-drain {
  position: absolute;
  bottom: 10rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 12rpx;
  height: 12rpx;
  border: 2px solid #94a3b8;
  border-radius: 50%;
  background: #e2e8f0;
}

