}
.card-zh {
  font-size: 24rpx;
  color: white;
  font-weight: bold;
  text-align: center;
}
.card-en {
  font-size: 22rpx;
  color: white;
  font-weight: bold;
  text-align: center;
}
.card-phonetic {
  font-size: 13rpx;
  color: rgba(255,255,255,0.8);
  text-align: center;
  font-style: italic;
}
.lang-card-nav {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.nav-btn {
  width: 36rpx;
  height: 36rpx;
  background: rgba(20,184,166,0.2);
  border-radius: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
  color: #14b8a6;
  border: 1px solid #14b8a6;
  cursor: pointer;
}
.card-counter {
  font-size: 14rpx;
  color: #94a3b8;
  min-width: 80rpx;
  text-align: center;
}
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 40rpx 20rpx;
}
.empty-icon {
  font-size: 60rpx;
}
.empty-text {
  color: #94a3b8;
  text-align: center;
}

/* 闹钟设置 */
.alarm-section {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.alarm-section-title {
  font-size: 16rpx;
  color: #f1f5f9;
  font-weight: bold;
}
.alarm-picker-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.alarm-picker-box {
  width: 50rpx;
  height: 40rpx;
  background: rgba(0,0,0,0.2);
  border: 1px solid #14b8a6;
  border-radius: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.alarm-picker-val {
  font-size: 20rpx;
  color: #f1f5f9;
  font-weight: bold;
  font-family: 'Courier New', monospace;
}
.alarm-colon {
  font-size: 20rpx;
  color: #f1f5f9;
}
.alarm-set-btn,
.alarm-cancel-btn {
  padding: 8rpx 12rpx;
  background: #14b8a6;
  border-radius: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14rpx;
  font-weight: bold;
}
.alarm-cancel-btn {
  background: #ef4444;
}
.alarm-set-text,
.alarm-cancel-text {
  color: white;
}
.alarm-status {
  display: block;
  text-align: center;
  color: #14b8a6;
  margin-top: 8rpx;
  font-size: 14rpx;
}

.sleeping-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 20rpx 0;
}
.sleep-emoji {
  font-size: 48rpx;
  animation: float 2s ease-in-out infinite;
}
@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10rpx); }
}
.sleep-text {
  font-size: 16rpx;
  color: #f1f5f9;
  font-weight: bold;
}

.panel-divider {
  height: 1px;
  background: rgba(20,184,166,0.3);
  margin: 8rpx 0;
}

/* 女朋友面板 */
.gf-mood-bar {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding-bottom: 12rpx;
  border-bottom: 1px solid rgba(20,184,166,0.3);
}
.gf-mood-label {
  font-size: 14rpx;
  color: #94a3b8;
  min-width: 60rpx;
}
.gf-mood-val {
  font-size: 16rpx;
  color: #f1f5f9;
  font-weight: bold;
  min-width: 30rpx;
  text-align: right;
}
.gf-tone-select {
  padding: 12rpx 0;
  border-bottom: 1px solid rgba(20,184,166,0.3);
}
.tone-label {
  font-size: 14rpx;
  color: #94a3b8;
  margin-bottom: 8rpx;
}
.tone-buttons {
  display: flex;
  gap: 8rpx;
}
.tone-btn {
  flex: 1;
  padding: 8rpx 10rpx;
  background: rgba(20,184,166,0.1);
  border: 1px solid rgba(20,184,166,0.3);
  border-radius: 4rpx;
  color: #cbd5e1;
  text-align: center;
  font-size: 14rpx;
  transition: all 0.3s ease;
}
.tone-btn.tone-active {
  background: rgba(20,184,166,0.3);
  border-color: #14b8a6;
  color: #14b8a6;
  font-weight: bold;
}
.gf-response-box {
  padding: 12rpx 14rpx;
  background: rgba(20,184,166,0.1);
  border-radius: 6rpx;
  border-left: 3px solid #14b8a6;
  margin: 12rpx 0;
}
.gf-response-text {
  font-size: 16rpx;
  color: #f1f5f9;
  line-height: 1.5;
}
.gf-stats {
  text-align: center;
  font-size: 14rpx;
  color: #94a3b8;
  padding: 8rpx 0;
}

/* 小狗面板 */
.dog-stats {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-bottom: 12rpx;
  padding-bottom: 12rpx;
  border-bottom: 1px solid rgba(20,184,166,0.3);
}

.hygiene-fill { background: linear-gradient(90deg, #06b6d4, #0ea5e9); }

/* 面板操作按钮 */
.panel-actions {
  display: flex;
  gap: 10rpx;
  padding: 12rpx 20rpx 20rpx;
  flex-shrink: 0;
  border-top: 1px solid rgba(20,184,166,0.3);
  flex-wrap: wrap;
}
.dog-actions {
  flex-direction: column;
}
.panel-btn {
  flex: 1;
  min-width: 100rpx;
  padding: 12rpx 16rpx;
  background: rgba(20,184,166,0.1);
  border: 1px solid #14b8a6;
  border-radius: 6rpx;
  color: #14b8a6;
  text-align: center;
  transition: all 0.3s ease;
  cursor: pointer;
}
.panel-btn:active {
  background: rgba(20,184,166,0.2);
  transform: scale(0.95);
}
.panel-btn-primary {
  background: #14b8a6;
  color: white;
  border-color: #14b8a6;
}
.panel-btn-primary:active {
  background: #0d9488;
}
.panel-btn-text {
  font-size: 16rpx;
  font-weight: bold;
  display: block;
}

/* ===== Toast提示 ===== */
.game-toast {
  position: fixed;
  top: 20%;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(0,0,0,0.9);
  padding: 20rpx 30rpx;
  border-radius: 50rpx;
  color: #f1f5f9;
  z-index: 2000;
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.3s ease;
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.game-toast.toast-show {
  opacity: 1;
}
.toast-icon {
  font-size: 28rpx;
}
.toast-text {
  font-size: 16rpx;
  font-weight: bold;
}

/* ===== 底部 ===== */
.home-footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 20rpx;
  text-align: center;
  color: #94a3b8;
  font-size: 14rpx;
  border-top: 1px solid rgba(20,184,166,0.2);
}
.footer-hint {
  font-size: 14rpx;
  color: #cbd5e1;
}
.footer-sub {
  font-size: 12rpx;
  color: #64748b;
}
