/* ===== 像素之家 - 经营游戏样式 ===== */
.home-wrap {
  min-height: 100vh;
  background: #f8fafc;
}
.home-wrap.light-bg {
  background: linear-gradient(180deg, #f8fafc 0%, #f1f5f9 100%);
}

/* ===== 游戏顶部状态栏 ===== */
.game-header {
  padding: 24rpx 20rpx 16rpx;
  background: linear-gradient(180deg, #1e293b 0%, #0f172a 100%);
  border-bottom: 3px solid #14b8a6;
}
.header-top-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}
.greeting-area {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.time-icon {
  font-size: 40rpx;
  animation: iconBob 3s ease-in-out infinite;
}
@keyframes iconBob {
  0%,100% { transform: translateY(0); }
  50% { transform: translateY(-4rpx); }
}
.greeting-info { display: flex; flex-direction: column; gap: 2rpx; }
.greeting-main {
  font-size: 32rpx;
  color: #f1f5f9;
  font-family: 'Courier New', monospace;
  font-weight: bold;
}
.greeting-clock {
  font-size: 22rpx;
  color: #14b8a6;
  font-family: 'Courier New', monospace;
}
.level-badge {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 3rpx;
}
.level-text {
  font-size: 28rpx;
  color: #fbbf24;
  font-weight: bold;
  font-family: 'Courier New', monospace;
}
.coins-text {
  font-size: 20rpx;
  color: #34d399;
  font-family: 'Courier New', monospace;
}

/* ===== 状态条 (仅体力+心情) ===== */
.status-bars {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 12rpx;
}
.stat-bar-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 0;
}
.stat-icon {
  font-size: 24rpx;
  min-width: 28rpx;
  text-align: center;
}
.stat-bar-track {
  flex: 1;
  height: 18rpx;
  background: rgba(255,255,255,0.1);
  border-radius: 4rpx;
  border: 1px solid rgba(255,255,255,0.2);
  overflow: hidden;
}
.stat-bar-fill {
  height: 100%;
  transition: width 0.3s ease;
}
.energy-fill { background: linear-gradient(90deg, #fbbf24, #fcd34d); }
.mood-fill { background: linear-gradient(90deg, #ec4899, #f472b6); }
.stat-val {
  font-size: 18rpx;
  color: #cbd5e1;
  min-width: 30rpx;
  text-align: right;
  font-family: 'Courier New', monospace;
  font-weight: bold;
}

/* 食材概览 */
.food-stats-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 0;
  border-top: 1px solid rgba(20,184,166,0.3);
  border-bottom: 1px solid rgba(20,184,166,0.3);
  font-size: 18rpx;
}
.food-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
}
.food-stat-num {
  font-size: 24rpx;
  color: #f1f5f9;
  font-weight: bold;
  font-family: 'Courier New', monospace;
}
.food-stat-lbl {
  font-size: 14rpx;
  color: #94a3b8;
}
.warn-c { color: #fbbf24; }
.danger-c { color: #f87171; }
.food-stat-div {
  width: 1px;
  height: 28rpx;
  background: rgba(255,255,255,0.1);
}
.food-stat-spacer { flex: 1; }
.alarm-indicator {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 4rpx 8rpx;
  background: rgba(20,184,166,0.1);
  border-radius: 4rpx;
}
.alarm-icon { font-size: 20rpx; }
.alarm-time-txt {
  font-size: 16rpx;
  color: #14b8a6;
  font-family: 'Courier New', monospace;
}

/* ===== 房子容器 ===== */
.house-container {
  padding: 12rpx 20rpx;
  display: flex;
  flex-direction: column;
}

/* 屋顶 */
.house-roof {
  display: flex;
  justify-content: center;
  align-items: flex-end;
  margin-bottom: 0;
  height: 40rpx;
  gap: 60rpx;
  position: relative;
}
.roof-pixel {
  width: 60rpx;
  height: 60rpx;
  background: #ef4444;
  position: relative;
  opacity: 0.8;
}
.roof-p1 { width: 20rpx; height: 20rpx; margin-bottom: 50rpx; }
.roof-p2 { width: 30rpx; height: 30rpx; margin-bottom: 35rpx; }
.roof-p3 { width: 30rpx; height: 30rpx; margin-bottom: 35rpx; }
.roof-p4 { width: 20rpx; height: 20rpx; margin-bottom: 50rpx; }
.roof-main {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 180rpx;
  height: 60rpx;
  background: linear-gradient(180deg, #dc2626, #991b1b);
  border: 2px solid #7f1d1d;
  color: white;
}
.roof-title {
  font-size: 18rpx;
  font-weight: bold;
  letter-spacing: 2rpx;
  font-family: 'Courier New', monospace;
}

/* 房子主体 */
.house-body {
  position: relative;
  background: linear-gradient(135deg, #2d3748 0%, #1a202c 100%);
  border: 3px solid #1e293b;
  border-radius: 6rpx;
  box-shadow: inset 0 0 20rpx rgba(0,0,0,0.5);
}

/* 人物 */
.character {
  position: absolute;
  width: 32rpx;
  height: 48rpx;
  z-index: 10;
}
.char-body {
  width: 100%;
  height: 100%;
  position: relative;
  transition: all 0.3s ease;
}
.char-body.char-walking { animation: charWalk 0.6s steps(2) infinite; }
@keyframes charWalk {
  0%, 50%, 100% { transform: translateY(0); }
  25% { transform: translateY(-2rpx); }
  75% { transform: translateY(2rpx); }
}
.char-head {
  width: 14rpx;
  height: 14rpx;
  background: #fdbf6b;
  border-radius: 50%;
  margin: 0 auto;
  margin-bottom: 2rpx;
}
.char-torso {
  width: 18rpx;
  height: 14rpx;
  background: #ff6b6b;
  margin: 0 auto;
  margin-bottom: 2rpx;
}
.char-leg {
  width: 4rpx;
  height: 10rpx;
  position: absolute;
  bottom: 0;
  background: #364956;
}
.char-leg-l { left: 6rpx; }
.char-leg-r { right: 6rpx; }
.char-shadow {
  position: absolute;
  bottom: -3rpx;
  left: 4rpx;
  width: 24rpx;
  height: 3rpx;
  background: rgba(0,0,0,0.3);
  border-radius: 50%;
}

/* 小狗 */
.dog-character {
  position: absolute;
  width: 40rpx;
  height: 32rpx;
  z-index: 8;
}
.dog-body {
  position: relative;
  width: 100%;
  height: 100%;
  transition: all 0.3s ease;
}
.dog-body.dog-walking { animation: dogWalk 0.8s steps(2) infinite; }
@keyframes dogWalk {
  0%, 50%, 100% { transform: translateY(0); }
  25% { transform: translateY(-1rpx); }
  75% { transform: translateY(1rpx); }
}
.dog-head {
  width: 16rpx;
  height: 14rpx;
  background: #d4a574;
  border-radius: 40% 40% 50% 50%;
  position: absolute;
  left: 12rpx;
  top: 8rpx;
}
.dog-ear {
  width: 4rpx;
  height: 6rpx;
  background: #8b6f47;
  border-radius: 50%;
  position: absolute;
  top: 6rpx;
}
.dog-ear-l { left: 14rpx; }
.dog-ear-r { right: 14rpx; }
.dog-eye {
  width: 2rpx;
  height: 2rpx;
  background: #000;
  border-radius: 50%;
  position: absolute;
  top: 11rpx;
}
.dog-eye-l { left: 14rpx; }
.dog-eye-r { right: 12rpx; }
.dog-nose {
  width: 2rpx;
  height: 2rpx;
  background: #000;
  border-radius: 50%;
  position: absolute;
  top: 14rpx;
  left: 18rpx;
}
.dog-torso {
  width: 20rpx;
  height: 10rpx;
  background: #d4a574;
  border-radius: 50%;
  position: absolute;
  left: 10rpx;
  top: 18rpx;
}
.dog-tail {
  width: 12rpx;
  height: 6rpx;
  background: #d4a574;
  border-radius: 50% 50% 50% 0;
  position: absolute;
  right: 8rpx;
  top: 20rpx;
  animation: tailWag 0.6s ease-in-out infinite;
  transform-origin: right center;
}
@keyframes tailWag {
  0%, 100% { transform: rotate(0deg); }
  50% { transform: rotate(20deg); }
}
.dog-leg {
  width: 3rpx;
  height: 8rpx;
  background: #d4a574;
  position: absolute;
  bottom: 0;
}
.dog-leg-fl { left: 10rpx; }
.dog-leg-fr { left: 18rpx; }
.dog-leg-bl { right: 18rpx; }
.dog-leg-br { right: 10rpx; }
.dog-bubble {
  position: absolute;
  top: -24rpx;
  left: 50%;
  transform: translateX(-50%);
  background: white;
  border-radius: 12rpx;
  padding: 4rpx 8rpx;
  font-size: 16rpx;
  border: 1px solid #e5e7eb;
  opacity: 0;
  transition: opacity 0.3s;
  z-index: 20;
}
.dog-bubble.bubble-show { opacity: 1; }
.dog-bubble-text { display: block; }
.dog-shadow {
  position: absolute;
  bottom: -2rpx;
  left: 5rpx;
  width: 30rpx;
  height: 2rpx;
  background: rgba(0,0,0,0.3);
  border-radius: 50%;
}

/* 墙壁和门 */
.wall-north {
  display: flex;
  justify-content: space-around;
  align-items: center;
  height: 60rpx;
  background: linear-gradient(90deg, #2d3748, #1a202c);
  border-bottom: 2px solid #0f172a;
  margin-bottom: 0;
  padding: 0 20rpx;
}
.window-frame {
  display: flex;
  gap: 4rpx;
  width: 40rpx;
  height: 24rpx;
  border: 2px solid #4b5563;
  background: #1f2937;
}
.window-pane {
  flex: 1;
  background: #0ea5e9;
  opacity: 0.6;
}
.wall-gap { width: 50rpx; }
.wall-vert {
  width: 3px;
  background: #0f172a;
  display: flex;
  align-items: center;
  justify-content: center;
}
.door-opening-h {
  width: 50rpx;
  height: 120rpx;
  background: #1a202c;
  border: 1px solid #4b5563;
}
.door-frame-h {
  width: 100%;
  height: 100%;
  border: 1px solid #2d3748;
}
.wall-south {
  display: flex;
  justify-content: center;
  align-items: flex-start;
  height: 100rpx;
  background: linear-gradient(90deg, #2d3748, #1a202c);
  border-top: 2px solid #0f172a;
  gap: 40rpx;
  padding-top: 20rpx;
}
.wall-gap { width: 60rpx; }
.main-door-frame {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}
.door-topdown {
  width: 50rpx;
  height: 80rpx;
  background: #92400e;
  border: 2px solid #78350f;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}
.door-panel {
  width: 46rpx;
  height: 76rpx;
  background: #b45309;
  border: 1px solid #92400e;
}
.door-knob {
  width: 4rpx;
  height: 4rpx;
  background: #fbbf24;
  border-radius: 50%;
  position: absolute;
  right: 8rpx;
}
.main-door-label {
  font-size: 14rpx;
  color: #cbd5e1;
}

/* 房间 */
.floor-row {
  display: flex;
  gap: 0;
  min-height: 280rpx;
  margin-bottom: 0;
}
.floor-row:last-of-type {
  min-height: 300rpx;
}
.room {
  display: flex;
  flex-direction: column;
  position: relative;
}
.kitchen-room { flex: 4; }
.living-room { flex: 6; }
.bedroom { flex: 6; }
.bathroom { flex: 4; }

.room-label {
  padding: 8rpx;
  background: rgba(0,0,0,0.3);
  border-bottom: 2px solid #14b8a6;
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 16rpx;
  font-weight: bold;
  color: #f1f5f9;
}
.room-label-icon { font-size: 22rpx; }
.room-label-text { font-family: 'Courier New', monospace; }

.room-floor {
  flex: 1;
  position: relative;
  background: linear-gradient(135deg, #3f4a5e 0%, #2d3748 100%);
  border-right: 2px solid #0f172a;
}
.room-floor:last-child { border-right: none; }
.kitchen-floor { background: linear-gradient(135deg, #475569, #334155); }
.living-floor { background: linear-gradient(135deg, #3f4a5e, #2d3748); }
.bedroom-floor { background: linear-gradient(135deg, #3f4a5e, #475569); }
.bathroom-floor { background: linear-gradient(135deg, #475569, #334155); }

/* 走廊 */
.hallway {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 40rpx;
  background: #1a202c;
  border-top: 2px solid #0f172a;
  border-bottom: 2px solid #0f172a;
}
.hallway-floor {
  display: flex;
  gap: 4rpx;
  align-items: center;
}
.floor-tile {
  width: 32rpx;
  height: 16rpx;
  background: #2d3748;
  border: 1px solid #4b5563;
}

/* 家具 */
.furn-pos {
  position: absolute;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

/* 冰箱 */
.furn-fridge-pos { left: 8rpx; top: 8rpx; }
.topdown-fridge {
  width: 32rpx;
  height: 40rpx;
  background: #1e40af;
  border: 2px solid #1e3a8a;
  border-radius: 3rpx;
  position: relative;
  display: flex;
  flex-direction: column;
}
.fridge-top {
  flex: 1;
  background: #1e3a8a;
  border-bottom: 1px solid #1e40af;
}
.fridge-bottom {
  flex: 1;
  background: #1e40af;
}
.fridge-handle {
  width: 2rpx;
  height: 12rpx;
  background: #3b82f6;
  position: absolute;
  right: 4rpx;
  top: 6rpx;
}
.fridge-handle-b { top: 26rpx; }
.topdown-fridge.furn-active {
  box-shadow: 0 0 12rpx #fbbf24;
}
.furniture-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  background: #ef4444;
  color: white;
  border-radius: 50%;
  width: 24rpx;
  height: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12rpx;
  font-weight: bold;
}
.badge-num { color: white; }

/* 灶台 */
.furn-stove-pos { left: 50%; top: 8rpx; transform: translateX(-50%); }
.topdown-stove {
  width: 40rpx;
  height: 40rpx;
  background: #4b5563;
  border: 2px solid #2d3748;
  position: relative;
}
.stove-burner {
  width: 8rpx;
  height: 8rpx;
  background: #1f2937;
  border-radius: 50%;
  position: absolute;
  border: 1px solid #4b5563;
}
.stove-b1 { top: 6rpx; left: 6rpx; }
.stove-b2 { top: 6rpx; right: 6rpx; }
.stove-b3 { bottom: 6rpx; left: 6rpx; }
.stove-b4 { bottom: 6rpx; right: 6rpx; }
.stove-knobs {
  display: flex;
  justify-content: space-around;
  padding: 4rpx 0;
  position: absolute;
  bottom: 2rpx;
  width: 100%;
}
.stove-knob {
  width: 5rpx;
  height: 5rpx;
  background: #2d3748;
  border-radius: 50%;
  border: 1px solid #4b5563;
}
.stove-flame {
  position: absolute;
  top: 2rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 16rpx;
  animation: flameFlick 0.4s ease-in-out infinite;
}
@keyframes flameFlick {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.6; }
}
.topdown-stove.furn-active { box-shadow: 0 0 12rpx #fbbf24; }

/* 水槽 */
.furn-sink-pos { right: 8rpx; top: 8rpx; }
.topdown-sink {
  width: 32rpx;
  height: 28rpx;
  background: #64748b;
  border: 2px solid #475569;
  border-radius: 2rpx;
  position: relative;
}
.sink-basin {
  width: 24rpx;
  height: 16rpx;
  background: #475569;
  margin: 3rpx auto;
  border-radius: 2rpx;
}
.sink-drain {
  width: 3rpx;
  height: 3rpx;
  background: #1a202c;
  border-radius: 50%;
  position: absolute;
  bottom: 6rpx;
  left: 50%;
  transform: translateX(-50%);
}
.sink-faucet {
  width: 2rpx;
  height: 8rpx;
  background: #94a3b8;
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
}

/* 橱柜 */
.furn-cabinet-pos { left: 8rpx; bottom: 12rpx; }
.topdown-cabinet {
  width: 32rpx;
  height: 36rpx;
  background: #78350f;
  border: 2px solid #57251f;
  position: relative;
}
.cabinet-door {
  width: 14rpx;
  height: 32rpx;
  background: #92400e;
  border: 1px solid #78350f;
  position: absolute;
  top: 2rpx;
}
.cabinet-door:nth-child(1) { left: 2rpx; }
.cabinet-door:nth-child(2) { left: 18rpx; }
.cabinet-knob {
  width: 2rpx;
  height: 2rpx;
  background: #fbbf24;
  border-radius: 50%;
  position: absolute;
  top: 16rpx;
}
.c-k1 { left: 9rpx; }
.c-k2 { left: 23rpx; }

/* 电视 */
.furn-tv-pos { left: 8rpx; top: 8rpx; }
.topdown-tv {
  width: 50rpx;
  height: 40rpx;
  background: #1e293b;
  border: 3px solid #4b5563;
  border-radius: 4rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}
.tv-screen {
  width: 42rpx;
  height: 28rpx;
  background: #0f172a;
  border: 1px solid #0ea5e9;
  border-radius: 2rpx;
}
.tv-screen.tv-on {
  background: linear-gradient(45deg, #0ea5e9, #0284c7);
  animation: screenFlicker 0.2s ease-in-out infinite;
}
@keyframes screenFlicker {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.8; }
}
.tv-stand {
  width: 8rpx;
  height: 8rpx;
  background: #4b5563;
  position: absolute;
  bottom: -6rpx;
  left: 50%;
  transform: translateX(-50%);
}

/* 沙发 */
.furn-sofa-pos { left: 30%; top: 50%; transform: translateY(-50%); }
.topdown-sofa {
  width: 50rpx;
  height: 32rpx;
  background: #7c2d12;
  border: 2px solid #57251f;
  border-radius: 3rpx;
  position: relative;
}
.sofa-back {
  width: 100%;
  height: 8rpx;
  background: #92400e;
  border-bottom: 1px solid #7c2d12;
}
.sofa-seat {
  width: 100%;
  height: 12rpx;
  background: #b45309;
  margin: 0;
}
.sofa-arm {
  width: 6rpx;
  height: 20rpx;
  background: #92400e;
  position: absolute;
  bottom: 0;
}
.sofa-arm-l { left: 0; }
.sofa-arm-r { right: 0; }
.sofa-cushion {
  width: 8rpx;
  height: 8rpx;
  background: #dc2626;
  position: absolute;
  top: 10rpx;
}
.s-c1 { left: 6rpx; }
.s-c2 { left: 21rpx; }
.s-c3 { right: 6rpx; }

/* 茶几 */
.furn-table-pos { right: 8rpx; top: 50%; transform: translateY(-50%); }
.topdown-table {
  width: 38rpx;
  height: 28rpx;
  background: #92400e;
  border: 2px solid #78350f;
  border-radius: 2rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}
.table-top {
  width: 32rpx;
  height: 20rpx;
  background: #b45309;
  border: 1px solid #92400e;
}
.table-cup {
  width: 8rpx;
  height: 8rpx;
  background: #cbd5e1;
  border-radius: 1rpx;
  position: absolute;
  bottom: 6rpx;
  right: 4rpx;
  opacity: 0;
  transition: opacity 0.3s;
}
.table-cup.cup-has-tea { opacity: 1; background: #fed7aa; }

/* 盆栽 */
.furn-plant-pos { right: 8rpx; top: 8rpx; }
.topdown-plant {
  width: 32rpx;
  height: 38rpx;
  position: relative;
}
.plant-leaf {
  width: 4rpx;
  height: 12rpx;
  background: #22c55e;
  position: absolute;
  border-radius: 50% 50% 0 0;
}
.plant-l1 { left: 10rpx; top: 2rpx; }
.plant-l2 { left: 16rpx; top: 0; }
.plant-l3 { right: 16rpx; top: 0; }
.plant-l4 { right: 10rpx; top: 2rpx; }
.topdown-plant.plant-watered .plant-leaf { background: #16a34a; animation: leafGrow 1s ease-out; }
@keyframes leafGrow {
  0% { transform: scaleY(0.8); }
  100% { transform: scaleY(1.1); }
