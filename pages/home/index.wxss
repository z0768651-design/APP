/* 床 */
.furn-bed-pos { left: 8rpx; top: 8rpx; }
.topdown-bed {
  width: 60rpx;
  height: 40rpx;
  background: #6b21a8;
  border: 2px solid #581c87;
  border-radius: 3rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}
.bed-frame {
  width: 54rpx;
  height: 34rpx;
