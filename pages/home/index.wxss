/* =============================================================
   像素之家 - 温暖像素经营游戏风格
   参考: 星露谷物语 / 住宅梦物语 / 像素小店
   配色: 大地色系 + 金色点缀 + 木质边框
   ============================================================= */

/* ===== 页面容器 ===== */
.home-wrap {
  min-height: 100vh;
  background: #FFF8E7;
}
.home-wrap.light-bg {
  background: #FFF8E7;
  background-image:
    radial-gradient(circle at 20% 80%, rgba(255,179,0,0.04) 0%, transparent 50%),
    radial-gradient(circle at 80% 20%, rgba(76,175,80,0.03) 0%, transparent 50%);
}

/* ===== 顶部状态栏 - RPG风格 ===== */
.game-header {
  padding: 24rpx 20rpx 16rpx;
  background: linear-gradient(180deg, #4E342E 0%, #3E2723 100%);
  border-bottom: 6rpx solid #FFB300;
  position: relative;
}
/* 金色底边光效 */
.game-header::after {
  content: '';
  position: absolute;
  bottom: -6rpx; left: 0; right: 0;
  height: 3rpx;
  background: linear-gradient(90deg, transparent, #FFD54F, transparent);
}

.header-top-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}
.greeting-area {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.time-icon {
  font-size: 40rpx;
  filter: drop-shadow(0 2rpx 4rpx rgba(0,0,0,0.3));
  animation: iconBob 3s ease-in-out infinite;
}
@keyframes iconBob {
  0%,100% { transform: translateY(0); }
  50% { transform: translateY(-4rpx); }
}
.greeting-info { display: flex; flex-direction: column; gap: 2rpx; }
.greeting-main {
  font-size: 32rpx;
  color: #FFD54F;
  font-family: 'Courier New', monospace;
  font-weight: bold;
  text-shadow: 1rpx 1rpx 0 #3E2723;
}
.greeting-clock {
  font-size: 22rpx;
  color: #FFCC80;
  font-family: 'Courier New', monospace;
}

/* 等级和金币 */
.level-badge {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
}
.level-text {
  font-size: 28rpx;
  color: #FFD54F;
  font-weight: bold;
  font-family: 'Courier New', monospace;
  text-shadow: 2rpx 2rpx 0 #3E2723;
  background: linear-gradient(180deg, rgba(255,179,0,0.2), transparent);
  padding: 2rpx 12rpx;
  border: 2rpx solid #FFB300;
}
.coins-text {
  font-size: 20rpx;
  color: #FFB300;
  font-family: 'Courier New', monospace;
  font-weight: bold;
}

/* ===== RPG状态条 ===== */
.status-bars {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-bottom: 14rpx;
}
.stat-bar-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.stat-icon { font-size: 24rpx; }
.stat-bar-track {
  flex: 1;
  height: 22rpx;
  background: #3E2723;
  border: 3rpx solid #5D4037;
  position: relative;
  overflow: hidden;
  box-shadow: inset 0 2rpx 4rpx rgba(0,0,0,0.4);
}
.stat-bar-fill {
  height: 100%;
  position: relative;
  transition: width 0.5s ease;
}
.stat-bar-fill::after {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 40%;
  background: linear-gradient(180deg, rgba(255,255,255,0.35), transparent);
}
.energy-fill { background: linear-gradient(90deg, #FFB300, #FFC107); }
.mood-fill { background: linear-gradient(90deg, #EF5350, #FF8A80); }
.hunger-fill { background: linear-gradient(90deg, #FF9800, #FFB74D); }
.hygiene-fill { background: linear-gradient(90deg, #42A5F5, #64B5F6); }
.stat-val {
  font-size: 20rpx;
  color: #FFCC80;
  font-family: 'Courier New', monospace;
  font-weight: bold;
  min-width: 48rpx;
  text-align: right;
}

/* 食材概览条 */
.food-stats-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: rgba(255,179,0,0.1);
  border: 2rpx solid rgba(255,179,0,0.3);
  padding: 10rpx 16rpx;
}
.food-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
}
.food-stat-num {
  font-size: 28rpx;
  color: #FFD54F;
  font-family: 'Courier New', monospace;
  font-weight: bold;
}
.food-stat-lbl {
  font-size: 16rpx;
  color: #BCAAA4;
  font-family: 'Courier New', monospace;
}
.warn-c { color: #FFB300; }
.danger-c { color: #EF5350; }
.food-stat-div {
  width: 2rpx;
  height: 32rpx;
  background: rgba(255,255,255,0.15);
}
.food-stat-spacer { flex: 1; }
.alarm-indicator {
  display: flex;
  align-items: center;
  gap: 6rpx;
}
.alarm-icon { font-size: 20rpx; }
.alarm-time-txt {
  font-size: 18rpx;
  color: #FFD54F;
  font-family: 'Courier New', monospace;
}

/* ===== 房子容器 ===== */
.house-container {
  padding: 16rpx 12rpx 8rpx;
}

/* ===== 屋顶 - 温暖红棕色 ===== */
.house-roof {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 0 20rpx;
  position: relative;
}
.roof-pixel {
  width: 24rpx;
  height: 24rpx;
}
.roof-p1 { background: #8D6E63; margin-bottom: -4rpx; }
.roof-p2 { background: #A1887F; width: 20rpx; height: 20rpx; margin-bottom: -2rpx; }
.roof-p3 { background: #A1887F; width: 20rpx; height: 20rpx; margin-bottom: -2rpx; }
.roof-p4 { background: #8D6E63; margin-bottom: -4rpx; }
.roof-main {
  flex: 1;
  background: linear-gradient(180deg, #A1887F 0%, #8D6E63 40%, #795548 100%);
  border: 4rpx solid #5D4037;
  border-bottom: none;
  padding: 12rpx 0 8rpx;
  text-align: center;
  box-shadow: inset 0 3rpx 0 rgba(255,255,255,0.15);
}
.roof-title {
  font-size: 22rpx;
  color: #FFD54F;
  font-family: 'Courier New', monospace;
  font-weight: bold;
  letter-spacing: 4rpx;
  text-shadow: 1rpx 1rpx 0 #3E2723;
}

/* ===== 房子主体 ===== */
.house-body {
  border: 5rpx solid #5D4037;
  background: #D7CCC8;
  position: relative;
  box-shadow: 6rpx 6rpx 0 #8D6E63;
}

/* ===== 像素小人 ===== */
.character {
  position: absolute;
  z-index: 10;
  transition: left 0.6s ease, top 0.6s ease;
}
.char-body {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}
.char-head {
  width: 28rpx;
  height: 28rpx;
  background: #FFCC80;
  border: 3rpx solid #5D4037;
  border-radius: 4rpx;
  position: relative;
}
.char-torso {
  width: 24rpx;
  height: 20rpx;
  background: #42A5F5;
  border: 2rpx solid #1565C0;
  margin-top: -2rpx;
}
.char-leg {
  width: 10rpx;
  height: 14rpx;
  background: #5D4037;
  border: 2rpx solid #3E2723;
  position: absolute;
  bottom: -14rpx;
}
.char-leg-l { left: 2rpx; }
.char-leg-r { right: 2rpx; }
.char-walking .char-leg-l {
  animation: walkL 0.4s ease-in-out infinite alternate;
}
.char-walking .char-leg-r {
  animation: walkR 0.4s ease-in-out infinite alternate;
}
@keyframes walkL {
  0% { transform: translateY(0); }
  100% { transform: translateY(-4rpx); }
}
@keyframes walkR {
  0% { transform: translateY(-4rpx); }
  100% { transform: translateY(0); }
}
.char-shadow {
  width: 30rpx;
  height: 8rpx;
  background: rgba(62,39,35,0.2);
  border-radius: 50%;
  margin-top: 4rpx;
}
.char-dir-up .char-torso { background: #1E88E5; }
.char-dir-down .char-torso { background: #42A5F5; }
.char-dir-left .char-body { transform: scaleX(-1); }

/* ===== 小狗 ===== */
.dog-character {
  position: absolute;
  z-index: 9;
  transition: left 0.8s ease, top 0.8s ease;
}
.dog-body {
  position: relative;
  width: 36rpx;
  height: 30rpx;
}
.dog-head {
  width: 20rpx;
  height: 18rpx;
  background: #FFB74D;
  border: 2rpx solid #5D4037;
  position: absolute;
  top: 0;
  left: 8rpx;
  border-radius: 3rpx;
}
.dog-ear {
  width: 8rpx;
  height: 10rpx;
  background: #FF8F00;
  border: 2rpx solid #5D4037;
  position: absolute;
  top: -6rpx;
}
.dog-ear-l { left: 8rpx; }
.dog-ear-r { right: 8rpx; }
.dog-eye {
  width: 4rpx;
  height: 4rpx;
  background: #3E2723;
  position: absolute;
  top: 6rpx;
}
.dog-eye-l { left: 12rpx; }
.dog-eye-r { right: 12rpx; }
.dog-nose {
  width: 6rpx;
  height: 4rpx;
  background: #3E2723;
  position: absolute;
  top: 12rpx;
  left: 50%;
  transform: translateX(-50%);
}
.dog-torso {
  width: 30rpx;
  height: 16rpx;
  background: #FFB74D;
  border: 2rpx solid #5D4037;
  position: absolute;
  top: 14rpx;
  left: 3rpx;
}
.dog-tail {
  width: 10rpx;
  height: 6rpx;
  background: #FFB74D;
  border: 2rpx solid #5D4037;
  position: absolute;
  top: 12rpx;
  right: -8rpx;
  animation: wagTail 0.5s ease-in-out infinite alternate;
}
@keyframes wagTail {
  0% { transform: rotate(-15deg); }
  100% { transform: rotate(15deg); }
}
.dog-leg {
  width: 6rpx;
  height: 8rpx;
  background: #FF8F00;
  border: 2rpx solid #5D4037;
  position: absolute;
  bottom: -6rpx;
}
.dog-leg-fl { left: 4rpx; }
.dog-leg-fr { left: 14rpx; }
.dog-leg-bl { right: 10rpx; }
.dog-leg-br { right: 2rpx; }
.dog-dir-left .dog-body { transform: scaleX(-1); }
.dog-walking .dog-leg-fl { animation: walkL 0.3s infinite alternate; }
.dog-walking .dog-leg-br { animation: walkR 0.3s infinite alternate; }
.dog-state-happy .dog-tail { animation: wagTail 0.2s infinite alternate; }
.dog-state-eating .dog-head { animation: dogEat 0.3s infinite alternate; }
@keyframes dogEat {
  0% { transform: translateY(0); }
  100% { transform: translateY(3rpx); }
}
.dog-state-sleeping .dog-body { opacity: 0.7; }
.dog-state-playing .dog-body { animation: dogBounce 0.4s infinite; }
@keyframes dogBounce {
  0%,100% { transform: translateY(0); }
  50% { transform: translateY(-6rpx); }
}
.dog-bubble {
  position: absolute;
  top: -40rpx;
  left: 50%;
  transform: translateX(-50%) scale(0);
  background: #FFFDF5;
  border: 3rpx solid #5D4037;
  padding: 4rpx 10rpx;
  font-size: 18rpx;
  white-space: nowrap;
  opacity: 0;
  transition: all 0.3s;
  box-shadow: 2rpx 2rpx 0 #8D6E63;
}
.dog-bubble.bubble-show {
  transform: translateX(-50%) scale(1);
  opacity: 1;
}
.dog-bubble-text { font-size: 18rpx; }
.dog-shadow {
  width: 26rpx;
  height: 6rpx;
  background: rgba(62,39,35,0.15);
  border-radius: 50%;
  position: absolute;
  bottom: -8rpx;
  left: 5rpx;
}

/* ===== 北墙 ===== */
.wall-north {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 10rpx 20rpx;
  background: linear-gradient(180deg, #795548 0%, #8D6E63 100%);
  border-bottom: 4rpx solid #5D4037;
}
.window-frame {
  display: flex;
  gap: 3rpx;
  background: #5D4037;
  padding: 4rpx;
  border: 2rpx solid #3E2723;
}
.window-pane {
  width: 36rpx;
  height: 32rpx;
  background: linear-gradient(135deg, #90CAF9 0%, #64B5F6 50%, #42A5F5 100%);
  border: 1rpx solid #1E88E5;
}
.wall-gap { flex: 1; }

/* ===== 房间 ===== */
.floor-row {
  display: flex;
  min-height: 240rpx;
}
.room {
  position: relative;
  display: flex;
  flex-direction: column;
}
.kitchen-room { flex: 0 0 39%; }
.living-room { flex: 0 0 61%; }
.bedroom { flex: 0 0 60%; }
.bathroom { flex: 0 0 40%; }

/* 房间标签 */
.room-label {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 4rpx 10rpx;
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  z-index: 5;
  opacity: 0.8;
}
.room-label-icon { font-size: 16rpx; }
.room-label-text {
  font-size: 14rpx;
  color: #5D4037;
  font-family: 'Courier New', monospace;
  font-weight: bold;
}

/* 房间地板 */
.room-floor {
  flex: 1;
  position: relative;
  padding: 24rpx 8rpx 8rpx;
}
/* 厨房 - 赭石色瓷砖 */
.kitchen-floor {
  background:
    repeating-conic-gradient(#EFEBE9 0% 25%, #D7CCC8 0% 50%) 0 0 / 40rpx 40rpx;
}
/* 客厅 - 温暖木地板 */
.living-floor {
  background: repeating-linear-gradient(
    90deg,
    #D7CCC8 0, #D7CCC8 30rpx,
    #EFEBE9 30rpx, #EFEBE9 32rpx
  );
}
/* 卧室 - 柔软地毯 */
.bedroom-floor {
  background: #E8D5B7;
  background-image:
    repeating-linear-gradient(
      0deg,
      transparent 0, transparent 16rpx,
      rgba(93,64,55,0.05) 16rpx, rgba(93,64,55,0.05) 17rpx
    );
}
/* 卫生间 - 浅蓝白瓷砖 */
.bathroom-floor {
  background: repeating-conic-gradient(#E3F2FD 0% 25%, #BBDEFB 0% 50%) 0 0 / 36rpx 36rpx;
}

/* 隔墙 */
.wall-vert {
  width: 10rpx;
  background: linear-gradient(180deg, #795548, #5D4037);
  border-left: 2rpx solid #3E2723;
  border-right: 2rpx solid #3E2723;
  position: relative;
}
.door-opening-h {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 100%;
  height: 50rpx;
  background: #D7CCC8;
}
.door-frame-h {
  width: 100%;
  height: 100%;
  border-top: 3rpx solid #8D6E63;
  border-bottom: 3rpx solid #8D6E63;
}

/* 走廊 */
.hallway {
  height: 20rpx;
  border-top: 3rpx solid #5D4037;
  border-bottom: 3rpx solid #5D4037;
}
.hallway-floor {
  display: flex;
  height: 100%;
}
.floor-tile {
  flex: 1;
  background: #D7CCC8;
  border-right: 1rpx solid #BCAAA4;
}
.floor-tile:last-child { border-right: none; }

/* 南墙 + 大门 */
.wall-south {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 6rpx 20rpx;
  background: linear-gradient(180deg, #8D6E63, #795548);
  border-top: 4rpx solid #5D4037;
}
.main-door-frame {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
}
.door-topdown {
  position: relative;
  width: 44rpx;
  height: 28rpx;
}
.door-panel {
  width: 100%;
  height: 100%;
  background: linear-gradient(180deg, #A1887F, #8D6E63);
  border: 3rpx solid #5D4037;
}
.door-knob {
  position: absolute;
  right: 6rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 8rpx;
  height: 8rpx;
  background: #FFB300;
  border: 2rpx solid #5D4037;
  border-radius: 50%;
}
.main-door-label {
  font-size: 14rpx;
  color: #FFD54F;
  font-family: 'Courier New', monospace;
  font-weight: bold;
  text-shadow: 1rpx 1rpx 0 #3E2723;
}

/* ===== 家具通用 ===== */
.furn-pos {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
  position: relative;
}
.furn-label {
  font-size: 14rpx;
  color: #5D4037;
  font-family: 'Courier New', monospace;
  font-weight: bold;
  text-align: center;
}
.furn-active {
  animation: furnGlow 0.5s ease-in-out infinite alternate;
}
@keyframes furnGlow {
  0% { filter: drop-shadow(0 0 2rpx #FFB300); }
  100% { filter: drop-shadow(0 0 8rpx #FFD54F); }
}

/* 家具徽章 */
.furniture-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  background: #EF5350;
  border: 2rpx solid #B71C1C;
  min-width: 24rpx;
  height: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 3;
}
.badge-num {
  font-size: 14rpx;
  color: #fff;
  font-family: 'Courier New', monospace;
  font-weight: bold;
}

/* ===== 家具位置 ===== */
.furn-fridge-pos { margin-bottom: 8rpx; }
.furn-stove-pos { margin-bottom: 8rpx; }
.furn-sink-pos {}
.furn-cabinet-pos {}
.furn-tv-pos { margin-bottom: 8rpx; }
.furn-sofa-pos { margin-bottom: 8rpx; }
.furn-table-pos {}
.furn-plant-pos {}
.furn-bed-pos { margin-bottom: 8rpx; }
.furn-wardrobe-pos { margin-bottom: 8rpx; }
.furn-desk-pos {}
.furn-gf-pos {}
.furn-shower-pos { margin-bottom: 8rpx; }
.furn-toilet-pos { margin-bottom: 8rpx; }
.furn-basin-pos {}

/* ===== 冰箱 ===== */
.topdown-fridge {
  width: 48rpx;
  height: 56rpx;
  background: #FFFDF5;
  border: 3rpx solid #5D4037;
  position: relative;
  box-shadow: 2rpx 2rpx 0 #8D6E63;
}
.fridge-top {
  width: 100%;
  height: 45%;
  background: #E3F2FD;
  border-bottom: 2rpx solid #5D4037;
}
.fridge-bottom {
  width: 100%;
  height: 55%;
  background: #FFFDF5;
}
.fridge-handle {
  position: absolute;
  right: 4rpx;
  top: 8rpx;
  width: 4rpx;
  height: 12rpx;
  background: #FFB300;
  border: 1rpx solid #5D4037;
}
.fridge-handle-b { top: auto; bottom: 10rpx; }

/* ===== 灶台 ===== */
.topdown-stove {
  width: 52rpx;
  height: 44rpx;
  background: #424242;
  border: 3rpx solid #212121;
  position: relative;
  box-shadow: 2rpx 2rpx 0 #8D6E63;
}
.stove-burner {
  width: 14rpx;
  height: 14rpx;
  background: #616161;
  border: 2rpx solid #424242;
  border-radius: 50%;
  position: absolute;
}
.stove-b1 { top: 4rpx; left: 4rpx; }
.stove-b2 { top: 4rpx; right: 4rpx; }
.stove-b3 { bottom: 10rpx; left: 4rpx; }
.stove-b4 { bottom: 10rpx; right: 4rpx; }
.stove-knobs {
  position: absolute;
  bottom: 2rpx;
  left: 0; right: 0;
  display: flex;
  justify-content: center;
  gap: 4rpx;
}
.stove-knob {
  width: 6rpx;
  height: 6rpx;
  background: #FFB300;
  border: 1rpx solid #5D4037;
  border-radius: 50%;
}
.stove-flame {
  position: absolute;
  top: -8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 16rpx;
  height: 16rpx;
  background: #FF6D00;
  border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
  animation: flameFlicker 0.3s infinite alternate;
  box-shadow: 0 0 8rpx #FF6D00;
}
@keyframes flameFlicker {
  0% { transform: translateX(-50%) scale(1); opacity: 1; }
  100% { transform: translateX(-50%) scale(0.8); opacity: 0.8; }
}

/* ===== 水槽 ===== */
.topdown-sink {
  width: 42rpx;
  height: 36rpx;
  background: #E0E0E0;
  border: 3rpx solid #5D4037;
  position: relative;
  box-shadow: 2rpx 2rpx 0 #8D6E63;
}
.sink-basin {
  width: 28rpx;
  height: 20rpx;
  background: #BDBDBD;
  border: 2rpx solid #757575;
  position: absolute;
  bottom: 4rpx;
  left: 50%;
  transform: translateX(-50%);
}
.sink-drain {
  width: 6rpx;
  height: 6rpx;
  background: #424242;
  border-radius: 50%;
  position: absolute;
  bottom: 10rpx;
  left: 50%;
  transform: translateX(-50%);
}
.sink-faucet {
  width: 8rpx;
  height: 16rpx;
  background: #9E9E9E;
  border: 2rpx solid #616161;
  position: absolute;
  top: -4rpx;
  left: 50%;
  transform: translateX(-50%);
  border-radius: 2rpx 2rpx 0 0;
}

/* ===== 橱柜 ===== */
.topdown-cabinet {
