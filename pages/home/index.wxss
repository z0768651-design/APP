/* ===== 互动弹窗 ===== */
.action-modal {
  position: fixed;
  inset: 0;
  z-index: 500;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.2s ease;
}
.modal-show {
  opacity: 1;
  pointer-events: auto;
}
.modal-content {
  background: #1e293b;
  border: 3px solid #14b8a6;
  padding: 36rpx 32rpx;
  width: 520rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  box-shadow: 0 0 0 4px #0f172a, 0 0 20rpx rgba(20,184,166,0.3);
}
.modal-title {
  font-size: 32rpx;
  color: #f1f5f9;
  font-family: 'Courier New', monospace;
  font-weight: bold;
  text-align: center;
}
.modal-desc {
  font-size: 24rpx;
  color: #94a3b8;
  font-family: 'Courier New', monospace;
  text-align: center;
  line-height: 1.5;
}
.modal-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 12rpx;
  justify-content: center;
}
.modal-btn {
  padding: 14rpx 28rpx;
  border: 2px solid #475569;
  background: #334155;
  min-width: 140rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.modal-btn:active { background: #475569; }
.modal-btn-primary {
  border-color: #14b8a6;
  background: #0d9488;
}
.modal-btn-primary:active { background: #0f766e; }
.modal-btn-text {
  font-size: 24rpx;
  color: #f1f5f9;
  font-family: 'Courier New', monospace;
  font-weight: bold;
}

/* ===== 底部提示 ===== */
.home-footer {
  padding: 24rpx 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}
.footer-hint {
  font-size: 22rpx;
  color: #475569;
  font-family: 'Courier New', monospace;
  font-weight: bold;
  letter-spacing: 1rpx;
}
.footer-sub {
  font-size: 18rpx;
  color: #334155;
  font-family: 'Courier New', monospace;
  text-align: center;
}
