  border-radius: 8rpx;
  padding: 3rpx 6rpx;
  font-size: 12rpx;
  border: 1px solid #e5e7eb;
  opacity: 0;
  transition: opacity 0.3s;
  z-index: 20;
}
.gf-bubble.bubble-show { opacity: 1; }

/* 淋浴 */
.furn-shower-pos { left: 8rpx; top: 8rpx; }
.topdown-shower {
  width: 38rpx;
  height: 40rpx;
