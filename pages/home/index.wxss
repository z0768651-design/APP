}

/* ===== 天气卡片 ===== */
.weather-card {
  margin: 12rpx 20rpx;
  padding: 16rpx;
  background: linear-gradient(135deg, #0284c7, #06b6d4);
  border-radius: 8rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.2);
  color: white;
  opacity: 0;
  max-height: 0;
  overflow: hidden;
  transition: all 0.4s ease;
}
.weather-card.weather-show {
  opacity: 1;
  max-height: 200rpx;
}
.weather-close {
  position: absolute;
  right: 16rpx;
  top: 16rpx;
  font-size: 24rpx;
  cursor: pointer;
}
.weather-content {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.weather-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.weather-icon {
  font-size: 40rpx;
}
.weather-info {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}
.weather-city {
  font-size: 22rpx;
  font-weight: bold;
}
.weather-time {
  font-size: 14rpx;
  opacity: 0.9;
}
.weather-details {
  display: flex;
  gap: 24rpx;
}
.weather-temp {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}
.temp-val {
  font-size: 32rpx;
  font-weight: bold;
}
.temp-range {
  font-size: 12rpx;
  opacity: 0.8;
}
.weather-condition {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.condition-label {
  font-size: 18rpx;
  font-weight: bold;
}
.humidity {
  font-size: 12rpx;
  opacity: 0.8;
}
.weather-advice {
  padding: 8rpx 12rpx;
  background: rgba(255,255,255,0.1);
  border-radius: 4rpx;
  font-size: 14rpx;
  border-left: 3px solid rgba(255,255,255,0.3);
}

/* ===== 面板系统 ===== */
.panel-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0);
  z-index: 1000;
  pointer-events: none;
  transition: background 0.3s ease;
}
.panel-overlay.panel-show {
  background: rgba(0,0,0,0.5);
  pointer-events: auto;
}
.panel-box {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  max-height: 70vh;
  background: linear-gradient(180deg, #1e293b, #0f172a);
  border-radius: 20rpx 20rpx 0 0;
  border: 2px solid #14b8a6;
  display: flex;
  flex-direction: column;
  box-shadow: 0 -8rpx 24rpx rgba(0,0,0,0.5);
  overflow: hidden;
  animation: slideUp 0.3s ease;
}
@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.panel-header {
  padding: 16rpx 20rpx;
  border-bottom: 2px solid #14b8a6;
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
}
.panel-emoji {
  font-size: 32rpx;
}
.panel-title {
  font-size: 24rpx;
  color: #f1f5f9;
  font-weight: bold;
  font-family: 'Courier New', monospace;
}

.panel-tabs {
  display: flex;
  gap: 0;
  border-bottom: 1px solid rgba(20,184,166,0.3);
  padding: 0;
}
.tab-item {
  flex: 1;
  padding: 12rpx 16rpx;
  text-align: center;
  color: #94a3b8;
  background: rgba(0,0,0,0.2);
  border-bottom: 3px solid transparent;
  transition: all 0.3s ease;
}
.tab-item.tab-active {
  color: #14b8a6;
  border-bottom-color: #14b8a6;
  background: rgba(20,184,166,0.1);
}

.panel-body {
  flex: 1;
  padding: 16rpx 20rpx;
  overflow-y: auto;
  color: #cbd5e1;
  font-size: 16rpx;
}
.panel-body::-webkit-scrollbar {
  width: 4rpx;
}
.panel-body::-webkit-scrollbar-track {
  background: transparent;
}
.panel-body::-webkit-scrollbar-thumb {
  background: #14b8a6;
  border-radius: 2rpx;
}

.panel-desc {
  display: block;
  margin-bottom: 12rpx;
  line-height: 1.5;
  color: #94a3b8;
}

.panel-info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
  border-bottom: 1px solid rgba(20,184,166,0.1);
}
.panel-info-label {
  color: #94a3b8;
  font-size: 15rpx;
}
.panel-info-val {
  color: #f1f5f9;
  font-weight: bold;
  font-family: 'Courier New', monospace;
}

/* 菜谱列表 */
.recipe-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-top: 12rpx;
}
.recipe-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 10rpx 12rpx;
  background: rgba(20,184,166,0.1);
  border-radius: 6rpx;
  border: 1px solid rgba(20,184,166,0.3);
  transition: all 0.3s ease;
  position: relative;
}
.recipe-item:active {
  background: rgba(20,184,166,0.2);
  transform: scale(0.98);
}
.recipe-badge {
  position: absolute;
  top: -6rpx;
  right: 8rpx;
  background: #22c55e;
  color: white;
  padding: 2rpx 6rpx;
  border-radius: 3rpx;
  font-size: 12rpx;
  font-weight: bold;
}
.recipe-emoji {
  font-size: 28rpx;
  flex-shrink: 0;
}
.recipe-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}
.recipe-name {
  font-size: 16rpx;
  font-weight: bold;
  color: #f1f5f9;
}
.recipe-effect {
  font-size: 13rpx;
  color: #94a3b8;
}
.recipe-cost {
  color: #fbbf24;
  font-weight: bold;
