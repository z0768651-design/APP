  position: relative;
  box-shadow: 2rpx 2rpx 0 #8D6E63;
}
.cabinet-door {
  flex: 1;
  border-right: 2rpx solid #795548;
}
.cabinet-door:last-child { border-right: none; }
.cabinet-knob {
  width: 4rpx;
  height: 4rpx;
  background: #FFB300;
  border: 1rpx solid #5D4037;
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  border-radius: 50%;
}
.c-k1 { left: 8rpx; }
.c-k2 { left: 50%; transform: translate(-50%, -50%); }
.c-k3 { right: 8rpx; }

/* ===== 电视 ===== */
.topdown-tv {
  width: 56rpx;
  height: 40rpx;
  position: relative;
