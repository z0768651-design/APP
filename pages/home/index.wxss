}
@keyframes tvStatic {
  0%,100% { opacity: 1; }
  50% { opacity: 0.95; }
}
.tv-stand {
  width: 36rpx;
  height: 8rpx;
  background: #5D4037;
  margin: 0 auto;
  border: 1rpx solid #3E2723;
}

/* ===== 沙发 ===== */
.topdown-sofa {
  width: 68rpx;
  height: 36rpx;
  position: relative;
  box-shadow: 2rpx 2rpx 0 #8D6E63;
}
.sofa-back {
  width: 100%;
  height: 12rpx;
  background: #8D6E63;
  border: 2rpx solid #5D4037;
}
.sofa-seat {
  width: 100%;
  height: 24rpx;
  background: #A1887F;
  border: 2rpx solid #5D4037;
  border-top: none;
}
.sofa-arm {
  position: absolute;
  width: 10rpx;
  height: 100%;
  background: #795548;
  border: 2rpx solid #5D4037;
  top: 0;
}
.sofa-arm-l { left: -8rpx; }
.sofa-arm-r { right: -8rpx; }
.sofa-cushion {
  width: 16rpx;
  height: 12rpx;
  background: #BCAAA4;
  border: 1rpx solid #8D6E63;
  position: absolute;
  bottom: 4rpx;
}
.s-c1 { left: 6rpx; }
.s-c2 { left: 50%; transform: translateX(-50%); }
.s-c3 { right: 6rpx; }

/* ===== 茶几 ===== */
.topdown-table {
  width: 40rpx;
  height: 28rpx;
  position: relative;
  box-shadow: 2rpx 2rpx 0 #8D6E63;
}
.table-top {
  width: 100%;
  height: 100%;
  background: #A1887F;
  border: 3rpx solid #5D4037;
}
.table-cup {
  width: 12rpx;
  height: 12rpx;
  background: #FFFDF5;
  border: 2rpx solid #8D6E63;
  border-radius: 50%;
  position: absolute;
  top: 6rpx;
  right: 6rpx;
}
.cup-has-tea { background: #4CAF50; border-color: #2E7D32; }

/* ===== 盆栽 ===== */
.topdown-plant {
  width: 32rpx;
  height: 40rpx;
  position: relative;
}
.plant-leaf {
  width: 10rpx;
  height: 10rpx;
  background: #4CAF50;
  border: 2rpx solid #2E7D32;
  position: absolute;
  border-radius: 0 50% 0 50%;
}
.plant-l1 { top: 0; left: 12rpx; transform: rotate(-30deg); }
.plant-l2 { top: 4rpx; left: 4rpx; transform: rotate(-60deg); }
.plant-l3 { top: 4rpx; right: 4rpx; transform: rotate(30deg); }
.plant-l4 { top: 10rpx; left: 8rpx; transform: rotate(10deg); }
.plant-pot {
  width: 20rpx;
  height: 18rpx;
  background: #A1887F;
  border: 2rpx solid #5D4037;
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
}
.plant-watered .plant-leaf { background: #66BB6A; }

/* ===== 床 ===== */
.topdown-bed {
  width: 64rpx;
  height: 80rpx;
  position: relative;
  box-shadow: 2rpx 2rpx 0 #8D6E63;
}
.bed-frame {
  width: 100%;
  height: 100%;
  background: #A1887F;
  border: 3rpx solid #5D4037;
}
.bed-pillow {
  width: 24rpx;
  height: 16rpx;
  background: #FFFDF5;
  border: 2rpx solid #8D6E63;
  position: absolute;
  top: 6rpx;
}
.bed-p1 { left: 6rpx; }
.bed-p2 { right: 6rpx; }
.bed-blanket {
  position: absolute;
  bottom: 4rpx;
  left: 4rpx;
  right: 4rpx;
  height: 40rpx;
  background: #FFB74D;
  border: 2rpx solid #F57C00;
}
.bed-sleeping .bed-blanket { background: #64B5F6; border-color: #42A5F5; }
.sleep-zzz {
  position: absolute;
  top: -20rpx;
  right: -10rpx;
  animation: zzzFloat 1.5s infinite;
}
@keyframes zzzFloat {
  0% { transform: translateY(0); opacity: 1; }
  100% { transform: translateY(-16rpx); opacity: 0; }
}
.zzz-text { font-size: 20rpx; }

/* ===== 衣柜 ===== */
.topdown-wardrobe {
  width: 44rpx;
  height: 52rpx;
  background: #8D6E63;
  border: 3rpx solid #5D4037;
  display: flex;
  position: relative;
  box-shadow: 2rpx 2rpx 0 #8D6E63;
}
.wardrobe-door {
  flex: 1;
}
.wd-l { border-right: 2rpx solid #5D4037; background: #A1887F; }
.wd-r { background: #8D6E63; }
.wardrobe-knob {
  width: 6rpx;
  height: 6rpx;
  background: #FFB300;
  border: 1rpx solid #5D4037;
  border-radius: 50%;
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
}
.wk-l { left: 14rpx; }
.wk-r { right: 14rpx; }
.wardrobe-mirror {
  position: absolute;
  top: 6rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 16rpx;
  height: 20rpx;
  background: #90CAF9;
  border: 2rpx solid #5D4037;
}

/* ===== 书桌 ===== */
.topdown-desk {
  width: 52rpx;
  height: 36rpx;
  position: relative;
  box-shadow: 2rpx 2rpx 0 #8D6E63;
}
.desk-surface {
  width: 100%;
  height: 28rpx;
  background: #A1887F;
  border: 3rpx solid #5D4037;
}
.desk-lamp {
  width: 8rpx;
  height: 12rpx;
  background: #9E9E9E;
  border: 1rpx solid #616161;
  position: absolute;
  top: 2rpx;
  right: 6rpx;
}
.lamp-on {
  background: #FFD54F;
  box-shadow: 0 0 10rpx rgba(255,213,79,0.6);
}
.desk-book {
  width: 14rpx;
  height: 10rpx;
  background: #42A5F5;
  border: 1rpx solid #1E88E5;
  position: absolute;
  top: 8rpx;
  left: 6rpx;
}
.desk-chair {
  width: 20rpx;
  height: 14rpx;
  background: #795548;
  border: 2rpx solid #5D4037;
  position: absolute;
  bottom: -4rpx;
  left: 50%;
  transform: translateX(-50%);
}

/* ===== 女友沙发 + 角色 ===== */
.topdown-gf-sofa {
  width: 40rpx;
  height: 28rpx;
  box-shadow: 2rpx 2rpx 0 #8D6E63;
}
.gf-sofa-back {
  width: 100%;
  height: 10rpx;
  background: #CE93D8;
  border: 2rpx solid #AB47BC;
}
.gf-sofa-seat {
  width: 100%;
  height: 18rpx;
  background: #E1BEE7;
  border: 2rpx solid #AB47BC;
  border-top: none;
}
.gf-char {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: -16rpx;
}
.gf-hair {
  width: 22rpx;
  height: 10rpx;
  background: #5D4037;
  border: 2rpx solid #3E2723;
  border-radius: 6rpx 6rpx 0 0;
}
.gf-head {
  width: 20rpx;
  height: 18rpx;
  background: #FFCC80;
  border: 2rpx solid #5D4037;
  margin-top: -2rpx;
}
.gf-body {
  width: 18rpx;
  height: 16rpx;
  background: #EF9A9A;
  border: 2rpx solid #EF5350;
  margin-top: -2rpx;
}
.gf-active .gf-body {
  animation: gfBounce 0.5s ease-in-out infinite;
}
@keyframes gfBounce {
  0%,100% { transform: translateY(0); }
  50% { transform: translateY(-3rpx); }
}
.gf-bubble {
  position: absolute;
  top: -36rpx;
  left: 50%;
  transform: translateX(-50%) scale(0);
  background: #FCE4EC;
  border: 3rpx solid #EF5350;
  padding: 4rpx 10rpx;
  font-size: 16rpx;
  opacity: 0;
  transition: all 0.3s;
  box-shadow: 2rpx 2rpx 0 #8D6E63;
  white-space: nowrap;
}
.gf-bubble.bubble-show {
  transform: translateX(-50%) scale(1);
  opacity: 1;
}

/* ===== 淋浴 ===== */
.topdown-shower {
  width: 44rpx;
  height: 48rpx;
  background: #E3F2FD;
  border: 3rpx solid #42A5F5;
  position: relative;
  box-shadow: 2rpx 2rpx 0 #8D6E63;
}
.shower-base {
  width: 32rpx;
  height: 32rpx;
  background: #BBDEFB;
  border: 2rpx solid #64B5F6;
  position: absolute;
  bottom: 4rpx;
  left: 50%;
  transform: translateX(-50%);
}
.shower-head {
  width: 16rpx;
  height: 6rpx;
  background: #9E9E9E;
  border: 2rpx solid #616161;
  position: absolute;
  top: 4rpx;
  left: 50%;
  transform: translateX(-50%);
}
.shower-water {
  width: 2rpx;
  height: 0;
  background: #42A5F5;
  position: absolute;
  top: 12rpx;
}
.shower-active .shower-water {
  height: 24rpx;
  animation: waterDrip 0.5s infinite;
}
@keyframes waterDrip {
  0% { opacity: 1; }
  100% { opacity: 0.3; }
}
.w1 { left: 12rpx; animation-delay: 0s; }
.w2 { left: 20rpx; animation-delay: 0.15s; }
.w3 { left: 28rpx; animation-delay: 0.3s; }
.shower-drain {
  width: 8rpx;
  height: 8rpx;
  background: #757575;
  border-radius: 50%;
  position: absolute;
  bottom: 10rpx;
  left: 50%;
  transform: translateX(-50%);
}

/* ===== 马桶 ===== */
.topdown-toilet {
  width: 32rpx;
  height: 44rpx;
  position: relative;
  box-shadow: 2rpx 2rpx 0 #8D6E63;
}
.toilet-tank {
  width: 24rpx;
  height: 14rpx;
  background: #FFFDF5;
  border: 3rpx solid #BDBDBD;
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
}
.toilet-seat {
  width: 28rpx;
  height: 24rpx;
  background: #FFFDF5;
  border: 3rpx solid #BDBDBD;
  border-radius: 0 0 10rpx 10rpx;
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
}
.toilet-lid {
  width: 22rpx;
  height: 16rpx;
  background: #F5F5F5;
  border: 2rpx solid #E0E0E0;
  border-radius: 0 0 8rpx 8rpx;
  position: absolute;
  bottom: 4rpx;
  left: 50%;
  transform: translateX(-50%);
}
.toilet-hole {
  width: 12rpx;
  height: 8rpx;
  background: #90CAF9;
  border-radius: 50%;
  position: absolute;
  bottom: 8rpx;
  left: 50%;
  transform: translateX(-50%);
}

/* ===== 洗手台 ===== */
.topdown-basin {
  width: 40rpx;
  height: 32rpx;
  position: relative;
  box-shadow: 2rpx 2rpx 0 #8D6E63;
}
.basin-counter {
  width: 100%;
  height: 100%;
  background: #FFFDF5;
  border: 3rpx solid #BDBDBD;
}
.basin-bowl {
  width: 20rpx;
  height: 14rpx;
  background: #E3F2FD;
  border: 2rpx solid #90CAF9;
  border-radius: 0 0 50% 50%;
  position: absolute;
  bottom: 6rpx;
  left: 50%;
  transform: translateX(-50%);
}
.basin-faucet {
  width: 6rpx;
  height: 10rpx;
  background: #9E9E9E;
  border: 1rpx solid #616161;
  position: absolute;
  top: 2rpx;
  left: 50%;
  transform: translateX(-50%);
}
.basin-mirror {
  width: 20rpx;
  height: 4rpx;
  background: #90CAF9;
  border: 1rpx solid #64B5F6;
  position: absolute;
  top: -6rpx;
  left: 50%;
  transform: translateX(-50%);
}

/* ===== 天气卡片 - 卷轴风 ===== */
.weather-card {
  position: fixed;
  top: 160rpx;
  left: 50%;
  transform: translateX(-50%) scale(0.8);
  width: 600rpx;
  background: linear-gradient(180deg, #FFFEF9 0%, #FFF8E7 100%);
  border: 5rpx solid #5D4037;
  box-shadow: 8rpx 8rpx 0 rgba(93,64,55,0.5);
  z-index: 50;
  opacity: 0;
  pointer-events: none;
  transition: all 0.3s;
  padding: 24rpx;
}
.weather-card.weather-show {
  opacity: 1;
  pointer-events: all;
  transform: translateX(-50%) scale(1);
}
.weather-close {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  background: #EF5350;
  border: 3rpx solid #B71C1C;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: bold;
}
.weather-content {}
.weather-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
.weather-icon { font-size: 56rpx; }
.weather-info { flex: 1; }
.weather-city {
  display: block;
  font-size: 28rpx;
  color: #3E2723;
  font-weight: bold;
  font-family: 'Courier New', monospace;
}
.weather-time {
  display: block;
  font-size: 18rpx;
  color: #8D6E63;
  font-family: 'Courier New', monospace;
}
.weather-details {
  display: flex;
  justify-content: space-between;
  padding: 16rpx;
  background: #FFF8E1;
  border: 3rpx solid #8D6E63;
  margin-bottom: 12rpx;
}
.weather-temp {}
.temp-val {
  font-size: 48rpx;
  color: #FFB300;
  font-family: 'Courier New', monospace;
  font-weight: bold;
  text-shadow: 2rpx 2rpx 0 #8D6E63;
}
.temp-range {
  display: block;
  font-size: 18rpx;
  color: #8D6E63;
  font-family: 'Courier New', monospace;
}
.weather-condition { text-align: right; }
.condition-label {
  display: block;
  font-size: 26rpx;
  color: #3E2723;
  font-weight: bold;
  font-family: 'Courier New', monospace;
}
.humidity {
  display: block;
  font-size: 18rpx;
  color: #42A5F5;
  font-family: 'Courier New', monospace;
}
.weather-advice {
  font-size: 22rpx;
  color: #5D4037;
  font-family: 'Courier New', monospace;
  padding: 10rpx 16rpx;
  background: rgba(255,179,0,0.1);
  border-left: 4rpx solid #FFB300;
}

/* ===== 面板弹窗系统 - 游戏对话框 ===== */
.panel-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(62,39,35,0.7);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s;
}
.panel-overlay.panel-show {
  opacity: 1;
  pointer-events: all;
}

.panel-box {
  width: 640rpx;
  max-height: 80vh;
  overflow-y: auto;
  background: linear-gradient(180deg, #FFFEF9 0%, #FFF8E7 100%);
  border: 6rpx solid #5D4037;
  box-shadow: 10rpx 10rpx 0 rgba(93,64,55,0.5);
  position: relative;
}
/* 四角金色装饰 */
.panel-box::before {
  content: '';
  position: absolute;
  top: -6rpx; left: -6rpx;
  width: 20rpx; height: 20rpx;
  background: #FFB300;
  border: 3rpx solid #5D4037;
  z-index: 2;
}
.panel-box::after {
  content: '';
  position: absolute;
  top: -6rpx; right: -6rpx;
  width: 20rpx; height: 20rpx;
  background: #FFB300;
  border: 3rpx solid #5D4037;
  z-index: 2;
}

/* 面板头部 - 木质标题栏 */
.panel-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 18rpx 24rpx;
  background: linear-gradient(180deg, #795548 0%, #5D4037 100%);
  border-bottom: 4rpx solid #3E2723;
}
.panel-emoji { font-size: 36rpx; filter: drop-shadow(0 2rpx 2rpx rgba(0,0,0,0.3)); }
.panel-title {
  font-size: 30rpx;
  color: #FFD54F;
  font-family: 'Courier New', monospace;
  font-weight: bold;
  text-shadow: 1rpx 1rpx 0 #3E2723;
  flex: 1;
}

/* 各面板头部颜色变化 */
.fridge-panel-header { background: linear-gradient(180deg, #42A5F5, #1E88E5); border-color: #0D47A1; }
.cook-panel-header { background: linear-gradient(180deg, #FF8A65, #F4511E); border-color: #BF360C; }
.sink-panel-header { background: linear-gradient(180deg, #64B5F6, #42A5F5); border-color: #1565C0; }
.cabinet-panel-header { background: linear-gradient(180deg, #A1887F, #795548); border-color: #3E2723; }
.tv-panel-header { background: linear-gradient(180deg, #78909C, #546E7A); border-color: #263238; }
.sofa-panel-header { background: linear-gradient(180deg, #A1887F, #8D6E63); border-color: #5D4037; }
.table-panel-header { background: linear-gradient(180deg, #8D6E63, #795548); border-color: #4E342E; }
.plant-panel-header { background: linear-gradient(180deg, #66BB6A, #43A047); border-color: #1B5E20; }
.bed-panel-header { background: linear-gradient(180deg, #7986CB, #5C6BC0); border-color: #283593; }
.wardrobe-panel-header { background: linear-gradient(180deg, #A1887F, #795548); border-color: #3E2723; }
.desk-panel-header { background: linear-gradient(180deg, #FFB74D, #FF9800); border-color: #E65100; }
.shower-panel-header { background: linear-gradient(180deg, #4FC3F7, #29B6F6); border-color: #0277BD; }
.toilet-panel-header { background: linear-gradient(180deg, #90A4AE, #78909C); border-color: #37474F; }
.basin-panel-header { background: linear-gradient(180deg, #80DEEA, #4DD0E1); border-color: #006064; }
.door-panel-header { background: linear-gradient(180deg, #A1887F, #6D4C41); border-color: #3E2723; }
.dog-panel-header { background: linear-gradient(180deg, #FFB74D, #FF9800); border-color: #E65100; }
.gf-panel-header { background: linear-gradient(180deg, #F48FB1, #EC407A); border-color: #880E4F; }

/* 面板内容 */
.panel-body {
  padding: 20rpx 24rpx;
}
.panel-desc {
  font-size: 24rpx;
  color: #5D4037;
  font-family: 'Courier New', monospace;
  line-height: 1.6;
}
.panel-info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
  border-bottom: 2rpx solid #F5E6CC;
}
.panel-info-row:last-child { border-bottom: none; }
.panel-info-label {
  font-size: 24rpx;
  color: #8D6E63;
  font-family: 'Courier New', monospace;
}
.panel-info-val {
  font-size: 24rpx;
  color: #3E2723;
  font-family: 'Courier New', monospace;
  font-weight: bold;
}
.panel-divider {
  height: 4rpx;
  background: repeating-linear-gradient(90deg, #8D6E63 0, #8D6E63 12rpx, transparent 12rpx, transparent 24rpx);
  margin: 16rpx 0;
}

/* 面板按钮区 */
.panel-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 16rpx 24rpx 24rpx;
  border-top: 3rpx solid #F5E6CC;
}
.dog-actions { flex-wrap: wrap; }
.panel-btn {
  flex: 1;
  min-width: 200rpx;
  padding: 16rpx 20rpx;
  background: #FFFDF5;
  border: 4rpx solid #8D6E63;
  box-shadow: 4rpx 4rpx 0 #D7CCC8;
  text-align: center;
  transition: transform 0.08s, box-shadow 0.08s;
}
.panel-btn:active {
  transform: translate(2rpx, 2rpx);
  box-shadow: 2rpx 2rpx 0 #D7CCC8;
}
.panel-btn-primary {
  background: linear-gradient(180deg, #FFD54F 0%, #FFB300 100%);
  border-color: #5D4037;
  box-shadow: 4rpx 4rpx 0 #5D4037;
}
.panel-btn-primary:active {
  box-shadow: 2rpx 2rpx 0 #5D4037;
}
.panel-btn-text {
  font-size: 24rpx;
  color: #3E2723;
  font-family: 'Courier New', monospace;
  font-weight: bold;
}
.panel-btn-primary .panel-btn-text {
  text-shadow: 1rpx 1rpx 0 rgba(255,255,255,0.3);
}

/* ===== 进度条 ===== */
.cooking-progress-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 16rpx 0;
}
.cooking-name {
  font-size: 24rpx;
  color: #3E2723;
  font-family: 'Courier New', monospace;
  font-weight: bold;
}
.progress-track {
  width: 100%;
  height: 28rpx;
  background: #3E2723;
  border: 3rpx solid #5D4037;
  overflow: hidden;
  box-shadow: inset 0 2rpx 4rpx rgba(0,0,0,0.4);
}
.progress-fill {
  height: 100%;
  position: relative;
  transition: width 0.3s;
}
.progress-fill::after {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 40%;
  background: linear-gradient(180deg, rgba(255,255,255,0.35), transparent);
}
.cook-progress-fill { background: linear-gradient(90deg, #FF8A65, #FF5722); }
.study-progress-fill { background: linear-gradient(90deg, #AB47BC, #CE93D8); }
.shower-progress-fill { background: linear-gradient(90deg, #42A5F5, #64B5F6); }
.cooking-pct {
  font-size: 22rpx;
  color: #FFB300;
  font-family: 'Courier New', monospace;
  font-weight: bold;
}

/* ===== 菜谱列表 ===== */
.recipe-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-top: 12rpx;
}
.recipe-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 16rpx;
  background: #FFF8E1;
  border: 3rpx solid #8D6E63;
  box-shadow: 3rpx 3rpx 0 #D7CCC8;
  position: relative;
  transition: transform 0.08s, box-shadow 0.08s;
}
.recipe-item:active {
  transform: translate(2rpx, 2rpx);
  box-shadow: 1rpx 1rpx 0 #D7CCC8;
}
.recipe-badge {
  position: absolute;
  top: -6rpx;
  right: -4rpx;
  background: #4CAF50;
  border: 2rpx solid #2E7D32;
  color: #fff;
  font-size: 14rpx;
  font-family: 'Courier New', monospace;
  font-weight: bold;
  padding: 2rpx 8rpx;
}
.recipe-emoji { font-size: 36rpx; }
.recipe-info { flex: 1; }
.recipe-name {
  display: block;
  font-size: 24rpx;
  color: #3E2723;
  font-family: 'Courier New', monospace;
  font-weight: bold;
}
.recipe-effect {
  display: block;
  font-size: 18rpx;
  color: #4CAF50;
  font-family: 'Courier New', monospace;
}
.recipe-cost {
  font-size: 22rpx;
  color: #FFB300;
  font-family: 'Courier New', monospace;
  font-weight: bold;
}

/* 菜谱步骤 */
.recipe-steps-view { padding: 8rpx 0; }
.recipe-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.recipe-title {
  font-size: 28rpx;
  color: #3E2723;
  font-weight: bold;
  font-family: 'Courier New', monospace;
}
.recipe-diff {
  font-size: 18rpx;
  color: #FFB300;
  background: #FFF8E1;
  border: 2rpx solid #FFB300;
  padding: 2rpx 10rpx;
  font-family: 'Courier New', monospace;
  font-weight: bold;
}
.recipe-steps-list {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.step-item {
  display: flex;
  gap: 10rpx;
  padding: 8rpx 0;
  border-bottom: 1rpx solid #F5E6CC;
}
.step-num {
  width: 36rpx;
  height: 36rpx;
  background: linear-gradient(180deg, #FFD54F, #FFB300);
  border: 2rpx solid #5D4037;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: #3E2723;
  font-family: 'Courier New', monospace;
  font-weight: bold;
  flex-shrink: 0;
}
.step-text {
  font-size: 22rpx;
  color: #5D4037;
  font-family: 'Courier New', monospace;
  line-height: 1.5;
}

/* ===== 加载/新闻 ===== */
.loading-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 30rpx 0;
}
.loading-spinner {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid #D7CCC8;
  border-top-color: #FFB300;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.loading-text {
  font-size: 22rpx;
  color: #8D6E63;
  font-family: 'Courier New', monospace;
}

.news-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.news-item {
  display: flex;
  gap: 12rpx;
  padding: 12rpx;
  background: #FFF8E1;
  border: 2rpx solid #8D6E63;
  box-shadow: 2rpx 2rpx 0 #D7CCC8;
}
.news-num {
  width: 32rpx;
  height: 32rpx;
  background: linear-gradient(180deg, #FFD54F, #FFB300);
  border: 2rpx solid #5D4037;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
  color: #3E2723;
  font-family: 'Courier New', monospace;
  font-weight: bold;
  flex-shrink: 0;
}
.news-content { flex: 1; }
.news-title {
  display: block;
  font-size: 22rpx;
  color: #3E2723;
  font-family: 'Courier New', monospace;
  font-weight: bold;
  line-height: 1.4;
}
.news-meta {
  display: block;
  font-size: 16rpx;
  color: #8D6E63;
  font-family: 'Courier New', monospace;
  margin-top: 4rpx;
}

/* ===== 小狗属性 ===== */
.dog-stats {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-bottom: 12rpx;
}

/* ===== 面板标签页 ===== */
.panel-tabs {
  display: flex;
  border-bottom: 3rpx solid #5D4037;
}
.tab-item {
  flex: 1;
  padding: 14rpx 0;
  text-align: center;
  background: #EFEBE9;
  font-size: 22rpx;
  color: #5D4037;
  font-family: 'Courier New', monospace;
  font-weight: bold;
  border-right: 2rpx solid #D7CCC8;
}
.tab-item:last-child { border-right: none; }
.tab-item.tab-active {
  background: #FFD54F;
  color: #3E2723;
}

/* ===== 语言学习卡 ===== */
.lang-card-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
}
.lang-card {
  width: 400rpx;
  height: 240rpx;
  perspective: 1000rpx;
  position: relative;
}
.lang-card-front, .lang-card-back {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  backface-visibility: hidden;
  transition: transform 0.5s;
  border: 4rpx solid #5D4037;
  box-shadow: 4rpx 4rpx 0 #8D6E63;
}
.lang-card-front {
  background: linear-gradient(180deg, #FFF8E1 0%, #FFD54F 100%);
  transform: rotateY(0deg);
}
.lang-card-back {
  background: linear-gradient(180deg, #E8EAF6 0%, #C5CAE9 100%);
  transform: rotateY(180deg);
}
.lang-card.flipped .lang-card-front { transform: rotateY(-180deg); }
.lang-card.flipped .lang-card-back { transform: rotateY(0deg); }
.card-icon { font-size: 56rpx; margin-bottom: 8rpx; }
.card-zh {
  font-size: 32rpx;
  color: #3E2723;
  font-family: 'Courier New', monospace;
  font-weight: bold;
}
.card-en {
  font-size: 36rpx;
  color: #3E2723;
  font-family: 'Courier New', monospace;
  font-weight: bold;
  text-shadow: 1rpx 1rpx 0 #9FA8DA;
}
.card-phonetic {
  font-size: 22rpx;
  color: #5C6BC0;
  font-family: 'Courier New', monospace;
  margin-top: 8rpx;
}
.lang-card-nav {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.nav-btn {
  width: 56rpx;
  height: 56rpx;
  background: linear-gradient(180deg, #FFD54F, #FFB300);
  border: 3rpx solid #5D4037;
  box-shadow: 3rpx 3rpx 0 #5D4037;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #3E2723;
  font-weight: bold;
}
.nav-btn:active {
  transform: translate(2rpx, 2rpx);
  box-shadow: 1rpx 1rpx 0 #5D4037;
}
.card-counter {
  font-size: 22rpx;
  color: #5D4037;
  font-family: 'Courier New', monospace;
  font-weight: bold;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 30rpx 0;
}
.empty-icon { font-size: 56rpx; }
.empty-text {
  font-size: 22rpx;
  color: #8D6E63;
  font-family: 'Courier New', monospace;
  text-align: center;
}

/* ===== 闹钟 ===== */
.sleeping-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
}
.sleep-emoji { font-size: 56rpx; }
.sleep-text {
  font-size: 26rpx;
  color: #5C6BC0;
  font-family: 'Courier New', monospace;
  font-weight: bold;
}
.alarm-section {
  padding: 8rpx 0;
}
.alarm-section-title {
  display: block;
  font-size: 24rpx;
  color: #3E2723;
  font-family: 'Courier New', monospace;
  font-weight: bold;
  margin-bottom: 12rpx;
}
.alarm-picker-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-wrap: wrap;
}
.alarm-picker-box {
  background: #FFF8E1;
  border: 3rpx solid #8D6E63;
  padding: 8rpx 20rpx;
  box-shadow: 2rpx 2rpx 0 #D7CCC8;
}
.alarm-picker-val {
  font-size: 32rpx;
  color: #3E2723;
  font-family: 'Courier New', monospace;
  font-weight: bold;
}
.alarm-colon {
  font-size: 32rpx;
  color: #3E2723;
  font-weight: bold;
}
.alarm-set-btn {
  background: linear-gradient(180deg, #FFD54F, #FFB300);
  border: 3rpx solid #5D4037;
  padding: 8rpx 20rpx;
  box-shadow: 3rpx 3rpx 0 #5D4037;
}
.alarm-set-btn:active {
  transform: translate(2rpx, 2rpx);
  box-shadow: 1rpx 1rpx 0 #5D4037;
}
.alarm-set-text {
  font-size: 22rpx;
  color: #3E2723;
  font-family: 'Courier New', monospace;
  font-weight: bold;
}
.alarm-cancel-btn {
  background: #FFEBEE;
  border: 3rpx solid #EF5350;
  padding: 8rpx 16rpx;
}
.alarm-cancel-text {
  font-size: 20rpx;
  color: #EF5350;
  font-family: 'Courier New', monospace;
  font-weight: bold;
}
.alarm-status {
  display: block;
  font-size: 20rpx;
  color: #FFB300;
  font-family: 'Courier New', monospace;
  font-weight: bold;
  margin-top: 12rpx;
}

/* ===== 女朋友面板 ===== */
.gf-mood-bar {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 16rpx;
}
.gf-mood-label {
  font-size: 22rpx;
  color: #5D4037;
  font-family: 'Courier New', monospace;
  font-weight: bold;
  min-width: 80rpx;
}
.gf-mood-val {
  font-size: 20rpx;
  color: #EC407A;
  font-family: 'Courier New', monospace;
  font-weight: bold;
  min-width: 48rpx;
}
.gf-tone-select {
  margin-bottom: 16rpx;
}
.tone-label {
  font-size: 20rpx;
  color: #8D6E63;
  font-family: 'Courier New', monospace;
  margin-bottom: 8rpx;
}
.tone-buttons {
  display: flex;
  gap: 10rpx;
}
.tone-btn {
  flex: 1;
  padding: 10rpx;
  background: #FFF8E1;
  border: 3rpx solid #8D6E63;
  text-align: center;
  font-size: 20rpx;
  font-family: 'Courier New', monospace;
  box-shadow: 2rpx 2rpx 0 #D7CCC8;
}
.tone-btn:active {
  transform: translate(1rpx, 1rpx);
  box-shadow: 1rpx 1rpx 0 #D7CCC8;
}
.tone-btn.tone-active {
  background: linear-gradient(180deg, #F48FB1, #EC407A);
  border-color: #880E4F;
  color: #fff;
  box-shadow: 2rpx 2rpx 0 #880E4F;
}
.gf-response-box {
  background: #FCE4EC;
  border: 3rpx solid #F48FB1;
  padding: 16rpx;
  margin-bottom: 12rpx;
  min-height: 60rpx;
  box-shadow: inset 0 2rpx 4rpx rgba(236,64,122,0.1);
}
.gf-response-text {
  font-size: 24rpx;
  color: #880E4F;
  font-family: 'Courier New', monospace;
  line-height: 1.6;
}
.gf-stats {
  font-size: 18rpx;
  color: #8D6E63;
  font-family: 'Courier New', monospace;
}

/* ===== 浮动提示 ===== */
.game-toast {
  position: fixed;
  top: 200rpx;
  left: 50%;
  transform: translateX(-50%) translateY(-30rpx);
  background: linear-gradient(180deg, #FFFEF9, #FFF8E7);
  border: 5rpx solid #5D4037;
  box-shadow: 6rpx 6rpx 0 rgba(93,64,55,0.5);
  padding: 18rpx 36rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  z-index: 999;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s, transform 0.3s;
  max-width: 600rpx;
}
.game-toast.toast-show {
  opacity: 1;
  transform: translateX(-50%) translateY(0);
}
.toast-icon { font-size: 36rpx; }
.toast-text {
  font-size: 24rpx;
  color: #3E2723;
  font-family: 'Courier New', monospace;
  font-weight: bold;
}

/* ===== 底部 ===== */
.home-footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 24rpx 0 16rpx;
}
.footer-hint {
  font-size: 20rpx;
  color: #8D6E63;
  font-family: 'Courier New', monospace;
}
.footer-sub {
  font-size: 16rpx;
  color: #BCAAA4;
  font-family: 'Courier New', monospace;
}
