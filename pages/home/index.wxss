  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border-radius: 12rpx;
  backface-visibility: hidden;
  padding: 20rpx;
  box-sizing: border-box;
}
.lang-card-front {
  background: linear-gradient(135deg, #14b8a6, #0ea5e9);
}
.lang-card-back {
