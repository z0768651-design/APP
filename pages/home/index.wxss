/* ===== 书桌 - 俯视图 ===== */
.furn-desk-pos { left: 10rpx; bottom: 15rpx; }
.topdown-desk {
  width: 120rpx;
  height: 60rpx;
  position: relative;
  box-shadow: 2px 2px 0 rgba(0,0,0,0.1);
}
.desk-surface {
  position: absolute;
  inset: 0;
  background: #d97706;
  border: 2px solid #b45309;
  border-radius: 2rpx;
}
.desk-lamp {
  position: absolute;
  top: 6rpx;
  right: 10rpx;
  width: 14rpx;
  height: 14rpx;
  background: #fbbf24;
  border: 1px solid #d97706;
  border-radius: 50%;
  box-shadow: 0 0 6rpx rgba(251,191,36,0.5);
}
.desk-book {
  position: absolute;
  top: 8rpx;
  left: 12rpx;
  width: 24rpx;
  height: 16rpx;
  background: #ef4444;
  border: 1px solid #dc2626;
  border-radius: 1rpx;
}
.desk-chair {
  position: absolute;
  bottom: -16rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 30rpx;
  height: 24rpx;
  background: #374151;
  border: 2px solid #1f2937;
  border-radius: 4rpx;
}

/* ===== 淋浴 - 俯视图 ===== */
.furn-shower-pos { left: 10rpx; top: 10rpx; }
.topdown-shower {
