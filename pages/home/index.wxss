  position: relative;
}
.shower-base {
  width: 28rpx;
  height: 28rpx;
  background: #475569;
  border-radius: 2rpx;
  margin: 4rpx auto;
}
.shower-head {
  width: 12rpx;
  height: 3rpx;
  background: #94a3b8;
  position: absolute;
  top: 4rpx;
  left: 50%;
  transform: translateX(-50%);
}
.shower-water {
  width: 2rpx;
  height: 6rpx;
  background: #0ea5e9;
  position: absolute;
  top: 8rpx;
  opacity: 0;
}
.topdown-shower.shower-active .shower-water {
  opacity: 0.6;
  animation: waterDrop 0.4s ease-in-out infinite;
}
@keyframes waterDrop {
  0% { transform: translateY(0); opacity: 0.6; }
  100% { transform: translateY(12rpx); opacity: 0; }
}
.shower-water.w1 { left: 10rpx; animation-delay: 0s; }
.shower-water.w2 { left: 14rpx; animation-delay: 0.1s; }
.shower-water.w3 { left: 18rpx; animation-delay: 0.2s; }
.shower-drain {
  width: 3rpx;
  height: 3rpx;
  background: #1a202c;
  border-radius: 50%;
  position: absolute;
  bottom: 4rpx;
  left: 50%;
  transform: translateX(-50%);
}

/* 马桶 */
.furn-toilet-pos { left: 50%; top: 8rpx; transform: translateX(-50%); }
.topdown-toilet {
  width: 28rpx;
