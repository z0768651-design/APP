}

/* 菜谱步骤 */
.recipe-steps-view {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.recipe-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 8rpx;
  border-bottom: 1px solid rgba(20,184,166,0.3);
}
.recipe-title {
  font-size: 18rpx;
  font-weight: bold;
  color: #f1f5f9;
}
.recipe-diff {
  font-size: 13rpx;
  color: #fbbf24;
  padding: 2rpx 6rpx;
  background: rgba(251,191,36,0.1);
  border-radius: 3rpx;
}
.recipe-steps-list {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  max-height: 240rpx;
  overflow-y: auto;
}
.step-item {
  display: flex;
  gap: 8rpx;
}
.step-num {
  color: #14b8a6;
  font-weight: bold;
  min-width: 20rpx;
  text-align: center;
}
.step-text {
  flex: 1;
  color: #cbd5e1;
  font-size: 15rpx;
