}

/* 女朋友 */
.furn-gf-pos { right: 8rpx; bottom: 12rpx; }
.topdown-gf-sofa {
  width: 40rpx;
  height: 24rpx;
  background: #7c2d12;
  border: 1px solid #57251f;
  border-radius: 2rpx;
  position: relative;
}
.gf-sofa-back {
  width: 100%;
  height: 6rpx;
  background: #92400e;
}
.gf-sofa-seat {
