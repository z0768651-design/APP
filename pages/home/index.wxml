<!-- 像素之家 - 真实俯视图 -->
<scroll-view scroll-y class="home-wrap">

  <!-- ===== 顶部问候 ===== -->
  <view class="home-header">
    <view class="home-greeting-row">
      <text class="time-icon">{{timeIcon}}</text>
      <view class="home-greeting-text">
        <text class="greeting-main">{{greeting}}！</text>
        <text class="greeting-sub">欢迎回家</text>
      </view>
    </view>
    <view class="home-mini-stats">
      <view class="mini-stat">
        <text class="mini-stat-num">{{totalCount}}</text>
        <text class="mini-stat-lbl">食材</text>
      </view>
      <view class="mini-stat-divider"></view>
      <view class="mini-stat">
        <text class="mini-stat-num warn-num">{{expiringCount}}</text>
        <text class="mini-stat-lbl">快过期</text>
      </view>
      <view wx:if="{{expiredCount > 0}}" class="mini-stat-divider"></view>
      <view wx:if="{{expiredCount > 0}}" class="mini-stat">
        <text class="mini-stat-num danger-num">{{expiredCount}}</text>
        <text class="mini-stat-lbl">已过期</text>
      </view>
    </view>
  </view>

  <!-- ===== 房子俯视图 ===== -->
  <view class="house-container">

    <!-- 屋顶装饰 -->
    <view class="house-roof">
      <view class="roof-pixel roof-p1"></view>
      <view class="roof-pixel roof-p2"></view>
      <view class="roof-main">
        <text class="roof-title">✦ MY PIXEL HOME ✦</text>
      </view>
      <view class="roof-pixel roof-p3"></view>
      <view class="roof-pixel roof-p4"></view>
    </view>

    <!-- ===== 房间布局（使用绝对定位放置家具） ===== -->
    <view class="house-body">

      <!-- 小人 -->
      <view class="character" style="left:{{charX}}rpx; top:{{charY}}rpx; {{charWalking ? '' : ''}}">
        <view class="char-body {{charWalking ? 'char-walking' : ''}} char-dir-{{charDir}}">
          <view class="char-head"></view>
          <view class="char-torso"></view>
          <view class="char-leg char-leg-l"></view>
          <view class="char-leg char-leg-r"></view>
        </view>
        <view class="char-shadow"></view>
      </view>

      <!-- 北墙装饰 -->
      <view class="wall-north">
        <view class="window-frame">
          <view class="window-pane"></view>
          <view class="window-pane"></view>
        </view>
        <view class="wall-gap"></view>
        <view class="window-frame">
          <view class="window-pane"></view>
          <view class="window-pane"></view>
        </view>
      </view>

      <!-- 上半部分: 厨房 + 客厅 -->
      <view class="floor-row">

        <!-- 厨房 -->
        <view class="room kitchen-room">
          <view class="room-label kitchen-label">
            <text class="room-label-text">厨房</text>
          </view>
          <view class="room-floor kitchen-floor">

            <!-- 冰箱 - 俯视图：长方形，带把手 -->
            <view class="furn-pos furn-fridge-pos"
              data-id="fridge" data-x="30" data-y="100"
              bindtap="onFurnitureTap">
              <view class="topdown-fridge {{activeFurniture === 'fridge' ? 'furn-active' : ''}}">
                <view class="fridge-top"></view>
                <view class="fridge-bottom"></view>
                <view class="fridge-handle"></view>
                <view class="fridge-handle fridge-handle-b"></view>
                <view class="furniture-badge" wx:if="{{totalCount > 0}}">
                  <text class="badge-num">{{totalCount}}</text>
                </view>
              </view>
              <text class="furn-label">冰箱</text>
            </view>

            <!-- 灶台 - 俯视图：方形，4个圆形炉灶 -->
            <view class="furn-pos furn-stove-pos"
              data-id="stove" data-x="160" data-y="80"
              bindtap="onFurnitureTap">
              <view class="topdown-stove {{activeFurniture === 'stove' ? 'furn-active' : ''}}">
                <view class="stove-burner stove-b1"></view>
                <view class="stove-burner stove-b2"></view>
                <view class="stove-burner stove-b3"></view>
                <view class="stove-burner stove-b4"></view>
                <view class="stove-knobs">
                  <view class="stove-knob"></view>
                  <view class="stove-knob"></view>
                  <view class="stove-knob"></view>
                  <view class="stove-knob"></view>
                </view>
              </view>
              <text class="furn-label">灶台</text>
            </view>

            <!-- 水槽 - 俯视图：椭圆盆+水龙头 -->
            <view class="furn-pos furn-sink-pos"
              data-id="sink" data-x="160" data-y="180"
              bindtap="onFurnitureTap">
              <view class="topdown-sink {{activeFurniture === 'sink' ? 'furn-active' : ''}}">
                <view class="sink-basin"></view>
                <view class="sink-drain"></view>
                <view class="sink-faucet"></view>
              </view>
              <text class="furn-label">水槽</text>
            </view>

            <!-- 橱柜 - 俯视图：长条矩形，带门缝 -->
            <view class="furn-pos furn-cabinet-pos"
              data-id="cabinet" data-x="30" data-y="210"
              bindtap="onFurnitureTap">
              <view class="topdown-cabinet {{activeFurniture === 'cabinet' ? 'furn-active' : ''}}">
                <view class="cabinet-door"></view>
                <view class="cabinet-door"></view>
                <view class="cabinet-door"></view>
                <view class="cabinet-knob c-k1"></view>
                <view class="cabinet-knob c-k2"></view>
                <view class="cabinet-knob c-k3"></view>
              </view>
              <text class="furn-label">橱柜</text>
            </view>

          </view>
        </view>

        <!-- 竖向隔墙 -->
        <view class="wall-vert">
          <view class="door-opening-h">
            <view class="door-frame-h"></view>
          </view>
        </view>

        <!-- 客厅 -->
        <view class="room living-room">
          <view class="room-label living-label">
            <text class="room-label-text">客厅</text>
          </view>
          <view class="room-floor living-floor">

            <!-- 电视+电视柜 - 俯视图：窄长条靠墙 -->
            <view class="furn-pos furn-tv-pos"
              data-id="tv" data-x="380" data-y="75"
              bindtap="onFurnitureTap">
              <view class="topdown-tv {{activeFurniture === 'tv' ? 'furn-active' : ''}}">
                <view class="tv-screen"></view>
                <view class="tv-stand"></view>
              </view>
              <text class="furn-label">电视</text>
            </view>

            <!-- 沙发 - 俯视图：U型/L型 -->
            <view class="furn-pos furn-sofa-pos"
              data-id="sofa" data-x="370" data-y="170"
              bindtap="onFurnitureTap">
              <view class="topdown-sofa {{activeFurniture === 'sofa' ? 'furn-active' : ''}}">
                <view class="sofa-back"></view>
                <view class="sofa-seat"></view>
                <view class="sofa-arm sofa-arm-l"></view>
                <view class="sofa-arm sofa-arm-r"></view>
                <view class="sofa-cushion s-c1"></view>
                <view class="sofa-cushion s-c2"></view>
                <view class="sofa-cushion s-c3"></view>
              </view>
              <text class="furn-label">沙发</text>
            </view>

            <!-- 茶几 - 俯视图：小方形 -->
            <view class="furn-pos furn-table-pos"
              data-id="table" data-x="430" data-y="165"
              bindtap="onFurnitureTap">
              <view class="topdown-table {{activeFurniture === 'table' ? 'furn-active' : ''}}">
                <view class="table-top"></view>
                <view class="table-cup"></view>
              </view>
              <text class="furn-label">茶几</text>
            </view>

            <!-- 盆栽 - 俯视图：圆形叶片 -->
            <view class="furn-pos furn-plant-pos"
              data-id="plant" data-x="520" data-y="90"
              bindtap="onFurnitureTap">
              <view class="topdown-plant {{activeFurniture === 'plant' ? 'furn-active' : ''}}">
                <view class="plant-leaf plant-l1"></view>
                <view class="plant-leaf plant-l2"></view>
                <view class="plant-leaf plant-l3"></view>
                <view class="plant-leaf plant-l4"></view>
                <view class="plant-pot"></view>
              </view>
              <text class="furn-label">盆栽</text>
            </view>

          </view>
        </view>

      </view>

      <!-- 走廊 -->
      <view class="hallway">
        <view class="hallway-floor">
          <view class="floor-tile"></view>
          <view class="floor-tile"></view>
          <view class="floor-tile"></view>
          <view class="floor-tile"></view>
          <view class="floor-tile"></view>
          <view class="floor-tile"></view>
          <view class="floor-tile"></view>
          <view class="floor-tile"></view>
        </view>
      </view>

      <!-- 下半部分: 卧室 + 卫生间 -->
      <view class="floor-row">

        <!-- 卧室 -->
        <view class="room bedroom">
          <view class="room-label bedroom-label">
            <text class="room-label-text">卧室</text>
          </view>
          <view class="room-floor bedroom-floor">

            <!-- 床 - 俯视图：长方形+枕头+被子 -->
            <view class="furn-pos furn-bed-pos"
              data-id="bed" data-x="40" data-y="395"
              bindtap="onFurnitureTap">
              <view class="topdown-bed {{activeFurniture === 'bed' ? 'furn-active' : ''}}">
                <view class="bed-frame"></view>
                <view class="bed-pillow bed-p1"></view>
                <view class="bed-pillow bed-p2"></view>
                <view class="bed-blanket"></view>
              </view>
              <text class="furn-label">床</text>
            </view>

            <!-- 衣柜 - 俯视图：双开门矩形 -->
            <view class="furn-pos furn-wardrobe-pos"
              data-id="wardrobe" data-x="185" data-y="380"
              bindtap="onFurnitureTap">
              <view class="topdown-wardrobe {{activeFurniture === 'wardrobe' ? 'furn-active' : ''}}">
                <view class="wardrobe-door wd-l"></view>
                <view class="wardrobe-door wd-r"></view>
                <view class="wardrobe-knob wk-l"></view>
                <view class="wardrobe-knob wk-r"></view>
                <view class="wardrobe-mirror"></view>
              </view>
              <text class="furn-label">衣柜</text>
            </view>

            <!-- 书桌 - 俯视图：桌面+台灯+书本 -->
            <view class="furn-pos furn-desk-pos"
              data-id="desk" data-x="40" data-y="500"
              bindtap="onFurnitureTap">
              <view class="topdown-desk {{activeFurniture === 'desk' ? 'furn-active' : ''}}">
                <view class="desk-surface"></view>
                <view class="desk-lamp"></view>
                <view class="desk-book"></view>
                <view class="desk-chair"></view>
              </view>
              <text class="furn-label">书桌</text>
            </view>

          </view>
        </view>

        <!-- 竖向隔墙 -->
        <view class="wall-vert">
          <view class="door-opening-h">
            <view class="door-frame-h"></view>
          </view>
        </view>

        <!-- 卫生间 -->
        <view class="room bathroom">
          <view class="room-label bathroom-label">
            <text class="room-label-text">卫生间</text>
          </view>
          <view class="room-floor bathroom-floor">

            <!-- 淋浴 - 俯视图：方形+花洒圆 -->
            <view class="furn-pos furn-shower-pos"
              data-id="shower" data-x="370" data-y="395"
              bindtap="onFurnitureTap">
              <view class="topdown-shower {{activeFurniture === 'shower' ? 'furn-active' : ''}}">
                <view class="shower-base"></view>
                <view class="shower-head"></view>
                <view class="shower-water w1"></view>
                <view class="shower-water w2"></view>
                <view class="shower-water w3"></view>
                <view class="shower-drain"></view>
              </view>
              <text class="furn-label">淋浴</text>
            </view>

            <!-- 马桶 - 俯视图：椭圆坐圈+水箱 -->
            <view class="furn-pos furn-toilet-pos"
              data-id="toilet" data-x="490" data-y="390"
              bindtap="onFurnitureTap">
              <view class="topdown-toilet {{activeFurniture === 'toilet' ? 'furn-active' : ''}}">
                <view class="toilet-tank"></view>
                <view class="toilet-seat"></view>
                <view class="toilet-lid"></view>
                <view class="toilet-hole"></view>
              </view>
              <text class="furn-label">马桶</text>
            </view>

            <!-- 洗手台 - 俯视图：半圆盆+镜子 -->
            <view class="furn-pos furn-basin-pos"
              data-id="basin" data-x="420" data-y="500"
              bindtap="onFurnitureTap">
              <view class="topdown-basin {{activeFurniture === 'basin' ? 'furn-active' : ''}}">
                <view class="basin-counter"></view>
                <view class="basin-bowl"></view>
                <view class="basin-faucet"></view>
                <view class="basin-mirror"></view>
              </view>
              <text class="furn-label">洗手台</text>
            </view>

          </view>
        </view>

      </view>

      <!-- 南墙 + 大门 -->
      <view class="wall-south">
        <view class="wall-gap"></view>
        <view class="main-door-frame" data-id="door" data-x="280" data-y="590" bindtap="onFurnitureTap">
          <view class="door-topdown">
            <view class="door-panel"></view>
            <view class="door-knob"></view>
          </view>
          <text class="main-door-label">大门</text>
        </view>
        <view class="wall-gap"></view>
      </view>

    </view>
  </view>

  <!-- 互动弹窗 -->
  <view class="action-modal {{showModal ? 'modal-show' : ''}}" bindtap="onCloseModal">
    <view class="modal-content" catchtap="">
      <text class="modal-title">{{modalTitle}}</text>
      <text class="modal-desc">{{modalDesc}}</text>
      <view class="modal-actions">
        <view class="modal-btn modal-btn-primary" wx:if="{{modalAction}}" bindtap="onModalAction">
          <text class="modal-btn-text">{{modalBtnText}}</text>
        </view>
        <view class="modal-btn" bindtap="onCloseModal">
          <text class="modal-btn-text">关闭</text>
        </view>
      </view>
    </view>
  </view>

  <!-- ===== 底部提示 ===== -->
  <view class="home-footer">
    <text class="footer-hint">✦ 点击家具，小人会走过去 ✦</text>
    <text class="footer-sub">试试和每个家具互动吧</text>
  </view>

  <view style="height: 60rpx;"></view>
</scroll-view>
