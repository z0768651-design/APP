/* ===== 添加食材页 - 温暖像素游戏风 (Stardew Valley / Kairosoft) ===== */

/* --- Page --- */
.add-page {
  min-height: 100vh;
  background: #FFF8E7;
  padding: 24rpx;
  box-sizing: border-box;
}

/* --- Section Header (wood-plank title bar) --- */
.section-header {
  margin-bottom: 24rpx;
  background: linear-gradient(180deg, #6D4C41 0%, #5D4037 50%, #4E342E 100%);
  border: 4rpx solid #3E2723;
  box-shadow: 6rpx 6rpx 0 #8D6E63;
  padding: 20rpx 24rpx;
  position: relative;
}
.section-header::before,
.section-header::after {
  content: '';
  position: absolute;
  width: 14rpx;
  height: 14rpx;
  background: #FFB300;
}
.section-header::before { top: 6rpx; left: 6rpx; }
.section-header::after  { top: 6rpx; right: 6rpx; }
.section-title {
  display: block;
  font-size: 36rpx;
  color: #FFD54F;
  font-family: 'Courier New', monospace;
  font-weight: bold;
  text-shadow: 2rpx 2rpx 0 #3E2723;
  letter-spacing: 2rpx;
}
.section-hint {
  display: block;
  font-size: 20rpx;
  color: #FFCC80;
  font-family: 'Courier New', monospace;
  margin-top: 6rpx;
  letter-spacing: 1rpx;
}

/* --- Search Bar --- */
.search-wrap {
  display: flex;
  align-items: center;
  background: #FFFDF5;
  border: 4rpx solid #5D4037;
  box-shadow: 6rpx 6rpx 0 #8D6E63;
  padding: 18rpx 20rpx;
  margin-bottom: 24rpx;
  gap: 12rpx;
}
.search-icon {
  font-size: 30rpx;
  color: #8D6E63;
}
.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #3E2723;
  font-family: 'Courier New', monospace;
  background: transparent;
}
.search-placeholder {
  color: #BCAAA4;
  font-family: 'Courier New', monospace;
  font-size: 26rpx;
}

/* --- Ingredient Grid --- */
.ingredient-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}
.ingredient-tile {
  background: linear-gradient(180deg, #FFFDF5 0%, #FFF8E7 100%);
  border: 4rpx solid #8D6E63;
  box-shadow: 4rpx 4rpx 0 #D7CCC8;
  padding: 22rpx 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  transition: none;
  position: relative;
}
.ingredient-tile:active {
  box-shadow: 2rpx 2rpx 0 #5D4037;
  transform: translate(2rpx, 2rpx);
  border-color: #FFB300;
  background: linear-gradient(180deg, #FFF8E1 0%, #FFD54F 100%);
}
.tile-icon {
  font-size: 54rpx;
  margin-bottom: 2rpx;
}
.tile-name {
  font-size: 22rpx;
  color: #3E2723;
  font-family: 'Courier New', monospace;
  font-weight: bold;
  text-align: center;
  line-height: 1.3;
}
.tile-cat {
  font-size: 18rpx;
  color: #8D6E63;
  font-family: 'Courier New', monospace;
}

/* --- Back Row --- */
.back-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 20rpx;
  padding: 10rpx 0;
}
.back-arrow {
  font-size: 24rpx;
  color: #FFB300;
  font-weight: bold;
  text-shadow: 1rpx 1rpx 0 #5D4037;
}
.back-text {
  font-size: 24rpx;
  color: #FFB300;
  font-family: 'Courier New', monospace;
  font-weight: bold;
  text-shadow: 1rpx 1rpx 0 #5D4037;
}

/* --- Selected Ingredient Card --- */
.selected-card {
  background: linear-gradient(180deg, #FFF8E1 0%, #FFFDF5 100%);
  border: 4rpx solid #FFB300;
  box-shadow: 6rpx 6rpx 0 #8D6E63;
  padding: 24rpx 20rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
  position: relative;
}
.selected-emoji {
  font-size: 70rpx;
  filter: drop-shadow(2rpx 2rpx 0 #D7CCC8);
}
.selected-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.selected-name {
  display: block;
  font-size: 34rpx;
  color: #3E2723;
  font-family: 'Courier New', monospace;
  font-weight: bold;
  text-shadow: 1rpx 1rpx 0 #D7CCC8;
}
.selected-cat {
  display: block;
  font-size: 22rpx;
  color: #8D6E63;
  font-family: 'Courier New', monospace;
}
.selected-badge {
  background: linear-gradient(180deg, #FFD54F 0%, #FFB300 100%);
  color: #3E2723;
  font-size: 18rpx;
  font-family: 'Courier New', monospace;
  font-weight: bold;
  padding: 6rpx 16rpx;
  border: 3rpx solid #5D4037;
  box-shadow: 2rpx 2rpx 0 #8D6E63;
}

/* --- Form Card (game dialog box) --- */
.form-card {
  background: #FFFDF5;
  border: 4rpx solid #5D4037;
  box-shadow: 6rpx 6rpx 0 #8D6E63;
  padding: 0;
  margin-bottom: 24rpx;
  position: relative;
  overflow: hidden;
}
.form-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  background: linear-gradient(90deg, #FFB300, #FFD54F, #FFB300);
}
.form-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 24rpx;
  border-bottom: 2rpx dashed #E8D5B7;
}
.form-row:last-child {
  border-bottom: none;
}
.form-row-switch {
  align-items: flex-start;
  padding-top: 24rpx;
}
.form-row-col {
  flex-direction: column;
  align-items: flex-start;
  gap: 14rpx;
}
.form-label {
  font-size: 26rpx;
  color: #5D4037;
  font-family: 'Courier New', monospace;
  font-weight: bold;
}
.form-label-group {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.form-sublabel {
  font-size: 18rpx;
  color: #8D6E63;
  font-family: 'Courier New', monospace;
}

/* --- Quantity Controls --- */
.qty-controls {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.qty-btn {
  width: 56rpx;
  height: 56rpx;
  background: linear-gradient(180deg, #FFD54F 0%, #FFB300 100%);
  border: 3rpx solid #5D4037;
  box-shadow: 3rpx 3rpx 0 #8D6E63;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #3E2723;
  font-family: 'Courier New', monospace;
  font-weight: bold;
  line-height: 1;
}
.qty-btn:active {
  box-shadow: 1rpx 1rpx 0 #5D4037;
  transform: translate(2rpx, 2rpx);
  background: linear-gradient(180deg, #FFB300 0%, #FFA000 100%);
}
.qty-input {
  width: 84rpx;
  text-align: center;
  font-size: 32rpx;
  color: #3E2723;
  font-family: 'Courier New', monospace;
  font-weight: bold;
  background: #FFF8E7;
  border: 3rpx solid #8D6E63;
  padding: 10rpx 4rpx;
  box-shadow: inset 2rpx 2rpx 0 #E8D5B7;
}

/* --- Picker --- */
.picker-display {
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: #FFF8E1;
  border: 3rpx solid #8D6E63;
  padding: 12rpx 18rpx;
  box-shadow: 3rpx 3rpx 0 #D7CCC8;
}
.picker-display:active {
  box-shadow: 1rpx 1rpx 0 #8D6E63;
  transform: translate(2rpx, 2rpx);
}
.picker-value {
  font-size: 26rpx;
  color: #5D4037;
  font-family: 'Courier New', monospace;
  font-weight: bold;
}
.picker-arrow {
  font-size: 18rpx;
  color: #8D6E63;
  font-family: 'Courier New', monospace;
}

/* --- Note Input --- */
.note-input {
  width: 100%;
  min-height: 120rpx;
  background: #FFF8E7;
  border: 3rpx solid #8D6E63;
  padding: 14rpx;
  font-size: 24rpx;
  color: #5D4037;
  font-family: 'Courier New', monospace;
  box-sizing: border-box;
  box-shadow: inset 2rpx 2rpx 0 #E8D5B7;
}
.note-placeholder {
  color: #BCAAA4;
  font-family: 'Courier New', monospace;
  font-size: 24rpx;
}

/* --- Submit Button --- */
.submit-wrap {
  padding: 8rpx 0 24rpx;
}
.submit-btn {
  background: linear-gradient(180deg, #81C784 0%, #66BB6A 40%, #4CAF50 100%);
  border: 4rpx solid #5D4037;
  box-shadow: 6rpx 6rpx 0 #8D6E63;
  padding: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  position: relative;
}
.submit-btn::after {
  content: '';
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  right: 4rpx;
  height: 12rpx;
  background: rgba(255, 255, 255, 0.15);
}
.submit-btn:active {
  box-shadow: 2rpx 2rpx 0 #5D4037;
  transform: translate(4rpx, 4rpx);
}
.submit-icon {
  font-size: 40rpx;
  color: #FFFDF5;
  font-weight: bold;
  font-family: 'Courier New', monospace;
  text-shadow: 2rpx 2rpx 0 #2E7D32;
}
.submit-text {
  font-size: 30rpx;
  color: #FFFDF5;
  font-family: 'Courier New', monospace;
  font-weight: bold;
  letter-spacing: 4rpx;
  text-shadow: 2rpx 2rpx 0 #2E7D32;
}
