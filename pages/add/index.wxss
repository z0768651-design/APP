/* ===== 添加食材页 ===== */
.add-page {
  min-height: 100vh;
  background: #0a0a1a;
  padding: 24rpx;
  box-sizing: border-box;
}

.section-header {
  margin-bottom: 24rpx;
}
.section-title {
  display: block;
  font-size: 30rpx;
  color: #4fc3f7;
  font-family: 'Courier New', monospace;
  font-weight: bold;
  letter-spacing: 2rpx;
}
.section-hint {
  display: block;
  font-size: 20rpx;
  color: #555;
  font-family: 'Courier New', monospace;
  margin-top: 6rpx;
}

/* 搜索框 */
.search-wrap {
  display: flex;
  align-items: center;
  background: #111130;
  border: 2px solid #4fc3f7;
  box-shadow: 4px 4px 0 #000;
  padding: 16rpx 20rpx;
  margin-bottom: 24rpx;
  gap: 12rpx;
}
.search-icon { font-size: 28rpx; }
.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #e0e0e0;
  font-family: 'Courier New', monospace;
}
.search-placeholder { color: #444; font-family: 'Courier New', monospace; }

/* 食材网格 */
.ingredient-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}
.ingredient-tile {
  background: #111130;
  border: 2px solid #2a2a50;
  box-shadow: 3px 3px 0 #000;
  padding: 20rpx 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}
.ingredient-tile:active {
  box-shadow: 1px 1px 0 #000;
  transform: translate(2px, 2px);
  border-color: #4fc3f7;
}
.tile-icon { font-size: 52rpx; }
.tile-name {
  font-size: 22rpx;
  color: #e0e0e0;
  font-family: 'Courier New', monospace;
  font-weight: bold;
  text-align: center;
}
.tile-cat {
  font-size: 18rpx;
  color: #555;
  font-family: 'Courier New', monospace;
}

/* 返回按钮 */
.back-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 20rpx;
  padding: 10rpx 0;
}
.back-arrow { font-size: 24rpx; color: #4fc3f7; }
.back-text {
  font-size: 24rpx;
  color: #4fc3f7;
  font-family: 'Courier New', monospace;
}

/* 选中卡片 */
.selected-card {
  background: #0d2040;
  border: 2px solid #4fc3f7;
  box-shadow: 4px 4px 0 #000;
  padding: 24rpx 20rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}
.selected-emoji { font-size: 70rpx; }
.selected-info { flex: 1; }
.selected-name {
  display: block;
  font-size: 32rpx;
  color: #e0e0e0;
  font-family: 'Courier New', monospace;
  font-weight: bold;
}
.selected-cat {
  display: block;
  font-size: 22rpx;
  color: #4fc3f7;
  font-family: 'Courier New', monospace;
  margin-top: 6rpx;
}
.selected-badge {
  background: #4fc3f7;
  color: #0a0a1a;
  font-size: 18rpx;
  font-family: 'Courier New', monospace;
  font-weight: bold;
  padding: 6rpx 12rpx;
  border: 2px solid #000;
  box-shadow: 2px 2px 0 #000;
}

/* 表单卡片 */
.form-card {
  background: #111130;
  border: 2px solid #333;
  box-shadow: 4px 4px 0 #000;
  padding: 10rpx 0;
  margin-bottom: 24rpx;
}
.form-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  border-bottom: 1px solid #1e1e40;
}
.form-row:last-child { border-bottom: none; }
.form-row-switch { align-items: flex-start; }
.form-row-col {
  flex-direction: column;
  align-items: flex-start;
  gap: 12rpx;
}
.form-label {
  font-size: 26rpx;
  color: #bbb;
  font-family: 'Courier New', monospace;
}
.form-label-group { display: flex; flex-direction: column; gap: 4rpx; }
.form-sublabel { font-size: 18rpx; color: #555; font-family: 'Courier New', monospace; }

/* 数量控制 */
.qty-controls {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.qty-btn {
  width: 52rpx;
  height: 52rpx;
  background: #1a3a5c;
  border: 2px solid #4fc3f7;
  box-shadow: 2px 2px 0 #000;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #4fc3f7;
  font-family: 'Courier New', monospace;
}
.qty-btn:active {
  box-shadow: 0 0 0 #000;
  transform: translate(2px, 2px);
}
.qty-input {
  width: 80rpx;
  text-align: center;
  font-size: 30rpx;
  color: #e0e0e0;
  font-family: 'Courier New', monospace;
  font-weight: bold;
  background: #0a0a1a;
  border: 2px solid #333;
  padding: 8rpx;
}

/* 选择器 */
.picker-display {
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: #1a1a3a;
  border: 2px solid #333;
  padding: 10rpx 16rpx;
  box-shadow: 2px 2px 0 #000;
}
.picker-value {
  font-size: 26rpx;
  color: #4fc3f7;
  font-family: 'Courier New', monospace;
}
.picker-arrow {
  font-size: 18rpx;
  color: #555;
}

/* 备注 */
.note-input {
  width: 100%;
  height: 120rpx;
  background: #0a0a1a;
  border: 2px solid #333;
  padding: 12rpx;
  font-size: 24rpx;
  color: #ccc;
  font-family: 'Courier New', monospace;
  box-sizing: border-box;
}
.note-placeholder { color: #333; font-family: 'Courier New', monospace; }

/* 提交按钮 */
.submit-wrap { padding: 0 0 20rpx; }
.submit-btn {
  background: #4fc3f7;
  border: 2px solid #000;
  box-shadow: 5px 5px 0 #000;
  padding: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}
.submit-btn:active {
  box-shadow: 2px 2px 0 #000;
  transform: translate(3px, 3px);
}
.submit-icon {
  font-size: 40rpx;
  color: #0a0a1a;
  font-weight: bold;
  font-family: 'Courier New', monospace;
}
.submit-text {
  font-size: 30rpx;
  color: #0a0a1a;
  font-family: 'Courier New', monospace;
  font-weight: bold;
  letter-spacing: 4rpx;
}
