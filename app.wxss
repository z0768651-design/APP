page {
  background-color: #0a0a1a;
  color: #e0e0e0;
  font-family: 'Courier New', Courier, monospace;
}

/* ===== 像素风全局设计系统 ===== */
.pixel-card {
  background: #1a1a3a;
  border: 2px solid #4fc3f7;
  box-shadow: 4px 4px 0 #000;
}

.pixel-btn {
  background: #4fc3f7;
  border: 2px solid #000;
  box-shadow: 3px 3px 0 #000;
  color: #0a0a1a;
  font-family: 'Courier New', Courier, monospace;
  font-weight: bold;
  padding: 14rpx 28rpx;
  display: inline-block;
}

.pixel-btn:active {
  box-shadow: 1px 1px 0 #000;
  transform: translate(2px, 2px);
}

.pixel-btn-danger {
  background: #ff5252;
  border: 2px solid #000;
  box-shadow: 3px 3px 0 #000;
  color: #fff;
  font-family: 'Courier New', Courier, monospace;
  font-weight: bold;
}

.pixel-btn-ghost {
  background: transparent;
  border: 2px solid #4fc3f7;
  box-shadow: 3px 3px 0 #000;
  color: #4fc3f7;
  font-family: 'Courier New', Courier, monospace;
}

/* 保鲜状态颜色 */
.status-fresh { color: #69f0ae; }
.status-soon  { color: #ffd54f; }
.status-expired { color: #ff5252; }
.status-unknown { color: #888888; }

.dot-fresh   { background: #69f0ae; }
.dot-soon    { background: #ffd54f; }
.dot-expired { background: #ff5252; }
.dot-unknown { background: #555555; }

/* 像素点缀用分割线 */
.pixel-divider {
  height: 2px;
  background: repeating-linear-gradient(90deg, #4fc3f7 0px, #4fc3f7 8px, transparent 8px, transparent 16px);
  margin: 16rpx 0;
}
