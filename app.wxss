/* ============================================================
   像素之家 - 全局设计系统
   参考：星露谷物语 / 住宅梦物语 / 像素小店
   温暖大地色系 + 木质边框 + RPG风格UI
   ============================================================ */

page {
  background-color: #FFF8E7;
  color: #3E2723;
  font-family: -apple-system, 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

/* ===== 颜色变量说明 =====
   背景色: #FFF8E7 (奶油色)  #FFF3D0 (浅金)  #FFECD2 (桃色)
   木质棕: #5D4037 (深棕)  #795548 (中棕)  #8D6E63 (浅棕)
   金色:   #FFB300 (金币金) #FFC107 (明金)  #FFD54F (浅金)
   绿色:   #4CAF50 (生命绿) #66BB6A (浅绿)  #81C784 (嫩绿)
   蓝色:   #42A5F5 (天空蓝) #64B5F6 (浅蓝)  #90CAF9 (冰蓝)
   红色:   #EF5350 (危险红) #FF8A80 (浅红)  #FFCDD2 (粉红)
   紫色:   #AB47BC (魔法紫) #CE93D8 (浅紫)
   阴影:   #5D4037 (木质阴影)
   ========================================================== */

/* ===== 像素卡片 - 木质边框风格 ===== */
.pixel-card {
  background: #FFFEF9;
  border: 4rpx solid #5D4037;
  box-shadow: 6rpx 6rpx 0 #8D6E63, 8rpx 8rpx 0 rgba(93,64,55,0.3);
  position: relative;
}

/* 双线边框内描边效果 */
.pixel-card::after {
  content: '';
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  right: 4rpx;
  bottom: 4rpx;
  border: 2rpx solid rgba(93,64,55,0.2);
  pointer-events: none;
}

/* ===== 像素按钮系统 ===== */
/* 主按钮 - 温暖金色 */
.pixel-btn {
  background: linear-gradient(180deg, #FFD54F 0%, #FFB300 100%);
  border: 4rpx solid #5D4037;
  box-shadow: 6rpx 6rpx 0 #5D4037, inset 0 2rpx 0 rgba(255,255,255,0.4);
  color: #3E2723;
  font-weight: bold;
  padding: 18rpx 36rpx;
  text-align: center;
  position: relative;
  transition: transform 0.08s, box-shadow 0.08s;
}
.pixel-btn:active {
  transform: translate(4rpx, 4rpx);
  box-shadow: 2rpx 2rpx 0 #5D4037, inset 0 2rpx 0 rgba(255,255,255,0.2);
}

/* 绿色按钮 */
.pixel-btn-green {
  background: linear-gradient(180deg, #81C784 0%, #4CAF50 100%);
  border: 4rpx solid #2E7D32;
  box-shadow: 6rpx 6rpx 0 #1B5E20, inset 0 2rpx 0 rgba(255,255,255,0.3);
  color: #FFFFFF;
  font-weight: bold;
  padding: 18rpx 36rpx;
  text-align: center;
}
.pixel-btn-green:active {
  transform: translate(4rpx, 4rpx);
  box-shadow: 2rpx 2rpx 0 #1B5E20;
}

/* 危险按钮 */
.pixel-btn-danger {
  background: linear-gradient(180deg, #FF8A80 0%, #EF5350 100%);
  border: 4rpx solid #B71C1C;
  box-shadow: 6rpx 6rpx 0 #B71C1C, inset 0 2rpx 0 rgba(255,255,255,0.3);
  color: #FFFFFF;
  font-weight: bold;
}
.pixel-btn-danger:active {
  transform: translate(4rpx, 4rpx);
  box-shadow: 2rpx 2rpx 0 #B71C1C;
}

/* 幽灵按钮 */
.pixel-btn-ghost {
  background: #FFFEF9;
  border: 4rpx solid #8D6E63;
  box-shadow: 4rpx 4rpx 0 #8D6E63;
  color: #5D4037;
  font-weight: bold;
}

/* ===== RPG状态条 ===== */
.rpg-bar-track {
  height: 24rpx;
  background: #3E2723;
  border: 3rpx solid #5D4037;
  position: relative;
  overflow: hidden;
  box-shadow: inset 0 2rpx 4rpx rgba(0,0,0,0.4);
}
.rpg-bar-fill {
  height: 100%;
  position: relative;
  transition: width 0.5s ease;
}
/* 条纹高光效果 */
.rpg-bar-fill::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 40%;
  background: linear-gradient(180deg, rgba(255,255,255,0.35) 0%, transparent 100%);
}
.bar-energy { background: linear-gradient(90deg, #FFB300 0%, #FFC107 100%); }
.bar-mood { background: linear-gradient(90deg, #EF5350 0%, #FF8A80 100%); }
.bar-hp { background: linear-gradient(90deg, #4CAF50 0%, #66BB6A 100%); }
.bar-mp { background: linear-gradient(90deg, #42A5F5 0%, #64B5F6 100%); }
.bar-exp { background: linear-gradient(90deg, #AB47BC 0%, #CE93D8 100%); }

/* ===== 保鲜状态颜色 ===== */
.status-fresh   { color: #2E7D32; }
.status-soon    { color: #E65100; }
.status-expired { color: #C62828; }
.status-unknown { color: #9E9E9E; }

.dot-fresh   { background: #4CAF50; border: 3rpx solid #1B5E20; }
.dot-soon    { background: #FF9800; border: 3rpx solid #E65100; }
.dot-expired { background: #EF5350; border: 3rpx solid #B71C1C; }
.dot-unknown { background: #BDBDBD; border: 3rpx solid #757575; }

/* ===== 游戏风格对话框 ===== */
.game-dialog {
  background: linear-gradient(180deg, #FFFEF9 0%, #FFF8E7 100%);
  border: 6rpx solid #5D4037;
  box-shadow: 8rpx 8rpx 0 rgba(93,64,55,0.5);
  position: relative;
  padding: 32rpx;
}
/* 四角像素装饰 */
.game-dialog::before {
  content: '';
  position: absolute;
  top: -6rpx; left: -6rpx;
  width: 20rpx; height: 20rpx;
  background: #FFB300;
  border: 3rpx solid #5D4037;
}
.game-dialog::after {
  content: '';
  position: absolute;
  top: -6rpx; right: -6rpx;
  width: 20rpx; height: 20rpx;
  background: #FFB300;
  border: 3rpx solid #5D4037;
}

/* ===== 像素虚线分割 ===== */
.pixel-divider {
  height: 4rpx;
  background: repeating-linear-gradient(
    90deg,
    #8D6E63 0, #8D6E63 12rpx,
    transparent 12rpx, transparent 24rpx
  );
  margin: 20rpx 0;
}

/* ===== 金币显示 ===== */
.coin-display {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  background: linear-gradient(180deg, #FFF8E1 0%, #FFE082 100%);
  border: 3rpx solid #F57F17;
  padding: 4rpx 16rpx;
  font-weight: bold;
  color: #E65100;
  box-shadow: 3rpx 3rpx 0 #F57F17;
}

/* ===== 经验条 ===== */
.exp-bar-mini {
  height: 8rpx;
  background: #3E2723;
  border: 2rpx solid #5D4037;
  overflow: hidden;
}
.exp-bar-mini .fill {
  height: 100%;
  background: linear-gradient(90deg, #AB47BC, #CE93D8);
}

/* ===== 通知 Toast ===== */
.game-toast {
  position: fixed;
  top: 200rpx;
  left: 50%;
  transform: translateX(-50%) translateY(-30rpx);
  background: linear-gradient(180deg, #FFFEF9 0%, #FFF8E7 100%);
  border: 5rpx solid #5D4037;
  box-shadow: 6rpx 6rpx 0 rgba(93,64,55,0.5);
  padding: 20rpx 40rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  z-index: 999;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s, transform 0.3s;
  max-width: 600rpx;
}
.game-toast.toast-show {
  opacity: 1;
  transform: translateX(-50%) translateY(0);
}
.toast-icon { font-size: 40rpx; }
.toast-text {
  font-size: 26rpx;
  color: #3E2723;
  font-weight: bold;
}

/* ===== 木质标题装饰 ===== */
.wood-title {
  background: linear-gradient(180deg, #8D6E63 0%, #5D4037 100%);
  border: 3rpx solid #3E2723;
  padding: 12rpx 28rpx;
  color: #FFF8E7;
  font-weight: bold;
  font-size: 28rpx;
  text-align: center;
  box-shadow: 4rpx 4rpx 0 rgba(62,39,35,0.4), inset 0 2rpx 0 rgba(255,255,255,0.15);
  letter-spacing: 2rpx;
}

/* ===== 标签徽章 ===== */
.pixel-badge {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  padding: 4rpx 14rpx;
  border: 3rpx solid #5D4037;
  font-size: 20rpx;
  font-weight: bold;
  box-shadow: 2rpx 2rpx 0 rgba(93,64,55,0.3);
}
.badge-gold { background: #FFE082; color: #E65100; }
.badge-green { background: #C8E6C9; color: #2E7D32; }
.badge-blue { background: #BBDEFB; color: #1565C0; }
.badge-red { background: #FFCDD2; color: #C62828; }
.badge-purple { background: #E1BEE7; color: #7B1FA2; }
